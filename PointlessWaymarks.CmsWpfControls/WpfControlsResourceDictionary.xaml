    <DataTemplate x:Key="LinkListItemTemplate" DataType="linkList:LinkListListItem">
        <Border Style="{StaticResource ContentListOuterBorderStyle}">
            <Border.InputBindings>
                <MouseBinding
                    Command="{Binding ItemActions.EditCommand}"
                    CommandParameter="{Binding DbEntry}"
                    Gesture="Shift+LeftDoubleClick" />
            </Border.InputBindings>
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Left" Orientation="Vertical">
                    <ContentPresenter Content="{StaticResource ContentListContentTitleAndAttributionDisplay}" />
                    <TextBox
                        Visibility="{Binding LinkContentString, Converter={StaticResource NullOrWhiteSpaceStringToCollapsed}}"
                        Style="{StaticResource ReadOnlyTextBoxStyle}"
                        Text="{Binding LinkContentString, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <b:Interaction.Behaviors>
                            <wpfBehavior:ReadOnlyTextBoxClickKeyboardAndDragPass />
                        </b:Interaction.Behaviors>
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <wpfBehavior:EventToCommand
                                    Command="{Binding SelectedTextTracker.SelectedTextChangedCommand}"
                                    PassEventArgsToCommand="True" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TextBox>
                    <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                            <Hyperlink Command="{Binding ItemActions.ViewOnSiteCommand}"
                                       CommandParameter="{Binding DbEntry}">
                                <Hyperlink.Inlines>
                                    <Run Text="{Binding DbEntry.Url}" />
                                </Hyperlink.Inlines>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,6,0">Copy Link:</TextBlock>
                        <Button
                            Width="80"
                            Height="20"
                            VerticalAlignment="Center"
                            Command="{Binding ItemActions.CopyUrlCommand}"
                            CommandParameter="{Binding DbEntry.Url}">
                            Text
                        </Button>
                        <Button
                            Width="80"
                            Height="20"
                            VerticalAlignment="Center"
                            Command="{Binding ItemActions.CopyLinkAsMarkdownCommand}"
                            CommandParameter="{Binding DbEntry}">
                            Markdown
                        </Button>
                        <Button
                            Width="80"
                            Height="20"
                            VerticalAlignment="Center"
                            Command="{Binding ItemActions.CopyLinkAsHtmlCommand}"
                            CommandParameter="{Binding DbEntry}">
                            HTML
                        </Button>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0">Add Image Snapshot:</TextBlock>
                        <Button
                            Width="160"
                            Height="20"
                            VerticalAlignment="Center"
                            Command="{Binding ItemActions.LinkSnapshotImageCommand}"
                            CommandParameter="{Binding DbEntry}">
                            Automatic
                        </Button>
                        <Button
                            Width="160"
                            Height="20"
                            VerticalAlignment="Center"
                            Command="{Binding ItemActions.LinkSnapshotImageFromSelectedFileCommand}"
                            CommandParameter="{Binding DbEntry}">
                            From File
                        </Button>
                        <Button
                            Width="160"
                            Height="20"
                            VerticalAlignment="Center"
                            Command="{Binding ItemActions.LinkSnapshotImageFromClipboardCommand}"
                            CommandParameter="{Binding DbEntry}">
                            From Clipboard
                        </Button>
                        <Button
                            Width="160"
                            Height="20"
                            VerticalAlignment="Center"
                            Command="{Binding ItemActions.LinkSnapshotImageInteractiveCommand}"
                            CommandParameter="{Binding DbEntry}">
                            Interactive
                        </Button>
                    </WrapPanel>
                    <ListBox ItemsSource="{Binding SnapshotImages}" BorderThickness="0">
                        <b:Interaction.Behaviors>
                            <wpfBehavior:IgnoreMouseWheelBehavior />
                        </b:Interaction.Behaviors>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling" />

                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type linkList:LinkSnapshotImageItem}">
                                <Border Style="{StaticResource ContentListOuterBorderStyle}">
                                    <Grid Margin="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                            <RowDefinition></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid Height="180" ClipToBounds="True" HorizontalAlignment="Center">
                                            <Image
                                                Width="240"
                                                Height="1200"
                                                Source="{Binding FileName, Mode=OneWay, Converter={StaticResource ImageCache}}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top">
                                                <Image.ToolTip>
                                                    <Image
                                                        Source="{Binding FileName, Mode=OneWay, Converter={StaticResource ImageCache}}" />
                                                </Image.ToolTip>
                                                <Image.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding DataContext.ItemActions.ViewLinkSnapshotImageCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StackPanel}, AncestorLevel=2}}"
                                                        CommandParameter="{Binding FileName}"
                                                        MouseAction="LeftDoubleClick" />
                                                </Image.InputBindings>
                                            </Image>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Width="70" Height="20"
                                                    Command="{Binding DataContext.ItemActions.DeleteLinkSnapshotImageCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StackPanel}, AncestorLevel=2}}">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiValueObject}">
                                                        <Binding />
                                                        <Binding Path="DataContext"
                                                                 RelativeSource="{RelativeSource AncestorType={x:Type ListBox}}" />
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                Delete
                                            </Button>
                                            <Button Width="70" Height="20"
                                                    Command="{Binding DataContext.ItemActions.ViewLinkSnapshotImageCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StackPanel}, AncestorLevel=2}}"
                                                    CommandParameter="{Binding FileName}">
                                                Open
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" HorizontalAlignment="Center"
                                                   Text="{Binding Description}" ToolTip="{Binding FileName}">
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <ContentPresenter
                    Grid.Row="1"
                    Margin="2"
                    VerticalAlignment="Bottom"
                    Content="{StaticResource ContentListContentIdAndDateDisplay}" />
            </Grid>
        </Border>
    </DataTemplate>
