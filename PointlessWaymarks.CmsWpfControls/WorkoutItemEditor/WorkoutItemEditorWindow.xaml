<Window
    x:Class="PointlessWaymarks.CmsWpfControls.WorkoutItemEditor.WorkoutItemEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PointlessWaymarks.CmsWpfControls.WorkoutItemEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:status="clr-namespace:PointlessWaymarks.WpfCommon.Status;assembly=PointlessWaymarks.WpfCommon"
    Title="{Binding WindowTitle}"
    Width="800"
    Height="600"
    d:DataContext="{d:DesignInstance local:WorkoutItemEditorWindow}"
    mc:Ignorable="d">
    <Grid>
        <local:WorkoutItemEditorControl DataContext="{Binding WorkoutItemEditor}" />
        <status:StatusControl
            Grid.Column="0"
            d:IsHidden="true"
            DataContext="{Binding StatusContext}" />
    </Grid>
</Window>
