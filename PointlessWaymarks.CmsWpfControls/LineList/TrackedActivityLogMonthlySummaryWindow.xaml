<Window
    x:Class="PointlessWaymarks.CmsWpfControls.LineList.TrackedActivityLogMonthlySummaryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:PointlessWaymarks.WpfCommon.Behaviors;assembly=PointlessWaymarks.WpfCommon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:filterDataGrid="http://filterdatagrid.control.com/2021"
    xmlns:local="clr-namespace:PointlessWaymarks.CmsWpfControls.LineList"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:status="clr-namespace:PointlessWaymarks.WpfCommon.Status;assembly=PointlessWaymarks.WpfCommon"
    xmlns:utility="clr-namespace:PointlessWaymarks.WpfCommon.Utility;assembly=PointlessWaymarks.WpfCommon"
    xmlns:windowScreenShot="clr-namespace:PointlessWaymarks.WpfCommon.WindowScreenShot;assembly=PointlessWaymarks.WpfCommon"
    Title="Tracked Activity Log Summary"
    Width="800"
    Height="800"
    d:DataContext="{d:DesignInstance local:TrackedActivityLogMonthlySummaryWindow}"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../WpfControlsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <utility:BindingProxy x:Key="proxy" Data="{Binding}" />
            <behaviors:SimpleNumberFirstToStringCompare x:Key="NumberFriendlyComp" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <filterDataGrid:FilterDataGrid
            x:Name="LineStatsDataGrid"
            Grid.Row="0"
            Margin="4"
            behaviors:DataGridCustomSortBehavior.AllowCustomSort="True"
            AlternatingRowBackground="Gainsboro"
            AlternationCount="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserResizeColumns="True"
            IsReadOnly="True"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem}"
            SelectionChanged="Selector_OnSelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Style.Setters>
                        <Setter Property="TextBlock.TextAlignment" Value="Right" />
                    </Style.Setters>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <filterDataGrid:DataGridTextColumn
                    Binding="{Binding CreatedBy}"
                    Header="By"
                    IsColumnFiltered="True"
                    SortMemberPath="CreatedBy" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding Year}"
                    Header="Year"
                    IsColumnFiltered="True"
                    SortMemberPath="Year" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding Month}"
                    Header="Month"
                    IsColumnFiltered="True"
                    SortMemberPath="Month" />
                <filterDataGrid:DataGridTextColumn
                    Binding="{Binding ActivityType}"
                    Header="Type"
                    IsColumnFiltered="True"
                    SortMemberPath="Month" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding Activities}"
                    Header="Activities"
                    SortMemberPath="Activities" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding Miles, StringFormat={}{0:N0}}"
                    Header="Miles"
                    SortMemberPath="Miles" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding Hours, StringFormat={}{0:N0}}"
                    Header="Hours"
                    SortMemberPath="Hours" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding Climb, StringFormat='{}{0:N0}\''}"
                    Header="Climb"
                    SortMemberPath="Climb" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding Descent, StringFormat='{}{0:N0}\''}"
                    Header="Descent"
                    SortMemberPath="Descent" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding MinElevation, StringFormat='{}{0:N0}\''}"
                    Header="Min Elevation"
                    SortMemberPath="MinElevation" />
                <filterDataGrid:DataGridTextColumn
                    behaviors:DataGridCustomSortBehavior.CustomSort="{StaticResource NumberFriendlyComp}"
                    Binding="{Binding MaxElevation, StringFormat='{}{0:N0}\''}"
                    Header="Max Elevation"
                    SortMemberPath="MaxElevation" />
                <filterDataGrid:DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Data.ContentMapCommand, Source={StaticResource proxy}}"
                                    CommandParameter="{Binding .}">
                                Map
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </filterDataGrid:DataGridTemplateColumn>
            </DataGrid.Columns>
        </filterDataGrid:FilterDataGrid>
        <GroupBox
            Grid.Row="1"
            Margin="4"
            Header="Selected Totals">
            <GroupBox.Resources>
                <Style x:Key="TotalLabelTextBlockStyle" TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
                <Style x:Key="TotalBorderStyle" TargetType="Border">
                    <Setter Property="Margin" Value="6,0,6,0" />
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="Background" Value="WhiteSmoke" />
                    <Setter Property="BorderBrush" Value="Gray" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="3" />
                </Style>
                <Style x:Key="TotalValueTextBlockStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Style>
            </GroupBox.Resources>
            <StackPanel Margin="8" Orientation="Horizontal">
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Rows" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding SelectedRowCount, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Activities" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding TotalActivities, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Miles" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding TotalMiles, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Hours" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding TotalHours, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Climb" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding TotalClimb, StringFormat='{}{0:N0}\''}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Descent" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding TotalDescent, StringFormat='{}{0:N0}\''}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Min Elev" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding MinimumElevation, StringFormat='{}{0:N0}\''}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TotalBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TotalLabelTextBlockStyle}" Text="Max Elev" />
                        <TextBlock Style="{StaticResource TotalValueTextBlockStyle}"
                                   Text="{Binding MaximumElevation, StringFormat='{}{0:N0}\''}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>
        <windowScreenShot:WindowScreenShotControl
            Grid.Row="0"
            Grid.Column="0"
            HorizontalContentAlignment="Right"
            VerticalContentAlignment="Bottom"
            d:IsHidden="true" />
        <status:StatusControl
            Grid.Row="0"
            d:IsHidden="true"
            DataContext="{Binding StatusContext}" />
    </Grid>
</Window>
