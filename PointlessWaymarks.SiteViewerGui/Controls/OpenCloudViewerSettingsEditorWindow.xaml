<Window x:Class="PointlessWaymarks.SiteViewerGui.Controls.OpenCloudViewerSettingsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointlessWaymarks.SiteViewerGui.Controls"
        xmlns:status="clr-namespace:PointlessWaymarks.WpfCommon.Status;assembly=PointlessWaymarks.WpfCommon"
        xmlns:windowScreenShot="clr-namespace:PointlessWaymarks.WpfCommon.WindowScreenShot;assembly=PointlessWaymarks.WpfCommon"
        xmlns:valueConverters="clr-namespace:PointlessWaymarks.WpfCommon.ValueConverters;assembly=PointlessWaymarks.WpfCommon"
        xmlns:wpf="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:PointlessWaymarks.WpfCommon.Behaviors;assembly=PointlessWaymarks.WpfCommon"
        mc:Ignorable="d"
        Title="OpenCloudViewerSettingsEditorWindow" Height="450" Width="800" d:DataContext="{d:DesignInstance local:OpenCloudViewerSettingsEditorWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/PointlessWaymarks.CmsWpfControls;component/WpfControlsResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <valueConverters:S3ProviderIsAmazonCollapsedConverter x:Key="S3ProviderIsAmazonCollapsed" />
            <Style TargetType="StackPanel">
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="{x:Static wpf:Styles.DocumentStyleKey}" TargetType="{x:Type FlowDocument}">
                <Setter Property="FontFamily" Value="Calibri" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
            <StackPanel Margin="0,4,12,4">
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=NameTextBox}">
                        Name
                    </Label>
                    <TextBox
                        Name="NameTextBox"
                        Style="{StaticResource DataEntryTextBoxSingleLineStyle}"
                        Text="{Binding Context.EditorSettings.CloudViewerSettingsName, UpdateSourceTrigger=PropertyChanged}" />
                    <wpf:MarkdownViewer Markdown="{Binding Context.HelpMarkdownName}">
                        <b:Interaction.Behaviors>
                            <behaviors:IgnoreMouseWheelBehavior />
                        </b:Interaction.Behaviors>
                    </wpf:MarkdownViewer>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=SiteUrlTextBox}">
                        Domain
                    </Label>
                    <TextBox
                        Name="SiteUrlTextBox"
                        Style="{StaticResource DataEntryTextBoxSingleLineStyle}"
                        Text="{Binding Context.EditorSettings.CloudViewerSiteDomain, UpdateSourceTrigger=PropertyChanged}" />
                    <wpf:MarkdownViewer Markdown="{Binding Context.HelpMarkdownDomain}">
                        <b:Interaction.Behaviors>
                            <behaviors:IgnoreMouseWheelBehavior />
                        </b:Interaction.Behaviors>
                    </wpf:MarkdownViewer>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=S3BucketTextBox}">
                        Cloud S3 Storage
                    </Label>
                    <wpf:MarkdownViewer Markdown="{Binding Context.HelpMarkdownS3Information}">
                        <b:Interaction.Behaviors>
                            <behaviors:IgnoreMouseWheelBehavior />
                        </b:Interaction.Behaviors>
                    </wpf:MarkdownViewer>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=S3StorageProviderComboBox}">
                        S3 Storage Provider
                    </Label>
                    <ComboBox
                        Name="S3StorageProviderComboBox"
                        Width="200"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Context.CloudProviderChoices}"
                        SelectedValue="{Binding Context.EditorSettings.CloudViewerProvider, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=S3BucketTextBox}">
                        S3 Bucket Name
                    </Label>
                    <TextBox
                        Name="S3BucketTextBox"
                        Style="{StaticResource DataEntryTextBoxSingleLineStyle}"
                        Text="{Binding Context.EditorSettings.CloudViewerBucket, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label
                        Style="{StaticResource DataEntryLabelStyle}"
                        Target="{Binding ElementName=S3BucketRegionComboBox}"
                        Visibility="{Binding Context.EditorSettings.CloudViewerProvider, Converter={StaticResource S3ProviderIsAmazonCollapsed}}">
                        S3 Bucket CloudViewerRegion
                    </Label>
                    <ComboBox
                        Name="S3BucketRegionComboBox"
                        Width="200"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Context.RegionChoices}"
                        SelectedValue="{Binding Context.EditorSettings.CloudViewerRegion, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding Context.EditorSettings.CloudViewerProvider, Converter={StaticResource S3ProviderIsAmazonCollapsed}}" />
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=S3AccessKeyTextBox}">
                        S3 Access Key
                    </Label>
                    <TextBox
                        Name="S3AccessKeyTextBox"
                        Style="{StaticResource DataEntryTextBoxSingleLineStyle}"
                        Text="{Binding Context.EditorSettings.CloudViewerAccessKey, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=S3SecretTextBox}">
                        S3 Secret
                    </Label>
                    <TextBox
                        Name="S3SecretTextBox"
                        Style="{StaticResource DataEntryTextBoxSingleLineStyle}"
                        Text="{Binding Context.EditorSettings.CloudViewerSecret, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label Style="{StaticResource DataEntryLabelStyle}"
                           Target="{Binding ElementName=S3ServiceUrlTextBox}">
                        Service URL
                    </Label>
                    <TextBox
                        Name="S3ServiceUrlTextBox"
                        Style="{StaticResource DataEntryTextBoxSingleLineStyle}"
                        Text="{Binding Context.EditorSettings.CloudServiceUrl, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Width="120" Margin="2" Command="{Binding Context.SaveCommand}">Save</Button>
                <Button Width="120" Margin="2" Command="{Binding Context.SaveAsCommand}">Save As</Button>
                <Button Width="120" Margin="2" Command="{Binding Context.CancelCommand}">Cancel</Button>
            </StackPanel>
        </Border>
        <windowScreenShot:WindowScreenShotControl
            Width="32"
            Height="32"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="4"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom" />
        <status:StatusControl
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="2"
            d:IsHidden="True"
            DataContext="{Binding StatusContext}" />
    </Grid>
</Window>
