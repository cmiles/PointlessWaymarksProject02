<UserControl x:Class="PointlessWaymarks.PhotoMetadataBasicsGui.Controls.AppSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointlessWaymarks.PhotoMetadataBasicsGui.Controls"
             xmlns:stringDataEntry="clr-namespace:PointlessWaymarks.WpfCommon.StringDataEntry;assembly=PointlessWaymarks.WpfCommon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance local:AppSettingsContext}">
    <Grid>
        <StackPanel Orientation="Vertical">
            <stringDataEntry:StringDataEntryControl
                DataContext="{Binding CreatedByEntryContext}" />
            <Grid Margin="4,8,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <stringDataEntry:StringDataEntryControl
                    Grid.Column="0"
                    DataContext="{Binding DefaultGpxDirectoryEntryContext}" />
                <Button Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                        Command="{Binding BrowseForDefaultGpxDirectoryCommand}">Browse...</Button>
            </Grid>
            <Button Margin="4,8,4,0" Command="{Binding SaveSettingsCommand}">Save</Button>
        </StackPanel>
    </Grid>
</UserControl>
