<Page x:Class="PointedHorizons.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:PointedHorizons.Controls"
      xmlns:vm="clr-namespace:PointedHorizons.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1100">

    <Grid x:Name="MainRootGrid">
        <Grid.RowDefinitions>
            <!-- Top App Bar (Header, Presets) -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Split Top Horizon / Middle Directions Bar / Bottom Map -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Presets Bar -->
        <Border x:Name="TopHeaderBorder" Grid.Row="0" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌄" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtAppTitle" Text="Pointed Horizons" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAppSubtitle" Text=" · PeakFinder Horizon &amp; Map" FontSize="12" VerticalAlignment="Center" Margin="6,2,0,0"/>
                </StackPanel>

                <!-- Center Presets Quick Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPresetsLabel" Text="Presets:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnPresetRincon" Content="Rincon (Screenshot)" Click="BtnPresetRincon_Click"
                            Style="{StaticResource PillButtonStyle}" FontSize="11" Margin="2" />
                    <Button x:Name="BtnPresetLemmon" Content="Mount Lemmon" Click="BtnPresetLemmon_Click"
                            Style="{StaticResource PillButtonStyle}" FontSize="11" Margin="2" />
                    <Button x:Name="BtnPresetRainier" Content="Mount Rainier" Click="BtnPresetRainier_Click"
                            Style="{StaticResource PillButtonStyle}" FontSize="11" Margin="2" />
                    <Button x:Name="BtnPresetCanyon" Content="Grand Canyon" Click="BtnPresetCanyon_Click"
                            Style="{StaticResource PillButtonStyle}" FontSize="11" Margin="2" />
                    <Button x:Name="BtnPresetPikes" Content="Pikes Peak" Click="BtnPresetPikes_Click"
                            Style="{StaticResource PillButtonStyle}" FontSize="11" Margin="2" />
                    <Button x:Name="BtnPresetYosemite" Content="Yosemite" Click="BtnPresetYosemite_Click"
                            Style="{StaticResource PillButtonStyle}" FontSize="11" Margin="2" />
                    <Button x:Name="BtnPresetWashington" Content="Mount Washington" Click="BtnPresetWashington_Click"
                            Style="{StaticResource PillButtonStyle}" FontSize="11" Margin="2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Split Screen -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- Top Half: Horizon Ray-Traced View (PeakFinder style) -->
                <RowDefinition Height="1.1*" MinHeight="220" />
                <!-- Middle Split Bar: Moving Directions Bar & Refresh Button -->
                <RowDefinition Height="Auto" />
                <!-- Bottom Half: Leaflet Interactive Map -->
                <RowDefinition Height="1*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- Top Horizon View Control -->
            <controls:HorizonViewControl Grid.Row="0" x:Name="HorizonViewer" />

            <!-- Middle Bar: Directions Bar (Moving compass ticks, cardinals) & Refresh Button -->
            <Border x:Name="SplitBarBorder" Grid.Row="1" BorderThickness="0,1,0,1" Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Moving Directions Bar (Cardinals N, NE, E, SE... with dynamic ticks) -->
                    <controls:DirectionsBarControl Grid.Column="0" x:Name="DirectionsBar" />

                    <!-- Refresh Button -->
                    <Button x:Name="BtnRefresh" Grid.Column="1" Content="↻ Refresh Horizon" Click="BtnRefresh_Click"
                            Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" Margin="6,3,10,3" VerticalAlignment="Center"
                            FontSize="11" FontWeight="SemiBold" />
                </Grid>
            </Border>

            <!-- Bottom Leaflet Map Control -->
            <controls:LeafletMapControl Grid.Row="2" x:Name="LeafletMap" />
        </Grid>
    </Grid>
</Page>
