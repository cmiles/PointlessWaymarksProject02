<Page x:Class="PointedHorizons.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:PointedHorizons.Controls"
      xmlns:vm="clr-namespace:PointedHorizons.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1100">

    <Grid x:Name="MainRootGrid">
        <Grid.RowDefinitions>
            <!-- Top App Bar (Header, Tabs, Options Hamburger) -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Tabs -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Options Bar (Present on ALL pages) -->
        <Border x:Name="TopHeaderBorder" Grid.Row="0" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel x:Name="AppBrandingPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="TxtAppTitle" Text="Pointed Horizons" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Main View Tabs (Full Screen Map is FIRST; On small screens: Aim Map is BEFORE Horizon) -->
                <Border x:Name="TabsBorder" Grid.Column="1" HorizontalAlignment="Left" BorderThickness="1" CornerRadius="16" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- 1. Map Tab (First tab) -->
                        <Button x:Name="BtnTabMap" Content="🗺️ Map" Click="BtnTabMap_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="1"
                                FontSize="11" FontWeight="SemiBold" ToolTipService.ToolTip="Interactive map with GPS tracking, recording and tools" />

                        <!-- 2. Sun & Moon Times Tab (Dedicated page after Main Map) -->
                        <Button x:Name="BtnTabCelestial" Content="☀️ Sun &amp; Moon" Click="BtnTabCelestial_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="1"
                                FontSize="11" FontWeight="SemiBold" ToolTipService.ToolTip="Topography-compensated sun and moon rise/set times" />

                        <!-- 3. View Map Tab (Before Horizon page on small screens; collapsed on large screen) -->
                        <Button x:Name="BtnTabAimMap" Content="🧭 View Map" Click="BtnTabAimMap_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="1"
                                FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"
                                ToolTipService.ToolTip="Observer location, direction cone, and horizon targeting map" />

                        <!-- 4. Horizon Tab (On large screen: Split view; On small screen: Horizon Panorama only, after Aim Map) -->
                        <Button x:Name="BtnTabHorizon" Content="🌄 Horizon View" Click="BtnTabHorizon_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="1"
                                FontSize="11" FontWeight="SemiBold" ToolTipService.ToolTip="Ray-traced skyline horizon panorama" />

                        <!-- 5. Gpx Files Tab -->
                        <Button x:Name="BtnTabTracks" Content="📁 Gpx Files" Click="BtnTabTracks_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="1"
                                FontSize="11" FontWeight="SemiBold" ToolTipService.ToolTip="Import, view, and manage GPX, TCX, and FIT files" />

                        <!-- 6. Options Tab (Dedicated full-sized page) -->
                        <Button x:Name="BtnTabOptions" Content="⚙️ Options" Click="BtnTabOptions_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="1"
                                FontSize="11" FontWeight="SemiBold" ToolTipService.ToolTip="Application settings, units, offline maps, theme, and updates" />

                        <!-- 7. About Tab -->
                        <Button x:Name="BtnTabAbout" Content="ℹ️ About" Click="BtnTabAbout_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="1"
                                FontSize="11" FontWeight="SemiBold" ToolTipService.ToolTip="About Pointed Horizons, packages, and author info" />
                    </StackPanel>
                </Border>

                <!-- Compact Page Navigation Selector (Small Screens) -->
                <Border x:Name="CompactNavBorder" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,8,0" Visibility="Collapsed">
                    <Button x:Name="BtnCompactNav" Content="🗺️ Map ▾" Click="BtnCompactNav_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="12,8" Margin="0"
                            FontSize="13.5" FontWeight="Bold" ToolTipService.ToolTip="Switch between Map, Celestial, View Map, Horizon, Gpx Files, and Options" />
                </Border>

                <!-- Right Side: GPS On/Off and Record Track Icon Buttons (Present on ALL pages) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnTitleToggleGps" Click="BtnTitleToggleGps_Click"
                            Style="{StaticResource PillButtonStyle}" Margin="0,0,8,0" Padding="5,2" MinWidth="44"
                            ToolTipService.ToolTip="Toggle GPS hardware receiver: Long press to turn on/off GPS">
                        <controls:GpsIcon x:Name="IconTitleGps" IconSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="BtnTitleRecordTrack" Click="BtnTitleRecordTrack_Click"
                            Style="{StaticResource PillButtonStyle}" Margin="0" Padding="8,4" MinWidth="44"
                            ToolTipService.ToolTip="Record Track: Long press to start recording GPS track">
                        <controls:RecordTrackIcon x:Name="IconTitleRecordTrack" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Content Area -->
        <Grid Grid.Row="1" x:Name="TabContentGrid">
            <!-- TAB 1: Full Screen Interactive Map (FIRST PAGE, Default Visible) -->
            <Grid x:Name="ViewFullScreenMapTab" Visibility="Visible">
                <controls:FullScreenMapControl x:Name="FullScreenMapControlView" />
            </Grid>

            <!-- TAB 2: Sun & Moon Times Page (Dedicated page after Main Map) -->
            <Grid x:Name="ViewCelestialTab" Visibility="Collapsed" Background="Transparent">
                <controls:CelestialInfoControl x:Name="CelestialPageView" />
            </Grid>

            <!-- TAB 3: Horizon View (Supports both Split View on large screens and dedicated Single View on small screens) -->
            <Grid x:Name="ViewHorizonTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Top Half: Horizon Ray-Traced View (PeakFinder style) -->
                    <RowDefinition x:Name="RowHorizonTop" Height="1.1*" MinHeight="220" />
                    <!-- Middle Split Bar: Moving Directions Bar & Refresh Button -->
                    <RowDefinition x:Name="RowDirectionsBar" Height="Auto" />
                    <!-- Bottom Half: Leaflet Interactive Map -->
                    <RowDefinition x:Name="RowHorizonBottom" Height="1*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- Top Horizon View Control -->
                <controls:HorizonViewControl Grid.Row="0" x:Name="HorizonViewer" />

                <!-- Middle Bar: Directions Bar & Refresh Button -->
                <Border x:Name="SplitBarBorder" Grid.Row="1" BorderThickness="0,1,0,1" Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Moving Directions Bar -->
                        <controls:DirectionsBarControl Grid.Column="0" x:Name="DirectionsBar" />

                        <!-- Refresh Button -->
                        <Button x:Name="BtnRefresh" Grid.Column="1" Content="↻ Refresh Horizon" Click="BtnRefresh_Click"
                                Style="{StaticResource PillButtonStyle}"
                                Padding="10,4" Margin="6,3,10,3" VerticalAlignment="Center"
                                FontSize="11" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- Bottom Leaflet Map Control (Observer Location & Aiming) -->
                <controls:LeafletMapControl Grid.Row="2" x:Name="LeafletMap" />
            </Grid>

            <!-- TAB 4: Tracks & GPX Files Manager -->
            <Grid x:Name="ViewTracksTab" Visibility="Collapsed">
                <controls:TracksManagerControl x:Name="TracksControlView" />
            </Grid>

            <!-- TAB 5: Application Options Full-Sized Page -->
            <Grid x:Name="ViewOptionsTab" Visibility="Collapsed" Background="Transparent">
                <ScrollViewer x:Name="OptionsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <StackPanel x:Name="OptionsPageContainer" Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="680" Margin="16,20" Background="Transparent">
                        <!-- Header Card -->
                        <Border x:Name="OptionsHeaderCard" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtOptionsPageTitle" Text="Application Options" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TxtOptionsPageSubtitle" Text="Configure measurement units, offline mapping, appearance, search services, and updates."
                                           FontSize="11" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Card 1: Units -->
                        <Border x:Name="CardOptionsUnits" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="TxtSectionUnits" Text="📏 ELEVATION &amp; DISTANCE UNITS" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtUnitsHelp" Text="Choose whether elevation and distances are shown in imperial (feet/miles) or metric (meters/km)."
                                           FontSize="10.5" Opacity="0.8" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnUnitFeet" Content="Feet (ft / mi)" Click="BtnUnitFeet_Click"
                                            Style="{StaticResource PillButtonStyle}" Padding="16,8" Margin="0,0,8,0"
                                            FontSize="12" FontWeight="Bold" />
                                    <Button x:Name="BtnUnitMeters" Content="Meters (m / km)" Click="BtnUnitMeters_Click"
                                            Style="{StaticResource PillButtonStyle}" Padding="16,8"
                                            FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Offline Maps & Local DEMs -->
                        <Border x:Name="CardOptionsOffline" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="TxtSectionOffline" Text="🗺️ OFFLINE MAPS &amp; LOCAL DEMS" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtOfflineHelp" Text="Manage vector PMTiles map packages, configure layer ordering and visibility, and set local DEM elevation directories."
                                           FontSize="10.5" Opacity="0.8" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <Button x:Name="BtnOpenPmTilesConfig" Content="🗺️ Configure PMTiles &amp; DEMs..." Click="BtnOpenPmTilesConfig_Click"
                                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left"
                                        Padding="16,8" FontSize="12" FontWeight="SemiBold"
                                        ToolTipService.ToolTip="Configure offline PMTiles files, layer ordering, and local DEM directories" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Appearance & Theme -->
                        <Border x:Name="CardOptionsTheme" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="TxtSectionTheme" Text="🌓 APPEARANCE &amp; THEME" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtThemeHelp" Text="Switch between dark mode and light mode across all views and maps."
                                           FontSize="10.5" Opacity="0.8" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <Button x:Name="BtnToggleAppTheme" Content="🌓 Toggle Dark / Light Theme" Click="BtnToggleAppTheme_Click"
                                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left"
                                        Padding="16,8" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: GeoNames Search API -->
                        <Border x:Name="CardOptionsGeoNames" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="TxtSectionGeoNames" Text="🔍 GEONAMES SEARCH API" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtGeoNamesHelp" Text="Enter your free GeoNames.org username to enable worldwide location, landmark, and peak search across maps and horizon ray-tracing."
                                           FontSize="10.5" Opacity="0.8" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <Grid x:Name="GridGeoNamesInput" Margin="0,0,0,6" MaxWidth="500" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="RowGeoNamesInput" Height="Auto" />
                                        <RowDefinition x:Name="RowGeoNamesBtn" Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColGeoNamesInput" Width="*" />
                                        <ColumnDefinition x:Name="ColGeoNamesBtn" Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtGeoNamesUsernameInput" Grid.Row="0" Grid.Column="0" FontSize="12" Padding="8,6" VerticalAlignment="Center" />
                                    <Button x:Name="BtnSaveGeoNamesUsername" Grid.Row="0" Grid.Column="1" Content="Save Username" Click="BtnSaveGeoNamesUsername_Click"
                                            Style="{StaticResource PillButtonStyle}" Margin="8,0,0,0" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="TxtGeoNamesConfigStatus" Text="" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Updates -->
                        <Border x:Name="CardOptionsUpdates" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,24">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="TxtSectionUpdates" Text="🚀 APPLICATION UPDATES" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtUpdatesHelp" Text="Check for new software releases and automatically install package updates."
                                           FontSize="10.5" Opacity="0.8" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <Button x:Name="BtnCheckUpdates" Content="🚀 Check for Updates..." Click="BtnUpdates_Click"
                                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left"
                                        Padding="16,8" FontSize="12" FontWeight="SemiBold"
                                        ToolTipService.ToolTip="Check online catalog for software updates" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- TAB 6: About Page (Dedicated full-sized page) -->
            <Grid x:Name="ViewAboutTab" Visibility="Collapsed" Background="Transparent">
                <ScrollViewer x:Name="AboutScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="720" Margin="16,20" Background="Transparent">
                        <controls:AboutControl x:Name="AboutPageView" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Compact Page Navigation Dropdown Popup (Small Screens) -->
        <Border x:Name="CompactNavBackdrop" Grid.Row="0" Grid.RowSpan="2" Background="#40000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                MouseLeftButtonDown="BtnCloseCompactNav_Click" />

        <Border x:Name="CompactNavPanel" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,52,0,0" Width="230" Visibility="Collapsed"
                BorderThickness="1" CornerRadius="12" Padding="12,10">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCompactNavTitle" Text="🧭 Page Navigation" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button x:Name="BtnCloseCompactNav" Grid.Column="1" Content="✕" Click="BtnCloseCompactNav_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="6,2" FontSize="10" />
                </Grid>

                <Border x:Name="CompactNavDivider" Height="1" Margin="0,2,0,8" />

                <Button x:Name="BtnNavPageMap" Content="🗺️ Map" Click="BtnNavPageMap_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,7" Margin="0,2" FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnNavPageCelestial" Content="☀️ Sun &amp; Moon" Click="BtnNavPageCelestial_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,7" Margin="0,2" FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnNavPageAimMap" Content="🧭 View Map" Click="BtnNavPageAimMap_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,7" Margin="0,2" FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnNavPageHorizon" Content="🌄 Horizon View" Click="BtnNavPageHorizon_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,7" Margin="0,2" FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnNavPageTracks" Content="📁 Gpx Files" Click="BtnNavPageTracks_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,7" Margin="0,2" FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnNavPageOptions" Content="⚙️ Options" Click="BtnNavPageOptions_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,7" Margin="0,2" FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnNavPageAbout" Content="ℹ️ About" Click="BtnNavPageAbout_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,7" Margin="0,2" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- PMTiles Configuration Pop-up Modal Dialog Overlay -->
        <Border x:Name="PmTilesModalBackdrop" Grid.Row="0" Grid.RowSpan="2" Background="#66000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                MouseLeftButtonDown="BtnClosePmTilesModal_Click" />

        <controls:PmTilesConfigControl x:Name="PmTilesConfigModal" Grid.Row="0" Grid.RowSpan="2"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Visibility="Collapsed" />

        <!-- GeoNames Location Search Pop-up Modal Dialog Overlay -->
        <Border x:Name="GeoNamesSearchBackdrop" Grid.Row="0" Grid.RowSpan="2" Background="#66000000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                MouseLeftButtonDown="BtnCloseGeoNamesSearch_Click" />

        <controls:GeoNamesSearchControl x:Name="GeoNamesSearchModal" Grid.Row="0" Grid.RowSpan="2"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Visibility="Collapsed" />

        <!-- Application Updates Modal Dialog Overlay -->
        <Grid x:Name="UpdateWindowOverlayGrid" Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding UpdateWindowVisibility, FallbackValue='Collapsed'}">
            <!-- Semi-transparent backdrop -->
            <Border Background="#80000000" />
            <!-- Centered Update Modal Control -->
            <controls:AppUpdateWindowControl HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
        </Grid>

        <!-- On-Screen Notification Toast Overlay (Record Track long-press prompt & status confirmations) -->
        <Border x:Name="TrackActionToast" Canvas.ZIndex="999" Grid.Row="0" Grid.RowSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="0"
                Background="#EE1E293B" BorderBrush="#FF475569" BorderThickness="1"
                CornerRadius="20" Padding="16,10"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTrackActionToastIcon" Text="ℹ️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtTrackActionToast" Text="Long press to start recording"
                           FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
