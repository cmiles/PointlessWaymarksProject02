<ResourceDictionary x:Class="PointedHorizons.Themes.DarkTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core App Surfaces & Text -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#070A10" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="SubtleCardBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SubtleCardBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="DividerBrush" Color="#334155" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextHeadingBrush" Color="#F8FAFC" />

    <!-- Links & Accents -->
    <SolidColorBrush x:Key="HyperlinkBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="SkyAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="EmeraldAccentBrush" Color="#10B981" />
    <SolidColorBrush x:Key="RedAccentBrush" Color="#EF4444" />

    <!-- Map & Canvas Overlays -->
    <SolidColorBrush x:Key="MapOverlayBackgroundBrush" Color="#E60F172A" />
    <SolidColorBrush x:Key="MapOverlayBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="SplitBarBackgroundBrush" Color="#0A0E17" />
    <SolidColorBrush x:Key="SplitBarBorderBrush" Color="#1E293B" />

    <!-- Button Brushes -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="ButtonInactiveBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="ButtonInactiveForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ButtonInactiveBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="ButtonActiveBackgroundBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="ButtonActiveForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonActiveBorderBrush" Color="#0284C7" />

    <!-- Reusable Clean Pill Button Style with TemplateBinding -->
    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ButtonForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
