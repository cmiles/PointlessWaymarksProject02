<UserControl x:Class="PointedHorizons.Controls.LeafletMapControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              d:DesignHeight="350" d:DesignWidth="900">

    <Grid x:Name="MapRootGrid">
        <!-- Leaflet Map Container -->
        <Border x:Name="MapContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Top-Left Floating Controls: Hamburger Menu Button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
            <Button x:Name="BtnHamburger" Content="☰" Click="BtnHamburger_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="10,6"
                    FontSize="16" FontWeight="Bold"
                    ToolTipService.ToolTip="Open Map Choices Menu" />
        </StackPanel>

        <!-- Floating Azimuth & Direction Toolbar Overlay (Top Center) -->
        <Border x:Name="DirectionToolbarBorder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,12,10,0"
                BorderThickness="1" CornerRadius="10" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Compass Cardinal Quick Buttons -->
                <TextBlock x:Name="TxtDirectionLabel" Text="Direction:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="BtnCardN" Content="N" Click="BtnCardN_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="Bold" />
                <Button x:Name="BtnCardNE" Content="NE" Click="BtnCardNE_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="6,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnCardE" Content="E" Click="BtnCardE_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="Bold" />
                <Button x:Name="BtnCardSE" Content="SE" Click="BtnCardSE_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="6,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnCardS" Content="S" Click="BtnCardS_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="Bold" />
                <Button x:Name="BtnCardSW" Content="SW" Click="BtnCardSW_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="6,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnCardW" Content="W" Click="BtnCardW_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="Bold" />
                <Button x:Name="BtnCardNW" Content="NW" Click="BtnCardNW_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="6,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />

                <Border x:Name="ToolbarDivider" Width="1" Margin="8,2" Height="18" VerticalAlignment="Center"/>

                <!-- Azimuth Slider -->
                <TextBlock x:Name="TxtAngleLabel" Text="Angle:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="SliderAzimuth" Minimum="0" Maximum="360" Value="{Binding Azimuth, Mode=TwoWay}"
                        Width="130" VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="SliderAzimuth_ValueChanged"/>
                <TextBlock x:Name="TxtAzimuthValue" Text="{Binding AzimuthDisplay}" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" Width="70"/>
            </StackPanel>
        </Border>

        <!-- Floating Location Info & My Location Badge (Lower Left) -->
        <Border x:Name="LocationBadgeBorder" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                BorderThickness="1" CornerRadius="8" Padding="10,8">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📍 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCoordinatesValue" Text="{Binding CoordinatesDisplay}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="18,2,0,4">
                    <TextBlock x:Name="TxtElevationLabel" Text="Elevation: " FontSize="10"/>
                    <TextBlock x:Name="TxtElevationValue" Text="{Binding ObserverElevationDisplay}" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Button x:Name="BtnMyLocation" Content="📍 My Location" Click="BtnMyLocation_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="0,0,6,0"
                            FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"
                            ToolTipService.ToolTip="Acquire current GPS position and move observer there" />
                    <Button x:Name="BtnAim3d" Content="🏔️ 3D" Click="BtnAim3d_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="0,0,6,0"
                            FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"
                            ToolTipService.ToolTip="Toggle 3D terrain perspective view along azimuth" />
                    <Button x:Name="BtnAimReset" Content="↺ Reset" Click="BtnAimReset_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4"
                            FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"
                            ToolTipService.ToolTip="Reset camera to flat top-down 2D view and recover if stuck" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Floating Hamburger Dropdown Menu Panel (Rendered after LocationBadgeBorder so it appears on top) -->
        <Border x:Name="HamburgerPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="12,50,0,12" Width="320" MaxHeight="520" Visibility="Collapsed"
                BorderThickness="1" CornerRadius="12" Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtMenuTitle" Text="🧭 Aim Map Settings" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="BtnCloseMenu" Grid.Column="1" Content="✕" Click="BtnCloseMenu_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="6,2" FontSize="11" />
                    </Grid>

                    <Border x:Name="MenuDivider" Height="1" Margin="0,0,0,10" />

                    <!-- Location Presets (Aim Viewpoint Settings) -->
                    <TextBlock x:Name="TxtSectionPresets" Text="LOCATION PRESETS" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                        <Button x:Name="BtnPresetRincon" Content="Tucson East (Rincon Ridges), AZ" Click="BtnPresetRincon_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,5" Margin="0,2" FontSize="11" />
                        <Button x:Name="BtnPresetLemmon" Content="Mount Lemmon, AZ" Click="BtnPresetLemmon_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,5" Margin="0,2" FontSize="11" />
                        <Button x:Name="BtnPresetRainier" Content="Mount Rainier (Paradise), WA" Click="BtnPresetRainier_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,5" Margin="0,2" FontSize="11" />
                        <Button x:Name="BtnPresetGrandCanyon" Content="Grand Canyon (Mather Point), AZ" Click="BtnPresetGrandCanyon_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,5" Margin="0,2" FontSize="11" />
                        <Button x:Name="BtnPresetPikes" Content="Pikes Peak, CO" Click="BtnPresetPikes_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,5" Margin="0,2" FontSize="11" />
                        <Button x:Name="BtnPresetYosemite" Content="Yosemite (Glacier Point), CA" Click="BtnPresetYosemite_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,5" Margin="0,2" FontSize="11" />
                        <Button x:Name="BtnPresetWashington" Content="Mount Washington, NH" Click="BtnPresetWashington_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="8,5" Margin="0,2" FontSize="11" />
                    </StackPanel>

                    <Border x:Name="MenuDivider2" Height="1" Margin="0,0,0,10" />

                    <!-- Base Map Layer Switcher -->
                    <TextBlock x:Name="TxtSectionLayer" Text="BASE MAP LAYER" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <Button x:Name="BtnLayerTopo" Content="Topo" Click="BtnLayerTopo_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold" />
                        <Button x:Name="BtnLayerStreets" Content="Streets" Click="BtnLayerStreets_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold" />
                        <Button x:Name="BtnLayerSatellite" Content="Satellite" Click="BtnLayerSatellite_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold" />
                        <Button x:Name="BtnLayerPmTiles" Content="PMTiles" Click="BtnLayerPmTiles_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="9,4" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnLayerQuads" Content="Quads" Click="BtnLayerQuads_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold"
                                ToolTipService.ToolTip="Classic Scanned USGS Topo Quads (USA Topo Maps)" />
                        <Button x:Name="BtnLayerOpenTopo" Content="OpenTopo" Click="BtnLayerOpenTopo_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold"
                                ToolTipService.ToolTip="OpenTopoMap: Global topographic map with contours, hillshade, and trails" />
                        <Button x:Name="BtnLayerHybrid" Content="Hybrid" Click="BtnLayerHybrid_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold"
                                ToolTipService.ToolTip="Satellite Imagery with Road, Boundary &amp; Place Name Labels" />
                    </StackPanel>

                    <!-- Public Lands (PAD-US) Transparent Overlay Toggle -->
                    <Button x:Name="BtnTogglePadUs" Content="🌲 Public Lands (PAD-US): OFF" Click="BtnTogglePadUs_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,0,0,6" FontSize="10" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Toggle semi-transparent Federal and State Public Lands overlay (BLM, USFS, NPS, State)" />

                    <Button x:Name="BtnConfigurePmTiles" Content="⚙️ Configure PMTiles..." Click="BtnConfigurePmTiles_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,0,0,4" FontSize="10" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Select PMTiles files and configure layers" />

                    <Border x:Name="MenuDivider3" Height="1" Margin="0,4,0,8" />

                    <!-- View & Camera -->
                    <TextBlock x:Name="TxtSectionViews" Text="VIEW &amp; POSITION" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <Button x:Name="BtnMenuPositionFromMainMap" Content="🎯 Position from Main Map" Click="BtnPositionFromMainMap_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,2,0,4" FontSize="10" FontWeight="Bold"
                            ToolTipService.ToolTip="Set the Aim Map viewpoint and Horizon location to the Main Map location (GPS fix, marker, or center)" />
                    <Button x:Name="BtnMenuMyLocation" Content="📍 Move to My GPS Location" Click="BtnMyLocation_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,2,0,4" FontSize="10" FontWeight="SemiBold" />
                    <Button x:Name="BtnMenuAim3d" Content="🏔️ Toggle 3D Perspective" Click="BtnAim3d_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,2,0,4" FontSize="10" FontWeight="SemiBold" />
                    <Button x:Name="BtnMenuAimReset" Content="↺ Reset Map View" Click="BtnAimReset_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            Padding="8,5" Margin="0,2,0,0" FontSize="10" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Reset camera to flat top-down 2D view and recover if stuck" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
