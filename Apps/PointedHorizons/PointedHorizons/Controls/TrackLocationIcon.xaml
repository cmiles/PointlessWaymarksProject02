<UserControl x:Class="PointedHorizons.Controls.TrackLocationIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox x:Name="IconViewbox" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Active outer pulse ring (visible when tracking is active) -->
            <Border x:Name="ActivePulseRing" Width="20" Height="20" CornerRadius="10"
                    Background="#300EA5E9" BorderBrush="#700EA5E9" BorderThickness="1"
                    Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Crosshairs Circle Reticle -->
            <Ellipse x:Name="CrosshairCircle" Width="14" Height="14"
                     Stroke="#0EA5E9" StrokeThickness="1.2"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Crosshair 4 Tick Lines (Top, Bottom, Left, Right) -->
            <Path x:Name="CrosshairTicks"
                  Data="M 10,1 L 10,4.5 M 10,15.5 L 10,19 M 1,10 L 4.5,10 M 15.5,10 L 19,10"
                  Stroke="#0EA5E9" StrokeThickness="1.4"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Map-matching Position Triangle (Navigation arrow centered in crosshairs) -->
            <Path x:Name="PositionTriangle"
                  Data="M 10,5 L 13.5,14.5 L 10,12.5 L 6.5,14.5 Z"
                  Fill="#0284C7" Stroke="#FFFFFF" StrokeThickness="1.2"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Viewbox>
</UserControl>

