<UserControl x:Class="PointedHorizons.Controls.PmTilesConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="540">

    <Grid x:Name="DialogRoot">
        <Border x:Name="CardBorder" BorderThickness="1" CornerRadius="12" Padding="14,12"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="8,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                    <!-- Title Bar -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗺️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDialogTitle" Text="PMTiles &amp; Offline Storage" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="BtnCloseDialog" Grid.Column="1" Content="✕" Click="BtnClose_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="7,3" FontSize="11" FontWeight="Bold" />
                    </Grid>

                    <Border x:Name="Divider1" Height="1" Margin="0,0,0,10" />

                    <!-- SECTION 1: Folder Configuration -->
                    <TextBlock x:Name="TxtSectionFolders" Text="STORAGE FOLDERS" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />

                    <!-- Storage Permission Warning (Android) -->
                    <Border x:Name="PermissionWarningBorder" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPermissionWarningTitle" Text="All Files Access Permission Needed" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPermissionWarningMsg" Text="On Android 11+, Android restricts Pointed Horizons from reading files placed by other apps (Files app, Downloads, USB) until 'All files access' is granted." FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Button x:Name="BtnGrantStoragePermission" Content="📁 Grant All Files Access in Settings..." Click="BtnGrantStoragePermission_Click"
                                    Style="{StaticResource PillButtonStyle}" Padding="10,5" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- PMTiles Folder -->
                    <TextBlock Text="PMTiles Directory (.pmtiles files):" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,3"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPmTilesDir" Grid.Column="0" FontSize="11" Padding="6,4" VerticalAlignment="Center" />
                        <Button x:Name="BtnResetPmTiles" Grid.Column="1" Content="Reset" Click="BtnResetPmTiles_Click"
                                Style="{StaticResource PillButtonStyle}" Margin="4,0,0,0" Padding="6,4" FontSize="10" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Local DEM Folder -->
                    <TextBlock Text="Local DEM Directory (.hgt files &amp; cache):" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,3"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDemDir" Grid.Column="0" FontSize="11" Padding="6,4" VerticalAlignment="Center" />
                        <Button x:Name="BtnResetDem" Grid.Column="1" Content="Reset" Click="BtnResetDem_Click"
                                Style="{StaticResource PillButtonStyle}" Margin="4,0,0,0" Padding="6,4" FontSize="10" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- GPX & Tracks Folder -->
                    <TextBlock Text="Tracks Directory (.gpx, .tcx, .fit files):" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,3"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtGpxDir" Grid.Column="0" FontSize="11" Padding="6,4" VerticalAlignment="Center" />
                        <Button x:Name="BtnResetGpx" Grid.Column="1" Content="Reset" Click="BtnResetGpx_Click"
                                Style="{StaticResource PillButtonStyle}" Margin="4,0,0,0" Padding="6,4" FontSize="10" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Platform Storage Note / DEM Status Badge -->
                    <Border x:Name="StorageInfoBadge" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2,0,10">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="TxtDemStatus" Text="Local DEMs: Scanning..." FontSize="10" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtStorageHint" Text="Downloaded DEMs are automatically cached here. Users can also drop in .hgt or .zip files." FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Divider2" Height="1" Margin="0,0,0,10" />

                    <!-- SECTION 2: Layered PMTiles Management -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSectionLayers" Text="OFFLINE PMTILES LAYERS" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="BtnRefreshFiles" Grid.Column="1" Content="🔄 Refresh Files" Click="BtnRefreshFiles_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="7,3" FontSize="10" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock x:Name="TxtLayerInstructions" Text="Check files to display. Reorder layers with [▲]/[▼] to control which files render on top." FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <!-- No Files Message -->
                    <Border x:Name="NoFilesBorder" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="TxtNoFiles" Text="No .pmtiles files found in the folder. Place .pmtiles files in the directory above and click 'Refresh Files'." FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <!-- Layers Container List -->
                    <StackPanel x:Name="LayersListPanel" Orientation="Vertical" Margin="0,0,0,12" />

                    <Border x:Name="Divider3" Height="1" Margin="0,0,0,10" />

                    <!-- SECTION 3: Style File Selection -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSectionStyle" Text="MAP STYLE FILE (Optional)" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStyleFoundCount" Grid.Column="1" Text="" FontSize="10" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="TxtStyleInstructions" Text="Select a MapLibre JSON style file located in the PMTiles folder to apply custom layer rendering, colors, and styling." FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap" />

                    <ComboBox x:Name="CmbStyleFile" Margin="0,2,0,12" Height="28" VerticalAlignment="Center" FontSize="11" />

                    <Border x:Name="Divider4" Height="1" Margin="0,0,0,10" />

                    <!-- Footer Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Cancel" Click="BtnClose_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,5" Margin="0,0,6,0" FontSize="11" />
                        <Button x:Name="BtnSaveOnly" Content="Save" Click="BtnSaveOnly_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="10,5" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold"/>
                        <Button x:Name="BtnApplyAndUse" Content="✓ Apply &amp; Use" Click="BtnApplyAndUse_Click"
                                Style="{StaticResource PillButtonStyle}" Padding="12,5" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

