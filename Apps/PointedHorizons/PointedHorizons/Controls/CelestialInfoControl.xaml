<UserControl x:Class="PointedHorizons.Controls.CelestialInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="500">

    <Grid x:Name="DialogRoot" Background="Transparent">
        <Border x:Name="CardBorder" BorderThickness="1" CornerRadius="12" Padding="14,12"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,8">
            <Grid x:Name="CardInnerGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Divider -->
                    <RowDefinition Height="Auto" />
                    <!-- Mode Selector -->
                    <RowDefinition Height="Auto" />
                    <!-- Scrollable Content Area -->
                    <RowDefinition Height="*" />
                    <!-- Footer Buttons -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☀️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtDialogTitle" Text="Sun &amp; Moon Horizon Times" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="BtnCloseDialog" Grid.Column="1" Content="✕" Click="BtnClose_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,3" FontSize="11" FontWeight="Bold"
                            ToolTipService.ToolTip="Close" Visibility="Collapsed" />
                </Grid>

                <Border x:Name="Divider1" Grid.Row="1" Height="1" Margin="0,0,0,8" />

                <!-- 2. Location Source Selector (Segmented Bar) -->
                <Grid Grid.Row="2" x:Name="PanelModeSelector" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="RowModeSelectorRefresh" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColModeGps" Width="*" />
                        <ColumnDefinition x:Name="ColModeMap" Width="*" />
                        <ColumnDefinition x:Name="ColModeRefresh" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnOptionGps" Grid.Row="0" Grid.Column="0" Click="BtnOptionGps_Click"
                            Style="{StaticResource PillButtonStyle}" Margin="0,0,3,0" Padding="8,6"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Acquire current satellite GPS coordinates">
                        <TextBlock x:Name="TxtOptionGps" Text="📍 Current Location" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>

                    <Button x:Name="BtnOptionMap" Grid.Row="0" Grid.Column="1" Click="BtnOptionMap_Click"
                            Style="{StaticResource PillButtonStyle}" Margin="3,0,3,0" Padding="8,6"
                            HorizontalAlignment="Stretch"
                            ToolTipService.ToolTip="Use current Main Map coordinates">
                        <TextBlock x:Name="TxtOptionMap" Text="🗺️ Main Map Location" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>

                    <Button x:Name="BtnTopRefresh" Grid.Row="0" Grid.Column="2" Click="BtnRefresh_Click"
                            Style="{StaticResource PillButtonStyle}" Margin="3,0,0,0" Padding="12,6"
                            ToolTipService.ToolTip="Manually recalculate for active location">
                        <TextBlock x:Name="TxtTopRefresh" Text="↺ Refresh" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                </Grid>

                <!-- 3. Scrollable Main Content -->
                <ScrollViewer Grid.Row="3" x:Name="ContentScrollViewer"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Margin="0,0,0,8">
                    <StackPanel x:Name="ContentMainStack" Orientation="Vertical" Background="Transparent">

                        <!-- Choice View (When first launched, prior to running calculation) -->
                        <StackPanel x:Name="InitialChoicePanel" Orientation="Vertical" Margin="0,6,0,6" Background="Transparent">
                            <TextBlock x:Name="TxtChoicePrompt"
                                       Text="Choose a location source to calculate upcoming topography-compensated sun and moon rise/set times:"
                                       FontSize="11" Margin="2,0,2,12" TextWrapping="Wrap" />

                            <Border x:Name="BtnBigGpsCard" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                                    Cursor="Hand" MouseLeftButtonDown="BtnOptionGps_Click">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="📍" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtBigGpsTitle" Text="Current Location" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtBigGpsSub" Text="Acquires live satellite GPS coordinates from your device and calculates topography compensation at your physical location."
                                               FontSize="10" Margin="23,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="BtnBigMapCard" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,6"
                                    Cursor="Hand" MouseLeftButtonDown="BtnOptionMap_Click">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🗺️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtBigMapTitle" Text="Main Map Location" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="TxtBigMapSub" Text="Calculates topography-compensated horizon times for the current Main Map target location."
                                               FontSize="10" Margin="23,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Loading & Status Indicator -->
                        <StackPanel x:Name="LoadingPanel" Orientation="Vertical" Visibility="Collapsed" Margin="0,16,0,16">
                            <ProgressBar x:Name="CalculationProgressBar" IsIndeterminate="True" Height="4" Margin="0,0,0,10" />
                            <TextBlock x:Name="TxtLoadingStatus" Text="Acquiring GPS fix..."
                                       FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtLoadingSub" Text="Evaluating 360° terrain profile and celestial arcs..."
                                       FontSize="10" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Results View -->
                        <StackPanel x:Name="ResultsPanel" Orientation="Vertical" Visibility="Collapsed" Background="Transparent">

                            <!-- Location & Window Summary Card -->
                            <Border x:Name="SummaryCardBorder" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Vertical">
                                    <!-- Coords and Elevation -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📍 " FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtSummaryCoords" Text="32.2226° N, 110.9747° W" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⛰️ " FontSize="10.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtSummaryElevation" Text="2,840 ft (866 m)" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Upcoming Window -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="🕒 " FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtSummaryWindow" Text="Upcoming from today 8:30 PM" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Moon Phase Snapshot -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌙 " FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtSummaryMoonPhase" Text="Moon: Waxing Crescent (14% illuminated)" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Two-Column Responsive Container (Desktop: 2 side-by-side columns; Mobile: 1 stacked column) -->
                            <Grid x:Name="ColumnsContainerGrid" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColLeftDef" Width="*" />
                                    <ColumnDefinition x:Name="ColRightDef" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="RowCol0Def" Height="Auto" />
                                    <RowDefinition x:Name="RowCol1Def" Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- LEFT COLUMN: Chronological Celestial Timeline (Sun, Moon, Solar Noon, Photography Hours, Milky Way) -->
                                <StackPanel x:Name="ColLeftStack" Grid.Column="0" Grid.Row="0" Margin="0,0,6,0" Background="Transparent">
                                    <!-- Section Header: Upcoming Celestial Timeline -->
                                    <TextBlock x:Name="TxtSectionEvents" Text="UPCOMING CELESTIAL TIMELINE" FontSize="9.5" FontWeight="Bold" Margin="2,0,0,6" />

                                    <!-- Horizon Events Container (Dynamically ordered by start/event time) -->
                                    <StackPanel x:Name="EventsCardsContainer" Orientation="Vertical" Background="Transparent">

                                        <!-- 1. Sunrise Card -->
                                        <Border x:Name="CardSunrise" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel Orientation="Vertical">
                                                <!-- Line 1: Header (Event Type left, Time Until right) -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="IcoSunrise" Text="🌅" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtSunriseTitle" Text="Sunrise" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border x:Name="BadgeSunrise" Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtSunriseBadge" Text="In 3h 15m" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                                                    </Border>
                                                </Grid>

                                                <!-- Desktop Layout: Time + Topo Azimuth -->
                                                <Grid x:Name="GridSunriseDesktop" Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtSunriseTopoTime" Grid.Column="0" Text="6:48 AM" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtSunriseTopoAz" Text="108° ESE  •  Ridge: +4.8°" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSunriseTopoTag" Text="★ Topography Horizon" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="PanelSunriseStandardDesktop" Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock x:Name="TxtSunriseStandard" Text="Standard: 6:22 AM" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SepSunriseStandard" Text="  •  " FontSize="9.5" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock x:Name="TxtSunriseShift" Text="+26 min delay" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Mobile Layout: Line 2 Time + Indented details on own lines -->
                                                <StackPanel x:Name="PanelSunriseMobile" Orientation="Vertical" Visibility="Collapsed" Margin="0,2,0,0">
                                                    <TextBlock x:Name="TxtSunriseTopoTimeMobile" Text="6:48 AM" FontSize="13.5" FontWeight="Bold" Margin="14,2,0,2" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                                                        <TextBlock x:Name="TxtSunriseTopoAzMobile" Text="108° ESE  •  Ridge: +4.8°" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSunriseStandardMobile" Text="Standard: 6:22 AM" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSunriseShiftMobile" Text="+26 min delay" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. Sunset Card -->
                                        <Border x:Name="CardSunset" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel Orientation="Vertical">
                                                <!-- Line 1: Header (Event Type left, Time Until right) -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="IcoSunset" Text="🌇" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtSunsetTitle" Text="Sunset" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border x:Name="BadgeSunset" Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtSunsetBadge" Text="In 10h 42m" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                                                    </Border>
                                                </Grid>

                                                <!-- Desktop Layout: Time + Topo Azimuth -->
                                                <Grid x:Name="GridSunsetDesktop" Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtSunsetTopoTime" Grid.Column="0" Text="5:18 PM" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtSunsetTopoAz" Text="247° WSW  •  Ridge: +3.2°" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSunsetTopoTag" Text="★ Topography Horizon" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="PanelSunsetStandardDesktop" Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock x:Name="TxtSunsetStandard" Text="Standard: 5:35 PM" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SepSunsetStandard" Text="  •  " FontSize="9.5" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock x:Name="TxtSunsetShift" Text="-17 min earlier" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Mobile Layout: Line 2 Time + Indented details on own lines -->
                                                <StackPanel x:Name="PanelSunsetMobile" Orientation="Vertical" Visibility="Collapsed" Margin="0,2,0,0">
                                                    <TextBlock x:Name="TxtSunsetTopoTimeMobile" Text="5:18 PM" FontSize="13.5" FontWeight="Bold" Margin="14,2,0,2" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                                                        <TextBlock x:Name="TxtSunsetTopoAzMobile" Text="247° WSW  •  Ridge: +3.2°" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSunsetStandardMobile" Text="Standard: 5:35 PM" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtSunsetShiftMobile" Text="-17 min earlier" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Moonrise Card -->
                                        <Border x:Name="CardMoonrise" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel Orientation="Vertical">
                                                <!-- Line 1: Header (Event Type left, Time Until right) -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="IcoMoonrise" Text="🌙" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtMoonriseTitle" Text="Moonrise" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border x:Name="BadgeMoonrise" Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtMoonriseBadge" Text="Passed 2h ago" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                                                    </Border>
                                                </Grid>

                                                <!-- Desktop Layout: Time + Topo Azimuth -->
                                                <Grid x:Name="GridMoonriseDesktop" Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtMoonriseTopoTime" Grid.Column="0" Text="9:40 AM" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtMoonriseTopoAz" Text="112° ESE  •  Ridge: +4.1°" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtMoonriseTopoTag" Text="★ Topography Horizon" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="PanelMoonriseStandardDesktop" Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock x:Name="TxtMoonriseStandard" Text="Standard: 9:18 AM" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SepMoonriseStandard" Text="  •  " FontSize="9.5" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock x:Name="TxtMoonriseShift" Text="+22 min delay" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Mobile Layout: Line 2 Time + Indented details on own lines -->
                                                <StackPanel x:Name="PanelMoonriseMobile" Orientation="Vertical" Visibility="Collapsed" Margin="0,2,0,0">
                                                    <TextBlock x:Name="TxtMoonriseTopoTimeMobile" Text="9:40 AM" FontSize="13.5" FontWeight="Bold" Margin="14,2,0,2" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                                                        <TextBlock x:Name="TxtMoonriseTopoAzMobile" Text="112° ESE  •  Ridge: +4.1°" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtMoonriseStandardMobile" Text="Standard: 9:18 AM" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtMoonriseShiftMobile" Text="+22 min delay" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 4. Moonset Card -->
                                        <Border x:Name="CardMoonset" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel Orientation="Vertical">
                                                <!-- Line 1: Header (Event Type left, Time Until right) -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="IcoMoonset" Text="🌘" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtMoonsetTitle" Text="Moonset" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border x:Name="BadgeMoonset" Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtMoonsetBadge" Text="In 8h 20m" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                                                    </Border>
                                                </Grid>

                                                <!-- Desktop Layout: Time + Topo Azimuth -->
                                                <Grid x:Name="GridMoonsetDesktop" Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtMoonsetTopoTime" Grid.Column="0" Text="10:15 PM" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtMoonsetTopoAz" Text="254° WSW  •  Ridge: +2.9°" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtMoonsetTopoTag" Text="★ Topography Horizon" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel x:Name="PanelMoonsetStandardDesktop" Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock x:Name="TxtMoonsetStandard" Text="Standard: 10:31 PM" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SepMoonsetStandard" Text="  •  " FontSize="9.5" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock x:Name="TxtMoonsetShift" Text="-16 min earlier" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Mobile Layout: Line 2 Time + Indented details on own lines -->
                                                <StackPanel x:Name="PanelMoonsetMobile" Orientation="Vertical" Visibility="Collapsed" Margin="0,2,0,0">
                                                    <TextBlock x:Name="TxtMoonsetTopoTimeMobile" Text="10:15 PM" FontSize="13.5" FontWeight="Bold" Margin="14,2,0,2" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Vertical" Margin="28,0,0,0">
                                                        <TextBlock x:Name="TxtMoonsetTopoAzMobile" Text="254° WSW  •  Ridge: +2.9°" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtMoonsetStandardMobile" Text="Standard: 10:31 PM" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="TxtMoonsetShiftMobile" Text="-16 min earlier" FontSize="11" Margin="0,1" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
