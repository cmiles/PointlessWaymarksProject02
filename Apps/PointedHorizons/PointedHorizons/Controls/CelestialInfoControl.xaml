                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Vertical" Margin="2,0,0,0">
                                                    <TextBlock x:Name="TxtTopoSunriseHeader" Text="Mountain Sun" FontSize="9" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtTopoSunriseMiniTime" Text="6:48 AM" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Mobile Morning Progression (Vertical) -->
                                            <StackPanel x:Name="PanelMorningProgressionMobile" Orientation="Vertical" Margin="0,0,0,6" Visibility="Collapsed">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtAstroDawnLabelMobile" Text="Astronomical Dawn (-18°)" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtAstroDawnTimeMobile" Grid.Column="1" Text="5:02 AM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtNauticalDawnLabelMobile" Text="Nautical Dawn (-12°)" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtNauticalDawnTimeMobile" Grid.Column="1" Text="5:32 AM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtCivilDawnLabelMobile" Text="Civil Dawn (-6°)" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCivilDawnTimeMobile" Grid.Column="1" Text="6:02 AM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtTopoSunriseHeaderMobile" Text="Mountain Sunrise" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtTopoSunriseMiniTimeMobile" Grid.Column="1" Text="6:48 AM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- Evening Progression (Dusk) -->
                                            <TextBlock x:Name="TxtTwilightEveningHeader" Text="EVENING TWILIGHT PROGRESSION" FontSize="9" FontWeight="Bold" Margin="0,2,0,4" />
                                            <Grid x:Name="GridEveningProgressionDesktop" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,2,0">
                                                    <TextBlock x:Name="TxtTopoSunsetHeader" Text="Mountain Sun" FontSize="9" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtTopoSunsetMiniTime" Text="5:18 PM" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="2,0,2,0">
                                                    <TextBlock Text="Civil (-6°)" FontSize="9" Opacity="0.7" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtCivilDuskTime" Text="5:58 PM" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="2,0,2,0">
                                                    <TextBlock Text="Nautical (-12°)" FontSize="9" Opacity="0.7" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtNauticalDuskTime" Text="6:28 PM" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Vertical" Margin="2,0,0,0">
                                                    <TextBlock Text="Astro (-18°)" FontSize="9" Opacity="0.7" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="TxtAstroDuskTime" Text="6:58 PM" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Mobile Evening Progression (Vertical) -->
                                            <StackPanel x:Name="PanelEveningProgressionMobile" Orientation="Vertical" Margin="0,0,0,4" Visibility="Collapsed">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtTopoSunsetHeaderMobile" Text="Mountain Sunset" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtTopoSunsetMiniTimeMobile" Grid.Column="1" Text="5:18 PM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtCivilDuskLabelMobile" Text="Civil Dusk (-6°)" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCivilDuskTimeMobile" Grid.Column="1" Text="5:58 PM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtNauticalDuskLabelMobile" Text="Nautical Dusk (-12°)" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtNauticalDuskTimeMobile" Grid.Column="1" Text="6:28 PM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtAstroDuskLabelMobile" Text="Astronomical Dusk (-18°)" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtAstroDuskTimeMobile" Grid.Column="1" Text="6:58 PM" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel x:Name="PanelDesktopTwilightNotes" Orientation="Vertical" Margin="0,4,0,0">
                                                <TextBlock x:Name="TxtTwilightNoteSunrise" Text="• Mountain Sunrise: Direct rays clear ridge at 108° ESE" FontSize="9" Opacity="0.75" TextWrapping="Wrap" />
                                                <TextBlock x:Name="TxtTwilightNoteSunset" Text="• Mountain Sunset: Direct sunlight drops behind ridge at 247° WSW" FontSize="9" Opacity="0.75" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Season & Solstice / Equinox Card -->
                                    <TextBlock x:Name="TxtSectionSeason" Text="🍂 SEASON &amp; SOLSTICE / EQUINOX" FontSize="9.5" FontWeight="Bold" Margin="2,4,0,6" />
                                    <Border x:Name="CardSeason" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                        <StackPanel Orientation="Vertical">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🍂" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtSeasonTitle" Text="Winter Solstice" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border x:Name="BadgeSeason" Grid.Column="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtSeasonBadge" Text="in 43 days" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock x:Name="TxtSeasonDate" Text="Monday, Dec 21, 2026" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock x:Name="TxtSeasonBadgeInline" Text="  •  in 43 days" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSeasonTrend" Text="Days currently decreasing; daylight begins lengthening after this milestone." FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <TextBlock x:Name="TxtDesktopSeasonDesc" Text="Shortest day and longest night of the year; solar arc begins rising northwards afterwards." FontSize="9.5" Opacity="0.8" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. Footer Bar -->
                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnRefresh" Grid.Column="0" Content="↺ Refresh" Click="BtnRefresh_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left"
                            Padding="12,5" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"
                            ToolTipService.ToolTip="Recalculate for current time and coordinates" />

                    <Button x:Name="BtnCancelBottom" Grid.Column="1" Content="✕ Close" Click="BtnClose_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="14,5" FontSize="11" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Close" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

