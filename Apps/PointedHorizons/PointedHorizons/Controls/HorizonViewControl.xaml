<UserControl x:Class="PointedHorizons.Controls.HorizonViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="900">

    <Grid Background="Transparent">
        <!-- Canvas Host Container for PeakFinder Horizon -->
        <Border x:Name="CanvasContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Top Right Quick Toolbar (FOV, Units, Dark Mode) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,80,0"
                Background="#E6FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnFov45" Content="45°" Click="BtnFov45_Click"
                        Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="BtnFov60" Content="60°" Click="BtnFov60_Click"
                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="BtnFov90" Content="90°" Click="BtnFov90_Click"
                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="BtnFov120" Content="120°" Click="BtnFov120_Click"
                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                <Border Width="1" Background="#E2E8F0" Margin="4,2" Height="14" VerticalAlignment="Center"/>

                <!-- Units Toggle -->
                <Button x:Name="BtnToggleUnits" Content="m / ft" Click="BtnToggleUnits_Click"
                        Background="#F1F5F9" Foreground="#0284C7" BorderThickness="0" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                <!-- Dark / Light Theme Toggle -->
                <Button x:Name="BtnToggleTheme" Content="🌓" Click="BtnToggleTheme_Click"
                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Padding="6,3" Margin="2"
                        FontSize="11" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
