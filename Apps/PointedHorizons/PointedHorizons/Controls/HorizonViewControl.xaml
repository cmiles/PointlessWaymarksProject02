<UserControl x:Class="PointedHorizons.Controls.HorizonViewControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              d:DesignHeight="350" d:DesignWidth="900">

    <Grid Background="Transparent">
        <!-- Canvas Host Container for PeakFinder Horizon -->
        <Border x:Name="CanvasContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Top Right Quick Toolbar (FOV, Units, Dark Mode) -->
        <Border x:Name="QuickToolbarBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,80,0"
                BorderThickness="1" CornerRadius="20" Padding="8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnFov45" Content="45°" Click="BtnFov45_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnFov60" Content="60°" Click="BtnFov60_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnFov90" Content="90°" Click="BtnFov90_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />
                <Button x:Name="BtnFov120" Content="120°" Click="BtnFov120_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />

                <Border x:Name="ToolbarDivider" Width="1" Margin="4,2" Height="14" VerticalAlignment="Center"/>

                <!-- Units Toggle -->
                <Button x:Name="BtnToggleUnits" Content="m / ft" Click="BtnToggleUnits_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="7,3" Margin="2"
                        FontSize="11" FontWeight="SemiBold" />

                <!-- Dark / Light Theme Toggle -->
                <Button x:Name="BtnToggleTheme" Content="🌓" Click="BtnToggleTheme_Click"
                        Style="{StaticResource PillButtonStyle}" Padding="6,3" Margin="2"
                        FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
