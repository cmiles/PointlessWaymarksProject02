<UserControl x:Class="PointedHorizons.Controls.CurrentLocationIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Outer pulse ring (translucent sky blue matching map pulse) -->
        <Border x:Name="PulseRing" Width="18" Height="18" CornerRadius="9"
                Background="#380EA5E9" BorderBrush="#800EA5E9" BorderThickness="1.2"
                HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Mid translucent accent ring -->
        <Border x:Name="MidRing" Width="12" Height="12" CornerRadius="6"
                Background="#330284C7"
                HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Center solid blue dot with crisp white border -->
        <Border x:Name="CenterDot" Width="8" Height="8" CornerRadius="4"
                Background="#0284C7" BorderBrush="#FFFFFF" BorderThickness="1.5"
                HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Core white dot -->
        <Border x:Name="CoreDot" Width="2" Height="2" CornerRadius="1"
                Background="#FFFFFF"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>

