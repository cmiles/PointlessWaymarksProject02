<UserControl x:Class="PointedHorizons.Controls.GpsIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Viewbox x:Name="IconViewbox" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Top Communication Mast / Beacon -->
            <Path Data="M 12,6.5 L 12,1.5" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Margin="10.5,0.5,10.5,20.5" Width="3" Height="3" Fill="#FBBF24" Stroke="#0F172A" StrokeThickness="0.6" />

            <!-- Left Solar Wing Boom Truss -->
            <Path Data="M 7.5,12 L 9,12" Stroke="#FFFFFF" StrokeThickness="1.6" />

            <!-- Left Solar Wing (Vibrant High-Contrast Radiant Gold #FBBF24 with crisp dark outline) -->
            <Border Margin="1,6.5,15.5,6.5" Width="7.5" Height="11" CornerRadius="1.2"
                    Background="#FBBF24" BorderBrush="#0F172A" BorderThickness="1">
                <Grid>
                    <!-- Solar Cell Grid Lines (Horizontal & Vertical) -->
                    <Path Data="M 3.75,0 L 3.75,11 M 0,3.6 L 7.5,3.6 M 0,7.3 L 7.5,7.3"
                          Stroke="#92400E" StrokeThickness="0.75" Opacity="0.9" />
                </Grid>
            </Border>

            <!-- Right Solar Wing Boom Truss -->
            <Path Data="M 15,12 L 16.5,12" Stroke="#FFFFFF" StrokeThickness="1.6" />

            <!-- Right Solar Wing (Vibrant High-Contrast Radiant Gold #FBBF24 with crisp dark outline) -->
            <Border Margin="15.5,6.5,1,6.5" Width="7.5" Height="11" CornerRadius="1.2"
                    Background="#FBBF24" BorderBrush="#0F172A" BorderThickness="1">
                <Grid>
                    <!-- Solar Cell Grid Lines (Horizontal & Vertical) -->
                    <Path Data="M 3.75,0 L 3.75,11 M 0,3.6 L 7.5,3.6 M 0,7.3 L 7.5,7.3"
                          Stroke="#92400E" StrokeThickness="0.75" Opacity="0.9" />
                </Grid>
            </Border>

            <!-- Central Satellite Chassis / Bus (Crisp Pure White #FFFFFF with dark outline) -->
            <Border Margin="8.5,7,8.5,7" Width="7" Height="10" CornerRadius="1.5"
                    Background="#FFFFFF" BorderBrush="#0F172A" BorderThickness="1.2">
                <Grid>
                    <!-- Central GPS Optics / Core Navigation Sensor -->
                    <Ellipse Width="4.2" Height="4.2" Fill="#0284C7" Stroke="#0F172A" StrokeThickness="0.8"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="1.8" Height="1.8" Fill="#FBBF24"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Downward Parabolic High-Gain Dish Antenna -->
            <Path Data="M 9.5,17 Q 12,19.8 14.5,17" Stroke="#FFFFFF" StrokeThickness="1.6" Fill="Transparent" />
            <Path Data="M 12,17 L 12,20" Stroke="#FFFFFF" StrokeThickness="1.4" />

            <!-- Downward GPS Signal Broadcast Wave -->
            <Path Data="M 9,21.5 Q 12,23.5 15,21.5" Stroke="#FDE047" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>
    </Viewbox>
</UserControl>

