<UserControl x:Class="PointedHorizons.Controls.FullScreenMapControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              d:DesignHeight="700" d:DesignWidth="1100">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Full-Screen Map Container -->
        <Border x:Name="MapContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Top-Left Floating Controls: Hamburger Menu Button & Coordinates Badge -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0">
            <!-- Hamburger Button -->
            <Button x:Name="BtnHamburger" Content="☰" Click="BtnHamburger_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="10,6" Margin="0,0,10,0"
                    FontSize="16" FontWeight="Bold"
                    ToolTipService.ToolTip="Open Map &amp; GPS Tools Menu" />

            <!-- Pointer Location Badge -->
            <Border x:Name="CoordsBadgeBorder" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtPointerCoords" Text="📍 32.2226°, -110.9747°" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border x:Name="BadgeDivider" Width="1" Margin="8,2" Height="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtGpsIndicator" Text="GPS Ready" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Top-Right Floating Controls: Current Location Button -->
        <Border x:Name="CurrentLocationBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                BorderThickness="1" CornerRadius="20" Padding="4">
            <Button x:Name="BtnCurrentLocation" Content="📍 Current Location" Click="BtnCurrentLocation_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="12,6"
                    FontSize="11" FontWeight="SemiBold"
                    ToolTipService.ToolTip="Center on current GPS position and move pointer (if not tracking)" />
        </Border>

        <!-- Crash Recovery Notification Banner -->
        <Border x:Name="CrashRecoveryNotice" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,14,0,0" CornerRadius="8" BorderThickness="1" Padding="12,6" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtRecoveryMsg" Text="⚠️ Restored unfinished track from previous session" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="BtnViewRecoveredTrack" Content="View Tracks" Click="BtnOpenTracksList_Click"
                        Style="{StaticResource PillButtonStyle}" Margin="8,0,0,0" Padding="8,2" FontSize="10" FontWeight="SemiBold"/>
                <Button x:Name="BtnDismissRecovery" Content="✕" Click="BtnDismissRecovery_Click"
                        Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Padding="6,2" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Floating Hamburger Dropdown Menu Panel -->
        <Border x:Name="HamburgerPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="14,56,0,0" Width="310" Visibility="Collapsed"
                BorderThickness="1" CornerRadius="12" Padding="14,12">
            <StackPanel Orientation="Vertical">
                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtMenuTitle" Text="🛰️ Map &amp; GPS Tools" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button x:Name="BtnCloseMenu" Grid.Column="1" Content="✕" Click="BtnCloseMenu_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="6,2" FontSize="11" />
                </Grid>

                <Border x:Name="MenuDivider1" Height="1" Margin="0,0,0,10" />

                <!-- 1. Live Location Tracking Option -->
                <TextBlock x:Name="TxtSectionTrack" Text="LIVE LOCATION TRACKING" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                <Button x:Name="BtnToggleTracking" Content="🛰️ Track Location: OFF" Click="BtnToggleTracking_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                        Padding="8,6" Margin="0,2,0,4" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtTrackingDetails" Text="Follows GPS location live as you move" FontSize="10" Margin="2,0,0,10" TextWrapping="Wrap" />

                <Border x:Name="MenuDividerPower" Height="1" Margin="0,0,0,10" />

                <!-- 2. Battery & Efficiency Mode Option -->
                <TextBlock x:Name="TxtSectionPower" Text="BATTERY &amp; GPS EFFICIENCY" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                <Button x:Name="BtnToggleBatterySaver" Content="🔋 GPS Power Saver: ON" Click="BtnToggleBatterySaver_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                        Padding="8,6" Margin="0,2,0,4" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtBatterySaverDetails" Text="Enforces satellite GPS fixes with power-efficient throttling (10s / 15m), avoiding cell/Wi-Fi" FontSize="10" Margin="2,0,0,10" TextWrapping="Wrap" />

                <Border x:Name="MenuDivider2" Height="1" Margin="0,0,0,10" />

                <!-- 3. Record Location / Track Option -->
                <TextBlock x:Name="TxtSectionRecord" Text="TRACK RECORDING" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                <Button x:Name="BtnToggleRecording" Content="⏺️ Record Location" Click="BtnToggleRecording_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                        Padding="8,6" Margin="0,2,0,4" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtRecordingStats" Text="Points: 0 | Distance: 0.00 km | 00:00" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6" />

                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <Button x:Name="BtnClearTrack" Content="🗑️ Clear Track" Click="BtnClearTrack_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" />
                    <Button x:Name="BtnExportGpx" Content="💾 Export GPX" Click="BtnExportGpx_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" />
                    <Button x:Name="BtnExportGeoJson" Content="💾 GeoJSON" Click="BtnExportGeoJson_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" FontSize="10" FontWeight="SemiBold" />
                </StackPanel>

                <Border x:Name="MenuDividerTracks" Height="1" Margin="0,0,0,10" />

                <!-- 4. Saved Tracks History Option -->
                <TextBlock x:Name="TxtSectionHistory" Text="SAVED TRACKS HISTORY" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                <Button x:Name="BtnOpenTracksList" Content="📂 View Saved Tracks (0)" Click="BtnOpenTracksList_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                        Padding="8,6" Margin="0,2,0,4" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtTracksSummary" Text="Auto-saves progress; crash resilient" FontSize="10" Margin="2,0,0,10" TextWrapping="Wrap" />

                <Border x:Name="MenuDivider3" Height="1" Margin="0,0,0,10" />

                <!-- 5. Base Map Layer Switcher -->
                <TextBlock x:Name="TxtSectionLayer" Text="BASE MAP LAYER" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <Button x:Name="BtnLayerTopo" Content="Topo" Click="BtnLayerTopo_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold" />
                    <Button x:Name="BtnLayerStreets" Content="Streets" Click="BtnLayerStreets_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold" />
                    <Button x:Name="BtnLayerSatellite" Content="Satellite" Click="BtnLayerSatellite_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,3,0" FontSize="10" FontWeight="SemiBold" />
                    <Button x:Name="BtnLayerPmTiles" Content="PMTiles" Click="BtnLayerPmTiles_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="9,4" FontSize="10" FontWeight="Bold" />
                </StackPanel>

                <Button x:Name="BtnConfigurePmTiles" Content="⚙️ Configure PMTiles..." Click="BtnConfigurePmTiles_Click"
                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                        Padding="8,5" Margin="0,0,0,4" FontSize="10" FontWeight="SemiBold"
                        ToolTipService.ToolTip="Select PMTiles files and configure layers" />
            </StackPanel>
        </Border>

        <!-- Recorded Tracks Modal Dialog Panel -->
        <Border x:Name="TracksOverlayBackdrop" Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MouseLeftButtonDown="BtnCloseTracksList_Click" />
        <Border x:Name="TracksOverlayPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="440" MaxHeight="520" Visibility="Collapsed"
                BorderThickness="1" CornerRadius="12" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTracksTitle" Text="📂 Recorded Tracks" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtTracksCount" Text="" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="BtnCloseTracksList" Grid.Column="1" Content="✕" Click="BtnCloseTracksList_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,3" FontSize="12" />
                </Grid>

                <Border x:Name="TracksDivider" Grid.Row="1" Height="1" Margin="0,0,0,10" />

                <!-- Tracks List ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                    <StackPanel x:Name="TracksListContainer" Orientation="Vertical">
                        <TextBlock x:Name="TxtNoTracks" Text="No recorded tracks yet. Start recording a track using the menu."
                                   FontSize="11" TextWrapping="Wrap" Margin="8,20" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

