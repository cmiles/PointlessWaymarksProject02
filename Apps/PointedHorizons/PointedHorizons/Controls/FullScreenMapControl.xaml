<UserControl x:Class="PointedHorizons.Controls.FullScreenMapControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
              d:DesignHeight="700" d:DesignWidth="1100">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Full-Screen Map Container -->
        <Border x:Name="MapContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Top-Left Floating Controls: Coordinates Badge -->
        <Border x:Name="CoordsBadgeBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,14,0,0"
                BorderThickness="1" CornerRadius="8" Padding="12,6" Opacity="0.88">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtPointerCoords" Text="📍 32.2226°, -110.9747°" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="BadgeDividerElev" Width="1" Margin="8,2" Height="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtPointerElevation" Text="⛰️ --" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="BadgeDivider" Width="1" Margin="8,2" Height="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtGpsIndicator" Text="GPS Ready" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Top Floating Control: Hamburger Menu Button (Left on desktop, Centered on mobile) -->
        <Button x:Name="BtnHamburger" Content="☰" Click="BtnHamburger_Click"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0"
                Style="{StaticResource PillButtonStyle}"
                Padding="10,6" Opacity="0.88"
                FontSize="16" FontWeight="Bold"
                ToolTipService.ToolTip="Open Map &amp; GPS Tools Menu" />

        <!-- Top-Right Floating Controls: Current Location, Track Location, Route Builder, 3D & Reset Buttons -->
        <StackPanel x:Name="TopRightControlsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
            <Button x:Name="BtnCurrentLocation" Content="📍 Current Location" Click="BtnCurrentLocation_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="12,6" Margin="0,0,8,0" Opacity="0.88"
                    FontSize="11" FontWeight="SemiBold"
                    ToolTipService.ToolTip="Center on current GPS position and move pointer (if not tracking)" />

            <Button x:Name="BtnMapTrackLocation" Content="🎯" Click="BtnMapTrackLocation_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="10,6" Margin="0,0,8,0" Opacity="0.88"
                    FontSize="14" FontWeight="Bold"
                    ToolTipService.ToolTip="Toggle Track Location: keep map centered on your moving GPS location" />

            <Button x:Name="BtnDrawRoute" Content="✏️ Draw Route" Click="BtnDrawRoute_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="12,6" Margin="0,0,8,0" Opacity="0.88"
                    FontSize="11" FontWeight="SemiBold"
                    ToolTipService.ToolTip="Draw a custom hiking route with automatic trail snapping" />

            <Button x:Name="BtnToggle3d" Content="🏔️ 3D" Click="BtnToggle3d_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="12,6" Margin="0,0,8,0" Opacity="0.88"
                    FontSize="11" FontWeight="SemiBold"
                    ToolTipService.ToolTip="Toggle 3D terrain perspective view (right-click / Ctrl-drag to orbit)" />

            <Button x:Name="BtnResetView" Content="↺ Reset" Click="BtnResetView_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Padding="10,6" Opacity="0.88"
                    FontSize="11" FontWeight="SemiBold"
                    ToolTipService.ToolTip="Reset camera to flat top-down 2D view and recover if stuck" />
        </StackPanel>

        <!-- Route Builder Floating Control Panel (Active during route drawing) -->
        <Border x:Name="RouteBuilderPanel" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,14,0,0" CornerRadius="10" BorderThickness="1" Padding="12,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✏️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtRouteBuilderTitle" Text="Route Builder" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Snapping Toggle Pill -->
                    <Button x:Name="BtnToggleRouteSnap" Grid.Column="2" Content="🥾 Snap to Trails: ON" Click="BtnToggleRouteSnap_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" FontSize="10.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Toggle snapping path to OpenStreetMap trails vs straight lines" />
                </Grid>

                <!-- Live Distance & Waypoints Stats -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtRouteStats" Text="Click anywhere on the map to start your route"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtRouteStatus" Text="" FontSize="10.5" FontWeight="Bold"
                               Foreground="#8B5CF6" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Actions Row -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRouteUndo" Content="↩️ Undo" Click="BtnRouteUndo_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="0,0,5,0" FontSize="10" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Undo last waypoint" />
                    <Button x:Name="BtnRouteReverse" Content="🔄 Reverse" Click="BtnRouteReverse_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="0,0,5,0" FontSize="10" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Reverse route direction" />
                    <Button x:Name="BtnRouteClear" Content="🗑️ Clear" Click="BtnRouteClear_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="0,0,5,0" FontSize="10" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Clear all points" />
                    <Button x:Name="BtnRouteSave" Content="💾 Save as GPX..." Click="BtnRouteSave_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="9,4" Margin="0,0,5,0" FontSize="10" FontWeight="Bold"
                            ToolTipService.ToolTip="Save this route to your GPX tracks folder" />
                    <Button x:Name="BtnRouteDone" Content="✕ Exit" Click="BtnRouteDone_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,4" FontSize="10" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Exit route builder mode" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Crash Recovery Notification Banner -->
        <Border x:Name="CrashRecoveryNotice" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,14,0,0" CornerRadius="8" BorderThickness="1" Padding="12,6" Visibility="Collapsed" Opacity="0.92">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtRecoveryMsg" Text="⚠️ Restored unfinished track from previous session" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="BtnViewRecoveredTrack" Content="View Tracks" Click="BtnOpenTracksList_Click"
                        Style="{StaticResource PillButtonStyle}" Margin="8,0,0,0" Padding="8,2" FontSize="10" FontWeight="SemiBold"/>
                <Button x:Name="BtnDismissRecovery" Content="✕" Click="BtnDismissRecovery_Click"
                        Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Padding="6,2" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Live Track Recording Floating Bar (along the bottom of the map) -->
        <Border x:Name="LiveRecordingBar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,16" CornerRadius="22" BorderThickness="1" Padding="14,8"
                Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="LiveRecordingBar_Click"
                Opacity="0.90" ToolTipService.ToolTip="Recording Live Track - Click to view track details and elevation profile">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔴" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtLiveRecordingTime" Text="00:00" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                <Border x:Name="LiveRecDivider" Width="1" Margin="8,2" Height="14" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtLiveRecordingDist" Text="0.00 mi" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtLiveRecInfoIcon" Text=" • ℹ️" FontSize="11" Margin="6,0,0,0" Opacity="0.85" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Floating Hamburger Dropdown Menu Panel -->
        <Border x:Name="HamburgerPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="14,56,0,14" Width="472" Visibility="Collapsed"
                BorderThickness="1" CornerRadius="12" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Row: Always-Visible Header (Title & Close Button) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtMenuTitle" Text="🛰️ Map &amp; GPS Tools" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button x:Name="BtnCloseMenu" Grid.Column="1" Content="✕" Click="BtnCloseMenu_Click"
                            Style="{StaticResource PillButtonStyle}" MinHeight="38" MinWidth="38" Padding="6,2" FontSize="14" />
                </Grid>

                <!-- Second Row: Scrollable Menu Body -->
                <ScrollViewer x:Name="HamburgerScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480" Background="Transparent">
                    <StackPanel Orientation="Vertical" Background="Transparent">

                    <!-- Base Map Layer Switcher (Top of Hamburger) -->
                    <TextBlock x:Name="TxtSectionLayer" Text="BASE MAP LAYER" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnLayerTopo" Grid.Column="0" Content="Topo" Click="BtnLayerTopo_Click"
                                Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="0,0,2,0" FontSize="12" FontWeight="Bold" />
                        <Button x:Name="BtnLayerStreets" Grid.Column="1" Content="Streets" Click="BtnLayerStreets_Click"
                                Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="2,0,2,0" FontSize="12" FontWeight="Bold" />
                        <Button x:Name="BtnLayerSatellite" Grid.Column="2" Content="Satellite" Click="BtnLayerSatellite_Click"
                                Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="2,0,2,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="BtnLayerPmTiles" Grid.Column="3" Content="PMTiles" Click="BtnLayerPmTiles_Click"
                                Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="2,0,0,0" FontSize="12" FontWeight="Bold" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnLayerQuads" Grid.Column="0" Content="Quads" Click="BtnLayerQuads_Click"
                                Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="0,0,2,0" FontSize="12" FontWeight="Bold"
                                ToolTipService.ToolTip="Classic Scanned USGS Topo Quads (USA Topo Maps)" />
                        <Button x:Name="BtnLayerOpenTopo" Grid.Column="1" Content="OpenTopo" Click="BtnLayerOpenTopo_Click"
                                Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="2,0,2,0" FontSize="11" FontWeight="Bold"
                                ToolTipService.ToolTip="OpenTopoMap: Global topographic map with contours, hillshade, and trails" />
                        <Button x:Name="BtnLayerHybrid" Grid.Column="2" Content="Hybrid" Click="BtnLayerHybrid_Click"
                                Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="2,0,2,0" FontSize="12" FontWeight="Bold"
                                ToolTipService.ToolTip="Satellite Imagery with Road, Boundary &amp; Place Name Labels" />
                    </Grid>

                    <!-- Public Lands (PAD-US) Transparent Overlay Toggle -->
                    <Button x:Name="BtnTogglePadUs" Content="🌲 Public Lands (PAD-US): OFF" Click="BtnTogglePadUs_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="44" Padding="10,10" Margin="0,0,0,8" FontSize="12" FontWeight="Bold"
                            ToolTipService.ToolTip="Toggle semi-transparent Federal and State Public Lands overlay (BLM, USFS, NPS, State)" />

                    <Button x:Name="BtnConfigurePmTiles" Content="⚙️ Configure PMTiles..." Click="BtnConfigurePmTiles_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,0,0,8" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Select PMTiles files and configure layers" />

                    <Border x:Name="MenuDividerLayers" Height="1" Margin="0,0,0,10" />

                    <!-- Pointer Location & Elevation Info Card (Displayed in menu, selectable text so user can copy) -->
                    <Border x:Name="MenuLocationInfoBorder" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="LOCATION &amp; ELEVATION" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4" Opacity="0.8" />
                            <TextBox x:Name="TxtMenuLocationElevation"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     Margin="0"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Text="32.2226, -110.9747, --" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="MenuDivider1" Height="1" Margin="0,0,0,10" />

                    <!-- Location Search (visible when GeoNames API username is configured) -->
                    <StackPanel x:Name="MenuSearchLocationSection" Orientation="Vertical" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtSectionSearchLocation" Text="LOCATION SEARCH" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                        <Button x:Name="BtnMapSearchLocation" Content="🔍 Search Location (GeoNames)..." Click="BtnMapSearchLocation_Click"
                                Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                                ToolTipService.ToolTip="Search worldwide cities, mountain peaks, and landmarks using GeoNames" />
                        <Border x:Name="MenuDividerSearch" Height="1" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- 1. GPS Receiver & Location Tracking Options -->
                    <TextBlock x:Name="TxtSectionGps" Text="GPS &amp; LOCATION TRACKING" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />

                    <!-- One-time Current Location button moved to hamburger (especially on mobile) -->
                    <Button x:Name="BtnMenuCurrentLocation" Content="📍 Current Location" Click="BtnMenuCurrentLocation_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Center the map on current GPS location once" />

                    <!-- Mark Waypoint button -->
                    <Button x:Name="BtnMarkWaypoint" Content="📌 Mark Waypoint" Click="BtnMarkWaypoint_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Acquire current GPS location and save a waypoint to waypoints.gpx" />

                    <!-- GPS Receiver Toggle (GPS On / GPS Off) -->
                    <Button x:Name="BtnToggleGps" Content="🛰️ GPS: OFF" Click="BtnToggleGps_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Toggle GPS hardware receiver and position tracking" />

                    <!-- Track Location Toggle (Auto-follow on map) -->
                    <Button x:Name="BtnToggleTrackLocation" Content="🎯 Track Location: OFF" Click="BtnToggleTrackLocation_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Automatically keep the map centered on your moving GPS location" />

                    <!-- Record Track Option (Inside GPS & Location Tracking) -->
                    <Button x:Name="BtnToggleRecording" Content="⏺️ Record Track" Click="BtnToggleRecording_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Record GPS breadcrumb trail to track database and GPX storage" />
                    <TextBlock x:Name="TxtRecordingStats" Text="Points: 0 | Distance: 0.00 km | 00:00" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,10" />

                    <Border x:Name="MenuDividerPower" Height="1" Margin="0,0,0,10" />

                    <!-- 2. GPS Recording Interval Setting (Power Saver is always permanently active) -->
                    <TextBlock x:Name="TxtSectionPower" Text="GPS RECORDING INTERVAL" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />

                    <StackPanel x:Name="PanelPowerInterval" Orientation="Vertical" Margin="0,2,0,6">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnInterval15s" Grid.Column="0" Content="15 sec" Click="BtnInterval15s_Click"
                                    Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="1" FontSize="11" FontWeight="Bold" />
                            <Button x:Name="BtnInterval1m" Grid.Column="1" Content="1 min" Click="BtnInterval1m_Click"
                                    Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="1" FontSize="11" FontWeight="Bold" />
                            <Button x:Name="BtnInterval5m" Grid.Column="2" Content="5 min" Click="BtnInterval5m_Click"
                                    Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="1" FontSize="11" FontWeight="Bold" />
                            <Button x:Name="BtnInterval15m" Grid.Column="3" Content="15 min" Click="BtnInterval15m_Click"
                                    Style="{StaticResource PillButtonStyle}" MinHeight="44" Padding="2,10" Margin="1" FontSize="11" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="TxtBatterySaverDetails" Text="Enforces satellite GPS fixes with power-efficient throttling (1 pt / 1 min / 15m delta). Hardware sleeps between fixes." FontSize="10" Margin="2,0,0,10" TextWrapping="Wrap" />

                    <Border x:Name="MenuDividerTracks" Height="1" Margin="0,0,0,10" />

                    <!-- 3. Gpx Files -->
                    <TextBlock x:Name="TxtSectionHistory" Text="GPX FILES" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <Button x:Name="BtnOpenTracksLibrary" Content="📁 Manage Gpx Files..." Click="BtnOpenTracksLibrary_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Browse, show/hide, and zoom to GPX, TCX, and FIT files" />
                    <Button x:Name="BtnMenuDrawRoute" Content="✏️ Draw Route &amp; Snap to Trails..." Click="BtnMenuDrawRoute_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Draw a custom trail route on the map" />
                    <TextBlock x:Name="TxtTracksSummary" Text="Auto-saves progress; crash resilient" FontSize="10" Margin="2,0,0,10" TextWrapping="Wrap" />

                    <Border x:Name="MenuDivider3" Height="1" Margin="0,0,0,10" />

                    <!-- 5. View & Camera Controls -->
                    <TextBlock x:Name="TxtSectionViews" Text="VIEW &amp; AIM CONTROLS" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                    <Button x:Name="BtnMenuSetAimLocation" Content="🎯 Set AIM to Map Location" Click="BtnMenuSetAimLocation_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Set the AIM Map and Horizon viewpoint to the current GPS fix if tracking, map marker if placed, or current map center" />
                    <Button x:Name="BtnMenuToggle3d" Content="🏔️ Toggle 3D Perspective" Click="BtnMenuToggle3d_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,2,0,4" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Toggle 3D terrain perspective view (right-click / Ctrl-drag to orbit)" />
                    <Button x:Name="BtnMenuResetView" Content="↺ Reset Map View" Click="BtnMenuResetView_Click"
                            Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Stretch"
                            MinHeight="48" Padding="10,12" Margin="0,0,0,10" FontSize="12.5" FontWeight="Bold"
                            ToolTipService.ToolTip="Reset camera to flat top-down 2D view and recover if stuck" />
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- Recorded Tracks Modal Dialog Panel -->
        <Border x:Name="TracksOverlayBackdrop" Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MouseLeftButtonDown="BtnCloseTracksList_Click" />
        <Border x:Name="TracksOverlayPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="440" MaxHeight="520" Visibility="Collapsed"
                BorderThickness="1" CornerRadius="12" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTracksTitle" Text="📂 Recorded Tracks" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtTracksCount" Text="" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="BtnCloseTracksList" Grid.Column="1" Content="✕" Click="BtnCloseTracksList_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="8,3" FontSize="12" />
                </Grid>

                <Border x:Name="TracksDivider" Grid.Row="1" Height="1" Margin="0,0,0,10" />

                <!-- Tracks List ScrollViewer -->
                <ScrollViewer x:Name="TracksOverlayScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420" Background="Transparent">
                    <StackPanel x:Name="TracksListContainer" Orientation="Vertical" Background="Transparent">
                        <TextBlock x:Name="TxtNoTracks" Text="No recorded tracks yet. Start recording a track using the menu."
                                   FontSize="11" TextWrapping="Wrap" Margin="8,20" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Save Route Modal Dialog Panel -->
        <Border x:Name="SaveRouteBackdrop" Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MouseLeftButtonDown="BtnCancelSaveRoute_Click" />
        <Border x:Name="SaveRouteDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="380" Visibility="Collapsed" BorderThickness="1" CornerRadius="12" Padding="16,14">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="TxtSaveRouteTitle" Text="💾 Save Route as GPX" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock x:Name="TxtSaveRouteNameLabel" Text="Route Name:" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TxtRouteSaveName" FontSize="11" Padding="6,4" Margin="0,0,0,8" />
                <TextBlock x:Name="TxtRouteSaveDetails" Text="Distance: 0.00 km | 0 points" FontSize="10" Margin="0,0,0,14" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelSaveRoute" Content="Cancel" Click="BtnCancelSaveRoute_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="10,4" Margin="0,0,8,0" FontSize="10.5" />
                    <Button x:Name="BtnConfirmSaveRoute" Content="Save Route" Click="BtnConfirmSaveRoute_Click"
                            Style="{StaticResource PillButtonStyle}" Padding="12,4" FontSize="10.5" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Save Waypoint Modal Dialog Panel -->
        <Border x:Name="SaveWaypointBackdrop" Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" MouseLeftButtonDown="BtnCancelSaveWaypoint_Click" />
        <Border x:Name="SaveWaypointDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="380" Visibility="Collapsed" BorderThickness="1" CornerRadius="12" Padding="16,14">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="📌" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtSaveWaypointTitle" Text="Save Waypoint" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TxtWaypointNameLabel" Text="Waypoint Name:" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TxtWaypointName" FontSize="11" Padding="8,6" Margin="0,0,0,8" />

                <TextBlock x:Name="TxtWaypointDescLabel" Text="Description (optional):" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TxtWaypointDesc" FontSize="11" Padding="8,6" Margin="0,0,0,8" Height="48" AcceptsReturn="True" TextWrapping="Wrap" />

                <TextBlock x:Name="TxtWaypointLocationLabel" Text="Coordinates (Lat, Long):" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TxtWaypointCoordinates" FontSize="11" Padding="8,6" Margin="0,0,0,8" />

                <TextBlock x:Name="TxtWaypointDetails" Text="Elevation: -- | Source: GPS" FontSize="10" Margin="0,0,0,14" Opacity="0.8" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelSaveWaypoint" Content="Cancel" Click="BtnCancelSaveWaypoint_Click"
                            Style="{StaticResource PillButtonStyle}" MinHeight="40" Padding="12,6" Margin="0,0,8,0" FontSize="11" />
                    <Button x:Name="BtnConfirmSaveWaypoint" Content="Save Waypoint" Click="BtnConfirmSaveWaypoint_Click"
                            Style="{StaticResource PillButtonStyle}" MinHeight="40" Padding="14,6" FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

