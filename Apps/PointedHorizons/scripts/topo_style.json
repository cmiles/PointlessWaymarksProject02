          "parking"
        ],
        [
          "==",
          [
            "get",
            "kind_detail"
          ],
          "parking"
        ]
      ],
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9.5,
          5.5,
          12,
          8.5
        ],
        "circle-color": "#1976d2",
        "circle-stroke-width": 1.5,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "parking-badge-text",
