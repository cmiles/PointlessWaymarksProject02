{
  "version": 8,
  "name": "Universal Topo & Hiking 3D",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "base": {
      "type": "vector",
      "url": "pmtiles://basemap.pmtiles"
    },
    "hillshade": {
      "type": "raster",
      "url": "pmtiles://hillshade.pmtiles",
      "tileSize": 256
    },
    "contours": {
      "type": "vector",
      "url": "pmtiles://contours.pmtiles"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "pmtiles://terrain_rgb.pmtiles",
      "tileSize": 256,
      "encoding": "mapbox"
    }
  },
  "terrain": {
    "source": "terrain",
    "exaggeration": 1.25
  },
  "layers": [
    {
      "id": "sky",
      "type": "sky",
      "paint": {
        "sky-color": "#88c6fc",
        "horizon-color": "#f5f2eb"
      }
    },
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f2eb"
      }
    },
    {
      "id": "terrain-hillshade",
      "type": "raster",
      "source": "hillshade",
      "paint": {
        "raster-opacity": 0.45
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "base",
      "source-layer": "landcover",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "wood",
              "forest"
            ]
          ]
        ]
      ],
      "paint": {
        "fill-color": "#cde5cb",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "landcover-scrub",
      "type": "fill",
      "source": "base",
      "source-layer": "landcover",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "scrub",
              "grass"
            ]
          ]
        ]
      ],
      "paint": {
        "fill-color": "#e8edd6",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "landuse-parks",
      "type": "fill",
      "source": "base",
      "source-layer": "landuse",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "park",
              "nature_reserve",
              "national_park",
              "protected_area",
              "recreation_ground",
              "wilderness"
            ]
          ]
        ]
      ],
      "paint": {
        "fill-color": "#c8e6c9",
        "fill-opacity": 0.35
      }
    },
    {
      "id": "landuse-parks-border",
      "type": "line",
      "source": "base",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "nature_reserve",
            "national_park",
            "protected_area",
            "recreation_ground",
            "wilderness"
          ]
        ]
      ],
      "paint": {
        "line-color": "#2e7d32",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.0,
          12,
          1.8,
          15,
          2.6
        ],
        "line-dasharray": [
          4,
          2
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "parking-areas",
      "type": "fill",
      "source": "base",
      "source-layer": "landuse",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "parking"
      ],
      "paint": {
        "fill-color": "#dedad0",
        "fill-outline-color": "#8c877a",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "water-areas",
      "type": "fill",
      "source": "base",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#9ec7e8",
        "fill-outline-color": "#7eaed6"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "base",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#7eaed6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.8,
          14,
          2.0
        ]
      }
    },
    {
      "id": "contour-lines-standard",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 11,
      "filter": [
        "!=",
        [
          "%",
          [
            "round",
            [
              "/",
              [
                "get",
                "ele"
              ],
              12.192
            ]
          ],
          5
        ],
        0
      ],
      "paint": {
        "line-color": "#b59b7c",
        "line-width": 0.65,
        "line-opacity": 0.75
      }
    },
    {
      "id": "contour-lines-index",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 10,
      "filter": [
        "==",
        [
          "%",
          [
            "round",
            [
              "/",
              [
                "get",
                "ele"
              ],
              12.192
            ]
          ],
          5
        ],
        0
      ],
      "paint": {
        "line-color": "#7d5836",
        "line-width": 1.4,
        "line-opacity": 0.9
      }
    },
    {
      "id": "roads-minor-casing",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "minor_road",
            "medium_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#d0cbc2",
        "line-width": 2.5
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "minor_road",
            "medium_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": 1.5
      }
    },
    {
      "id": "roads-major-casing",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "highway",
            "major_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#b8b2a5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          2.0,
          14,
          5.0
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "highway",
            "major_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#ffe082",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          1.2,
          14,
          3.5
        ]
      }
    },
    {
      "id": "tracks-and-unpaved",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": [
        "==",
        [
          "get",
          "kind_detail"
        ],
        "track"
      ],
      "paint": {
        "line-color": "#8d6e63",
        "line-width": 1.4,
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "trails-and-paths",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "path"
        ],
        [
          "in",
          [
            "get",
            "kind_detail"
          ],
          [
            "literal",
            [
              "path",
              "footway",
              "trail",
              "bridleway",
              "cycleway",
              "steps"
            ]
          ]
        ]
      ],
      "paint": {
        "line-color": "#c62828",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.4,
          14,
          2.4
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "base",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#8e8e8e",
        "line-width": 1.0,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "contour-labels",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "%",
          [
            "round",
            [
              "/",
              [
                "get",
                "ele"
              ],
              12.192
            ]
          ],
          5
        ],
        0
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "round",
              [
                "*",
                [
                  "get",
                  "ele"
                ],
                3.28084
              ]
            ]
          ],
          "'"
        ],
        "text-size": 10,
        "text-font": [
          "Noto Sans Regular"
        ],
        "symbol-spacing": 350
      },
      "paint": {
        "text-color": "#5c3d1e",
        "text-halo-color": "rgba(255, 255, 255, 0.9)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "peaks-poi",
      "type": "symbol",
      "source": "base",
      "source-layer": "pois",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "peak"
      ],
      "layout": {
        "text-field": [
          "case",
          [
            "has",
            "elevation"
          ],
          [
            "concat",
            "\u25b2 ",
            [
              "get",
              "name"
            ],
            " (",
            [
              "to-string",
              [
                "round",
                [
                  "*",
                  [
                    "get",
                    "elevation"
                  ],
                  3.28084
                ]
              ]
            ],
            "')"
          ],
          [
            "concat",
            "\u25b2 ",
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-size": 11,
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-anchor": "bottom",
        "text-offset": [
          0,
          -0.5
        ]
      },
      "paint": {
        "text-color": "#4e342e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "parking-pois",
      "type": "symbol",
      "source": "base",
      "source-layer": "pois",
      "minzoom": 13,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "parking"
      ],
      "layout": {
        "text-field": "P",
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": 11,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#1565c0",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.0
      }
    },
    {
      "id": "parks-labels-poi",
      "type": "symbol",
      "source": "base",
      "source-layer": "pois",
      "minzoom": 9,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "nature_reserve",
            "national_park",
            "wilderness",
            "protected_area",
            "recreation_ground"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          10.5,
          13,
          13.5,
          16,
          16
        ],
        "text-letter-spacing": 0.08,
        "text-transform": "uppercase",
        "text-max-width": 12,
        "symbol-placement": "point"
      },
      "paint": {
        "text-color": "#2e7d32",
        "text-halo-color": "rgba(255, 255, 255, 0.95)",
        "text-halo-width": 2.0
      }
    },
    {
      "id": "parks-labels-landuse",
      "type": "symbol",
      "source": "base",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "park",
              "nature_reserve",
              "national_park",
              "wilderness",
              "protected_area",
              "recreation_ground"
            ]
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          11,
          14,
          14.5
        ],
        "text-letter-spacing": 0.08,
        "text-transform": "uppercase",
        "text-max-width": 12
      },
      "paint": {
        "text-color": "#2e7d32",
        "text-halo-color": "rgba(255, 255, 255, 0.95)",
        "text-halo-width": 2.0
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "places",
      "minzoom": 7,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          [
            "case",
            [
              "==",
              [
                "get",
                "kind_detail"
              ],
              "city"
            ],
            14,
            10
          ],
          12,
          [
            "case",
            [
              "==",
              [
                "get",
                "kind_detail"
              ],
              "city"
            ],
            20,
            14
          ]
        ]
      },
      "paint": {
        "text-color": "#263238",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}