      "source-layer": "pois",
      "minzoom": 8.5,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "trailhead"
        ],
        [
          "==",
          [
            "get",
            "kind_detail"
          ],
          "trailhead"
        ],
        [
          "all",
          [
            "==",
            [
              "get",
              "kind"
            ],
            "information"
          ],
          [
            "in",
            [
