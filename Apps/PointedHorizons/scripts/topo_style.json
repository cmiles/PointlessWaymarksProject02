      "minzoom": 9.5,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "parking"
        ],
        [
          "==",
          [
            "get",
            "kind_detail"
          ],
          "parking"
        ]
      ],
      "layout": {
        "text-field": "P",
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9.5,
          7.0,
          12,
          10.0
        ],
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#ffffff"
      }
    },
    {
      "id": "trailhead-badge-circle",
      "type": "circle",
      "source": "base",
      "source-layer": "pois",
      "minzoom": 8.5,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "trailhead"
        ],
        [
          "==",
          [
            "get",
            "kind_detail"
          ],
          "trailhead"
        ],
        [
          "all",
          [
            "==",
            [
              "get",
              "kind"
            ],
            "information"
          ],
          [
            "in",
            [
              "get",
              "kind_detail"
            ],
            [
              "literal",
              [
                "trailhead",
                "guidepost"
              ]
            ]
          ]
        ]
      ],
      "paint": {
        "circle-radius": [
