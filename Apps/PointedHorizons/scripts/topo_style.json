    },
    {
      "id": "trailhead-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "pois",
      "minzoom": 10.5,
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "any",
          [
            "==",
            [
              "get",
              "kind"
            ],
            "trailhead"
          ],
          [
            "==",
            [
              "get",
              "kind_detail"
            ],
            "trailhead"
          ],
          [
            "all",
            [
              "==",
              [
                "get",
                "kind"
              ],
                "information"
            ],
            [
              "in",
              [
                "get",
                "kind_detail"
              ],
              [
                "literal",
                [
                  "trailhead",
                  "guidepost"
                ]
              ]
            ]
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
