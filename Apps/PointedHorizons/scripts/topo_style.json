{
  "version": 8,
  "name": "Universal Topo & Hiking 3D",
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "base": {
      "type": "vector",
      "url": "pmtiles://basemap.pmtiles"
    },
    "hillshade": {
      "type": "raster",
      "url": "pmtiles://hillshade.pmtiles",
      "tileSize": 256
    },
    "contours": {
      "type": "vector",
      "url": "pmtiles://contours.pmtiles"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "pmtiles://terrain_rgb.pmtiles",
      "tileSize": 256,
      "encoding": "mapbox"
    }
  },
  "terrain": {
    "source": "terrain",
    "exaggeration": 1.25
  },
  "layers": [
    {
      "id": "sky",
      "type": "sky",
      "paint": {
        "sky-color": "#88c6fc",
        "horizon-color": "#f5f2eb"
      }
    },
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f2eb"
      }
    },
    {
      "id": "terrain-hillshade",
      "type": "raster",
      "source": "hillshade",
      "paint": {
        "raster-opacity": 0.45
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "base",
      "source-layer": "landcover",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "wood",
              "forest"
            ]
          ]
        ]
      ],
      "paint": {
        "fill-color": "#cde5cb",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "landcover-scrub",
      "type": "fill",
      "source": "base",
      "source-layer": "landcover",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "scrub",
              "grass"
            ]
          ]
        ]
      ],
      "paint": {
        "fill-color": "#e8edd6",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "landuse-parks",
      "type": "fill",
      "source": "base",
      "source-layer": "landuse",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ],
        [
          "in",
          [
            "get",
            "kind"
          ],
          [
            "literal",
            [
              "park",
              "nature_reserve",
              "national_park",
              "protected_area",
              "recreation_ground",
              "wilderness"
            ]
          ]
        ]
      ],
      "paint": {
        "fill-color": "#c8e6c9",
        "fill-opacity": 0.35
      }
    },
    {
      "id": "landuse-parks-border",
      "type": "line",
      "source": "base",
      "source-layer": "landuse",
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "park",
            "nature_reserve",
            "national_park",
            "protected_area",
            "recreation_ground",
            "wilderness"
          ]
        ]
      ],
      "paint": {
        "line-color": "#2e7d32",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          1.0,
          12,
          1.8,
          15,
          2.6
        ],
        "line-dasharray": [
          4,
          2
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "parking-areas",
      "type": "fill",
      "source": "base",
      "source-layer": "landuse",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "parking"
      ],
      "paint": {
        "fill-color": "#dedad0",
        "fill-outline-color": "#8c877a",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "water-areas",
      "type": "fill",
      "source": "base",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#9ec7e8",
        "fill-outline-color": "#7eaed6"
      }
    },
    {
      "id": "water-lines-intermittent",
      "type": "line",
      "source": "base",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "any",
          [
            "==",
            [
              "get",
              "intermittent"
            ],
            "yes"
          ],
          [
            "==",
            [
              "get",
              "intermittent"
            ],
            1
          ],
          [
            "==",
            [
              "get",
              "intermittent"
            ],
            true
          ]
        ]
      ],
      "paint": {
        "line-color": "#81b9e8",
        "line-dasharray": [
          3,
          2.5
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.7,
          14,
          1.8
        ]
      }
    },
    {
      "id": "water-lines-perennial",
      "type": "line",
      "source": "base",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "!=",
          [
            "get",
            "intermittent"
          ],
          "yes"
        ],
        [
          "!=",
          [
            "get",
            "intermittent"
          ],
          1
        ],
        [
          "!=",
          [
            "get",
            "intermittent"
          ],
          true
        ]
      ],
      "paint": {
        "line-color": "#5297d1",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.9,
          14,
          2.2
        ]
      }
    },
    {
      "id": "contour-lines-standard",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 10.5,
      "filter": [
        "!=",
        [
          "%",
          [
            "round",
            [
              "/",
              [
                "get",
                "ele"
              ],
              12.192
            ]
          ],
          5
        ],
        0
      ],
      "paint": {
        "line-color": "#b59b7c",
        "line-width": 0.65,
        "line-opacity": 0.75
      }
    },
    {
      "id": "contour-lines-index",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "%",
          [
            "round",
            [
              "/",
              [
                "get",
                "ele"
              ],
              12.192
            ]
          ],
          5
        ],
        0
      ],
      "paint": {
        "line-color": "#7d5836",
        "line-width": 1.4,
        "line-opacity": 0.9
      }
    },
    {
      "id": "roads-minor-casing",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 9.5,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "minor_road",
            "medium_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#d0cbc2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9.5,
          1.2,
          14,
          2.5
        ]
      }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 9.5,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "minor_road",
            "medium_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9.5,
          0.8,
          14,
          1.6
        ]
      }
    },
    {
      "id": "roads-major-casing",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "highway",
            "major_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#b8b2a5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          2.0,
          14,
          5.0
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": [
        "in",
        [
          "get",
          "kind"
        ],
        [
          "literal",
          [
            "highway",
            "major_road"
          ]
        ]
      ],
      "paint": {
        "line-color": "#ffe082",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          1.2,
          14,
          3.5
        ]
      }
    },
    {
      "id": "tracks-and-unpaved",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 8.5,
      "filter": [
        "==",
        [
          "get",
          "kind_detail"
        ],
        "track"
      ],
      "paint": {
        "line-color": "#795548",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8.5,
          0.8,
          11,
          1.4,
          14,
          2.2
        ],
        "line-dasharray": [
          6,
          3
        ]
      }
    },
    {
      "id": "trails-and-paths-unofficial",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "kind_detail"
          ],
          "track"
        ],
        [
          "any",
          [
            "==",
            [
              "get",
              "informal"
            ],
            "yes"
          ],
          [
            "in",
            [
              "get",
              "trail_visibility"
            ],
            [
              "literal",
              [
                "bad",
                "horrible",
                "no"
              ]
            ]
          ]
        ]
      ],
      "paint": {
        "line-color": "#a8a29e",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          14,
          1.3
        ],
        "line-dasharray": [
          1.5,
          2.5
        ]
      }
    },
    {
      "id": "trails-and-paths",
      "type": "line",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 8.5,
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "kind_detail"
          ],
          "track"
        ],
        [
          "!=",
          [
            "get",
            "informal"
          ],
          "yes"
        ],
        [
          "any",
          [
            "in",
            [
              "get",
              "kind_detail"
            ],
            [
              "literal",
              [
                "path",
                "footway",
                "trail",
                "bridleway",
                "cycleway",
                "steps"
              ]
            ]
          ],
          [
            "==",
            [
              "get",
              "kind"
            ],
            "path"
          ]
        ]
      ],
      "paint": {
        "line-color": "#c62828",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8.5,
          0.9,
          11,
          1.5,
          14,
          2.4
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "trail-labels",
      "type": "symbol",
      "source": "base",
      "source-layer": "roads",
      "minzoom": 11,
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "!=",
          [
            "get",
            "kind_detail"
          ],
          "track"
        ],
        [
          "in",
          [
            "get",
            "kind_detail"
          ],
          [
            "literal",
            [
              "path",
              "footway",
              "trail",
              "bridleway",
              "cycleway"
            ]
          ]
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          9,
          14,
          11
        ],
        "text-letter-spacing": 0.05,
        "symbol-spacing": 300
      },
      "paint": {
        "text-color": "#b71c1c",
        "text-halo-color": "rgba(255, 255, 255, 0.95)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "base",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#8e8e8e",
        "line-width": 1.0,
        "line-dasharray": [
          3,
          3
        ]
      }
    },
    {
      "id": "contour-labels",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contours",
      "minzoom": 11,
      "filter": [
        "==",
        [
          "%",
          [
            "round",
            [
              "/",
              [
                "get",
                "ele"
              ],
              12.192
            ]
          ],
          5
        ],
        0
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "concat",
          [
            "to-string",
            [
              "round",
              [
                "*",
                [
                  "get",
                  "ele"
                ],
                3.28084
              ]
            ]
          ],
          "'"
        ],
        "text-size": 10,
        "text-font": [
          "Noto Sans Regular"
        ],
        "symbol-spacing": 350
      },
      "paint": {
        "text-color": "#5c3d1e",
        "text-halo-color": "rgba(255, 255, 255, 0.9)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "peaks-poi",
      "type": "symbol",
      "source": "base",
      "source-layer": "pois",
      "minzoom": 8,
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "peak"
      ],
      "layout": {
        "text-field": [
          "case",
          [
            "has",
            "elevation"
          ],
          [
            "concat",
            "\u25b2 ",
            [
              "get",
              "name"
            ],
            " (",
            [
              "to-string",
              [
                "round",
                [
                  "*",
                  [
                    "get",
                    "elevation"
                  ],
                  3.28084
                ]
              ]
            ],
            "')"
          ],
          [
            "concat",
            "\u25b2 ",
            [
              "get",
              "name"
            ]
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          9,
          11,
          11,
          14,
          13
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-anchor": "bottom",
        "text-offset": [
          0,
          -0.5
        ],
        "text-optional": true
      },
      "paint": {
        "text-color": "#4e342e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "parking-badge-circle",
      "type": "circle",
      "source": "base",
      "source-layer": "pois",
      "minzoom": 9.5,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
