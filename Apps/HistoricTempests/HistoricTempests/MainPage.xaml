                                                <TextBlock Grid.Column="2" Text="{Binding TempLowF, StringFormat='{}{0:F1}°F'}" FontSize="12" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding PrecipInches, StringFormat='{}{0:F2} in'}" FontSize="12" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding WindGustMph, StringFormat='{}{0:F1} mph'}" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding SolarRadiationAvg, StringFormat='{}{0:F0}'}" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding UvAvg, StringFormat='{}{0:F1}'}" FontSize="12" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Text="{Binding LightningStrikes, StringFormat='{}{0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== TAB 7: ABOUT ==================== -->
                <StackPanel x:Name="ViewAbout" Visibility="Collapsed">
                    <controls:AboutControl />
                </StackPanel>

            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
