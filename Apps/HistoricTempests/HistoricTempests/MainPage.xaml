                                                <TextBlock Grid.Column="2" Text="Peak Gust" FontWeight="Bold" Foreground="#A5B4FC" FontSize="{Binding Theme.FontSizeSmall}" HorizontalAlignment="Right" TextWrapping="Wrap" />
