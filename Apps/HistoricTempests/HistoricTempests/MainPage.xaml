                    <!-- Top 10 All-Time Weather Rankings Section -->
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18,20,18" Margin="0,0,0,20">
