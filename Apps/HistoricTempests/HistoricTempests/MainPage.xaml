<Page x:Class="HistoricTempests.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:HistoricTempests.Controls"
      Foreground="#0F172A">

    <Page.Resources>
        <Style x:Key="TabNavButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="DailyRowDividerBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="DailyDateFgBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="DailyMutedFgBrush" Color="#475569" />

        <SolidColorBrush x:Key="StreakItemBgBrush" Color="White" />
        <SolidColorBrush x:Key="StreakItemBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="StreakDateFgBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="StreakDetailsFgBrush" Color="#64748B" />

        <SolidColorBrush x:Key="DryStreakTitleBrush" Color="#B45309" />
        <SolidColorBrush x:Key="DryStreakBadgeBgBrush" Color="#FEF3C7" />
        <SolidColorBrush x:Key="DryStreakBadgeBorderBrush" Color="#FDE68A" />
        <SolidColorBrush x:Key="DryStreakBadgeFgBrush" Color="#B45309" />

        <SolidColorBrush x:Key="WetStreakTitleBrush" Color="#0369A1" />
        <SolidColorBrush x:Key="WetStreakBadgeBgBrush" Color="#E0F2FE" />
        <SolidColorBrush x:Key="WetStreakBadgeBorderBrush" Color="#BAE6FD" />
        <SolidColorBrush x:Key="WetStreakBadgeFgBrush" Color="#0284C7" />
    </Page.Resources>

    <Grid x:Name="MainRootGrid" Background="{Binding Theme.PageBackground}">
        <ScrollViewer x:Name="MainPageScrollViewer" Background="{Binding Theme.PageBackground}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="LayoutRoot" MaxWidth="1200" HorizontalAlignment="Stretch" Margin="16,20,16,40">
                <StackPanel x:Name="MainContainer" HorizontalAlignment="Stretch">

                <!-- 1. HEADER BAR -->
                <Border x:Name="HeaderBarBorder" Background="{Binding Theme.HeaderBackground}" BorderBrush="{Binding Theme.HeaderBorder}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Desktop / Wide Top Bar -->
                        <controls:WrapPanel x:Name="WideHeaderPanel" Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,8">
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtAppTitle" Text="Rincon Valley Weather" FontSize="26" FontWeight="Bold" Foreground="{Binding Theme.HeaderTitle}" VerticalAlignment="Bottom" Margin="0,0,6,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtAuthorDash" Text="- " FontSize="16" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderSubtitle}" VerticalAlignment="Bottom" Margin="0,0,2,3" />
                                    <HyperlinkButton x:Name="LnkAuthor" Content="Charles Miles" NavigateUri="https://cmiles.info" TargetName="_blank" Click="AuthorLink_Click"
                                                     FontSize="16" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderAccent}"
                                                     Padding="0" Margin="0,0,0,3" Cursor="Hand" VerticalAlignment="Bottom" />
                                </controls:WrapPanel>
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAppSubtitle" Text="WeatherFlow Tempest Data" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderSubtitle}" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock x:Name="TxtHeaderBullet1" Text="•" FontSize="13" Foreground="{Binding Theme.HeaderBullet}" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock x:Name="TxtLastDataLabel" Text="Last Data: " FontSize="13" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtLastDataDate" Text="{Binding LastDataDateText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderAccent}" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock x:Name="TxtHeaderBullet2" Text="•" FontSize="13" Foreground="{Binding Theme.HeaderBullet}" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock x:Name="TxtArchiveDaysLabel" Text="Archive Days: " FontSize="13" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <TextBlock x:Name="TxtArchiveDays" Text="{Binding ArchiveDaysText}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderAccent}" VerticalAlignment="Center" Margin="0,0,0,2" />
                                </controls:WrapPanel>
                            </StackPanel>

                            <!-- Header Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <!-- Theme Toggle Button -->
                                <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" Style="{StaticResource TabNavButtonStyle}"
                                        Width="145" HorizontalContentAlignment="Center"
                                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                        Foreground="White" FontWeight="SemiBold" FontSize="12"
                                        Padding="8,8" Margin="0,0,10,0" Cursor="Hand"
                                        ToolTipService.ToolTip="Cycle theme: System (Auto) -> Dark -> Light">
                                    <TextBlock x:Name="TxtThemeToggle" Text="🌓 Theme" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>

                                <!-- Updates Button -->
                                <Button x:Name="BtnUpdates" Command="{Binding CheckForUpdatesManualCommand}" Click="BtnUpdates_Click" Style="{StaticResource TabNavButtonStyle}"
                                        Background="#059669" BorderBrush="#047857" BorderThickness="1"
                                        Foreground="White" FontWeight="SemiBold" FontSize="12"
                                        Padding="12,8" Margin="0,0,10,0" Cursor="Hand"
                                        ToolTipService.ToolTip="Check online catalog for software updates">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀 " FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Updates" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Refresh Button -->
                                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Style="{StaticResource TabNavButtonStyle}"
                                        Background="#2563EB" BorderBrush="#1D4ED8" BorderThickness="1"
                                        Foreground="White" FontWeight="SemiBold" FontSize="12"
                                        Padding="16,8,16,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↻ " FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:WrapPanel>

                        <!-- Mobile / Small Screen Collapsed Top Bar -->
                        <StackPanel x:Name="MobileHeaderPanel" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtAppTitleMobile" Grid.Column="0" Text="Rincon Valley Weather" FontSize="20" FontWeight="Bold" Foreground="{Binding Theme.HeaderTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button x:Name="BtnHamburger" Grid.Column="1" Click="BtnHamburger_Click" Style="{StaticResource TabNavButtonStyle}"
                                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                        Foreground="White" FontWeight="Bold" FontSize="16"
                                        Padding="10,6" Margin="8,0,0,0" Cursor="Hand"
                                        ToolTipService.ToolTip="Menu">
                                    <TextBlock Text="☰" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!-- Hamburger Dropdown Menu ("everything else") -->
                            <Border x:Name="MobileMenuDropdown" Background="{Binding Theme.CardBackground}" BorderBrush="{Binding Theme.CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Author Link -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="By " FontSize="13" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                        <HyperlinkButton x:Name="LnkAuthorMobile" Content="Charles Miles" NavigateUri="https://cmiles.info" TargetName="_blank" Click="AuthorLink_Click"
                                                         FontSize="13" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderAccent}"
                                                         Padding="0" Cursor="Hand" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Subtitle -->
                                    <TextBlock x:Name="TxtAppSubtitleMobile" Text="WeatherFlow Tempest Data" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderSubtitle}" Margin="0,0,0,4" />

                                    <!-- Last Data & Archive Days -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Last Data: " FontSize="12" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastDataDateText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderAccent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Archive Days: " FontSize="12" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ArchiveDaysText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Theme.HeaderAccent}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <controls:WrapPanel Orientation="Horizontal">
                                        <Button x:Name="BtnThemeToggleMobile" Click="BtnThemeToggle_Click" Style="{StaticResource TabNavButtonStyle}"
                                                Width="145" HorizontalContentAlignment="Center"
                                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                Padding="8,8" Margin="0,0,10,6" Cursor="Hand">
                                            <TextBlock x:Name="TxtThemeToggleMobile" Text="🌓 Theme" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                        <Button x:Name="BtnRefreshMobile" Click="BtnRefresh_Click" Style="{StaticResource TabNavButtonStyle}"
                                                Background="#2563EB" BorderBrush="#1D4ED8" BorderThickness="1"
                                                Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                Padding="16,8,16,8" Margin="0,0,0,6" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↻ " FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Loading / Error Alert Banner -->
                <Border x:Name="ErrorBanner" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- 2. NAVIGATION TAB BAR -->
                <Border x:Name="NavBarBorder" Background="{Binding Theme.CardBackground}" BorderBrush="{Binding Theme.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,16">
                    <controls:WrapPanel Orientation="Horizontal">
                        <Button x:Name="TabBtn14Days" Content="14 Days" Click="TabBtn_Click" Tag="Timeline14Days" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="Bold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtn6Month" Content="6 Months" Click="TabBtn_Click" Tag="Timeline6Month" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtn12Month" Content="12 Months" Click="TabBtn_Click" Tag="Timeline12Month" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnRainDays" Content="🌧 Rain Days" Click="TabBtn_Click" Tag="RainDays" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnOverview" Content="📊 Records" Click="TabBtn_Click" Tag="Overview" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnDaily" Content="🗄 Daily History" Click="TabBtn_Click" Tag="Daily" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnAbout" Content="ℹ️ About" Click="TabBtn_Click" Tag="About" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    </controls:WrapPanel>
                </Border>

                <!-- 3. TAB CONTENT CONTAINERS -->

                <!-- ==================== TAB 1: 14 DAYS (DEFAULT FIRST PAGE) ==================== -->
                <StackPanel x:Name="ViewTimeline14Days">
                    <!-- Top Executive Glance Summary Block -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,16">
                        <controls:WrapPanel Orientation="Horizontal">
                            <!-- Rain -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,5,8,5" Margin="0,0,6,4" VerticalAlignment="Center">
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌧 Rain: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glance14DayRainDaysText}" Foreground="{Binding Glance14DayRainDaysBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Glance14DayRainAmountText}" Foreground="{Binding Glance14DayRainAmountBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </controls:WrapPanel>
                            </Border>

                            <!-- Temperature -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,5,8,5" Margin="0,0,6,4" VerticalAlignment="Center">
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌡 Temp: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Max " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Glance14DayTempMaxText}" Foreground="{Binding Glance14DayTempMaxBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Min " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Glance14DayTempMinText}" Foreground="{Binding Glance14DayTempMinBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Glance14DayTempAvgText}" Foreground="{Binding Glance14DayTempAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </controls:WrapPanel>
                            </Border>

                            <!-- Wind -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,5,8,5" Margin="0,0,6,4" VerticalAlignment="Center">
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💨 Wind: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Glance14DayWindAvgText}" Foreground="{Binding Glance14DayWindAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Glance14DayWindPeakText}" Foreground="#475569" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </controls:WrapPanel>
                            </Border>

                            <!-- Lightning -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,5,8,5" Margin="0,0,6,4" VerticalAlignment="Center">
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Lightning: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glance14DayLightningStrikesText}" Foreground="{Binding Glance14DayLightningStrikesBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Glance14DayLightningDaysText}" Foreground="{Binding Glance14DayLightningDaysBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </controls:WrapPanel>
                            </Border>

                            <!-- Sun / Amount of Sun -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,5,8,5" Margin="0,0,0,4" VerticalAlignment="Center">
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☀️ Sun: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DaySolarAvgText}" Foreground="{Binding Glance14DaySolarAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </controls:WrapPanel>
                            </Border>
                        </controls:WrapPanel>
                    </Border>

                    <!-- 1. Average Temp Graph: 14 Days Forward / 14 Back (Fahrenheit) - TOP -->
                    <controls:MultiYearTimelineLineChart x:Name="Chart14DayTempAvg" Title="Average Daily Temperature" Mode="AverageTemperature" ShowFutureShading="True" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,20">
                        <controls:WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SixMonthAvgTempThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthAvgTempDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthAvgTempDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                        </controls:WrapPanel>
                    </Border>

                    <!-- 2. Temperature graph: Max High & Min Low (Fahrenheit) -->
                    <controls:MultiYearTimelineLineChart x:Name="Chart14DayTempDual" Title="Daily Temperature Range (Max High &amp; Min Low)" Mode="TemperatureDual" ShowFutureShading="True" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,20">
                        <controls:WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SixMonthAvgHighThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthAvgHighDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthAvgHighDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding SixMonthAvgLowThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthAvgLowDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthAvgLowDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                        </controls:WrapPanel>
                    </Border>

                    <!-- 3. Peak Daily Wind Gust Graph: 14 Days Forward / 14 Back (Line Chart) -->
                    <controls:MultiYearTimelineLineChart x:Name="Chart14DayWind" Title="Peak Daily Wind Gust" Mode="WindGust" ShowFutureShading="True" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,20">
                        <controls:WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SixMonthWindThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthWindDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthWindDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding SixMonthWindPeakText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthWindPeakDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthWindPeakDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                        </controls:WrapPanel>
                    </Border>

                    <!-- 4. Combined Precipitation & Lightning Grid: Days on X-axis, Years on Y-axis -->
                    <controls:MultiYearDayHeatmapGrid x:Name="Chart14DayCombined" Title="Daily Precipitation &amp; Lightning Grid" Metric="Combined" ShowFutureShading="True" Height="450" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12,14,12" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Precipitation Summary -->
                            <controls:WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding SixMonthRainThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SixMonthRainDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthRainDeltaBrush}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding SixMonthRainDaysText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SixMonthRainDaysDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthRainDaysDeltaBrush}" TextWrapping="Wrap" />
                                </Border>
                            </controls:WrapPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="#E2E8F0" Margin="0,6,0,10" />

                            <!-- Lightning Summary -->
                            <controls:WrapPanel Orientation="Horizontal">
