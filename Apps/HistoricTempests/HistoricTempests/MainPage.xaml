                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Rank" FontWeight="Bold" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="Date" FontWeight="Bold" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="Peak Gust" FontWeight="Bold" Foreground="#A5B4FC" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="Avg Wind" FontWeight="Bold" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Top10HighestGusts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource DailyRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="45" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding RankDisplay}" FontWeight="Bold" FontSize="12" Foreground="#4F46E5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource DailyDateFgBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontWeight="Bold" FontSize="12" Foreground="#4F46E5" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SecondaryInfo}" FontSize="11" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Top 10 Rainiest Days Card -->
                                <Border MaxWidth="570" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <controls:WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="🌧" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Top 10 Rainiest Days" FontSize="14" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Text=" (Single-Day Precipitation)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </controls:WrapPanel>

                                        <!-- Column Headers -->
                                        <Border Background="#0F172A" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Rank" FontWeight="Bold" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="Date" FontWeight="Bold" Foreground="White" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="Precip" FontWeight="Bold" Foreground="#5EEAD4" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="Activity" FontWeight="Bold" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Top10RainiestDays}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource DailyRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="45" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding RankDisplay}" FontWeight="Bold" FontSize="12" Foreground="#0D9488" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource DailyDateFgBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontWeight="Bold" FontSize="12" Foreground="#0D9488" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SecondaryInfo}" FontSize="11" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- ==================== TAB 5: RAIN DAYS (GIANT HEATMAP) ==================== -->
                <StackPanel x:Name="ViewRainDays" Visibility="Collapsed">
                    <Border Background="{Binding Theme.SubCardBackground}" BorderBrush="{Binding Theme.SubCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12,14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding RainDaysSummaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource StreakItemBgBrush}" BorderBrush="{StaticResource StreakItemBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10,12,10" Margin="0,0,10,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Year}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource DailyDateFgBrush}" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="🌧 Rain: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource WetStreakTitleBrush}" />
                                                    <TextBlock Text="{Binding RainDays, StringFormat='{}{0} days'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DailyDateFgBrush}" />
                                                    <TextBlock Text="{Binding TotalRainInches, StringFormat=' ({0:F2}&quot;)'}" FontSize="11" Foreground="{StaticResource StreakDetailsFgBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="⚡ Lightning: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource DryStreakTitleBrush}" />
                                                    <TextBlock Text="{Binding LightningDays, StringFormat='{}{0} storm days'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DailyDateFgBrush}" />
                                                    <TextBlock Text="{Binding TotalLightningStrikes, StringFormat=' ({0:N0} strikes)'}" FontSize="11" Foreground="{StaticResource StreakDetailsFgBrush}" />
                                                </StackPanel>
                                                <Border Height="1" Background="{StaticResource DailyRowDividerBrush}" Margin="0,2,0,4" />
                                                <TextBlock Text="{Binding DaysRecordedDisplay}" FontSize="11" Foreground="{StaticResource StreakDetailsFgBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <controls:MultiYearDayHeatmapGrid x:Name="ChartAllRainDays" Title="All-Time Daily Precipitation &amp; Lightning" Metric="Combined" IsInverted="True" Margin="0,0,0,20" />
                </StackPanel>

                <!-- ==================== TAB 6: DAILY HISTORY ==================== -->
                <StackPanel x:Name="ViewDaily" Visibility="Collapsed">
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                                    <TextBlock Text="Filter by Date:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DailyMutedFgBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="TxtSearchDaily" Width="160" Height="32" Text="{Binding DailySearchText, Mode=TwoWay}"
                                             Background="{Binding Theme.InputBg}" Foreground="{Binding Theme.InputFg}" BorderBrush="{Binding Theme.InputBorder}"
                                             TextChanged="TxtSearchDaily_TextChanged" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                                    <TextBlock Text="Year:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DailyMutedFgBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid VerticalAlignment="Center">
                                        <Border x:Name="BorderYearFilter" CornerRadius="6"
                                                Background="{Binding Theme.InputBg}"
                                                BorderBrush="{Binding Theme.InputBorder}"
                                                BorderThickness="1"
                                                Width="110" Height="32" Padding="10,0,8,0"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="BorderYearFilter_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtSelectedYear"
                                                           Text="{Binding SelectedDailyYearDisplay}"
                                                           Foreground="{Binding Theme.InputFg}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="▾"
                                                           Foreground="{Binding Theme.TextSecondary}"
                                                           FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                        </Border>

                                        <Popup x:Name="PopupYearFilter" IsOpen="False"
                                               PlacementTarget="{Binding ElementName=BorderYearFilter}"
                                               Placement="Bottom"
                                               StaysWithinScreenBounds="True">
                                            <Border Background="{Binding Theme.SubCardBackground}"
                                                    BorderBrush="{Binding Theme.SubCardBorder}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    MinWidth="110" Padding="4" Margin="0,2,0,0">
                                                <StackPanel x:Name="YearOptionsStack" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                                <Button x:Name="BtnExportExcel" Content="Export All to CSV" Click="BtnExportExcel_Click"
                                        Style="{StaticResource TabNavButtonStyle}"
                                        Background="#2563EB" BorderBrush="#1D4ED8" BorderThickness="1"
                                        Foreground="White" FontWeight="SemiBold" FontSize="12"
                                        Padding="14,6,14,6" Height="32"
                                        Margin="0,0,0,4" VerticalAlignment="Center" Cursor="Hand" />
                            </controls:WrapPanel>
                            <TextBlock Grid.Column="1" Text="{Binding FilteredDailyRecords.Count, StringFormat='Showing {0} daily records'}"
                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <Border Background="#0F172A" CornerRadius="6" Padding="12,10,12,10" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" Foreground="White" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="High Temp" FontWeight="Bold" Foreground="#FB7185" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Low Temp" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Precip" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Wind Gust" FontWeight="Bold" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Solar W/m²" FontWeight="Bold" Foreground="#FDE047" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="UV Index" FontWeight="Bold" Foreground="#FDE047" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="7" Text="Lightning" FontWeight="Bold" Foreground="#C084FC" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FilteredDailyRecords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DailyRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Date}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource DailyDateFgBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding TempHighF, StringFormat='{}{0:F1}°F'}" FontSize="12" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding TempLowF, StringFormat='{}{0:F1}°F'}" FontSize="12" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding PrecipInches, StringFormat='{}{0:F2} in'}" FontSize="12" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding WindGustMph, StringFormat='{}{0:F1} mph'}" FontSize="12" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding SolarRadiationAvg, StringFormat='{}{0:F0}'}" FontSize="12" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding UvAvg, StringFormat='{}{0:F1}'}" FontSize="12" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="7" Text="{Binding LightningStrikes, StringFormat='{}{0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== TAB 7: ABOUT ==================== -->
                <StackPanel x:Name="ViewAbout" Visibility="Collapsed">
                    <controls:AboutControl />
                </StackPanel>

            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- FLOATING IN-APP UPDATE WINDOW OVERLAY -->
        <Grid x:Name="UpdateWindowOverlayGrid" Visibility="{Binding UpdateWindowVisibility}" 
              Background="#99090D16" Canvas.ZIndex="850">
            <controls:AppUpdateWindowControl x:Name="UpdateWindowControlElement" MaxWidth="600" MaxHeight="480" Margin="12"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
