                            <TextBlock Text="All-time top 10 daily records for temperature extremes, peak wind gusts, and daily rainfall totals." FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

