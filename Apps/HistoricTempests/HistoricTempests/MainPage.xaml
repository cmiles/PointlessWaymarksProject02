<Page x:Class="HistoricTempests.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:HistoricTempests.Controls"
      Foreground="#0F172A">

    <Page.Resources>
        <Style x:Key="TabNavButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#F8FAFC">
        <ScrollViewer x:Name="MainPageScrollViewer" Background="#F8FAFC" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="LayoutRoot" MaxWidth="1200" HorizontalAlignment="Stretch" Margin="16,20,16,40">
                <StackPanel x:Name="MainContainer" HorizontalAlignment="Stretch">

                <!-- 1. HEADER BAR -->
                <Border Background="#0F172A" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Title, Subtitle, and Refresh Action Button (wraps vertically on small screens instead of having its own column) -->
                        <controls:WrapPanel Grid.Row="0" Orientation="Horizontal">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,8">
                                <TextBlock Text="Rincon Valley Weather" FontSize="26" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="WeatherFlow Tempest Data" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock Text="•" FontSize="13" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock Text="Last Data: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding LastDataDateText}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock Text="•" FontSize="13" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,2" />
                                    <TextBlock Text="Archive Days: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ArchiveDaysText}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,0,2" />
                                </controls:WrapPanel>
                            </StackPanel>

                            <!-- Header Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <!-- Refresh Button -->
                                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Style="{StaticResource TabNavButtonStyle}"
                                        Background="#2563EB" BorderBrush="#1D4ED8" BorderThickness="1"
                                        Foreground="White" FontWeight="SemiBold" FontSize="12"
                                        Padding="16,8,16,8" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↻ " FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:WrapPanel>
                    </Grid>
                </Border>

                <!-- Loading / Error Alert Banner -->
                <Border x:Name="ErrorBanner" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- 2. NAVIGATION TAB BAR -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,16">
                    <controls:WrapPanel Orientation="Horizontal">
                        <Button x:Name="TabBtn14Days" Content="14 Days" Click="TabBtn_Click" Tag="Timeline14Days" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="Bold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtn6Month" Content="6 Months" Click="TabBtn_Click" Tag="Timeline6Month" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtn12Month" Content="12 Months" Click="TabBtn_Click" Tag="Timeline12Month" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnRainDays" Content="🌧 Rain Days" Click="TabBtn_Click" Tag="RainDays" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnOverview" Content="📊 Records" Click="TabBtn_Click" Tag="Overview" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnDaily" Content="🗄 Daily History" Click="TabBtn_Click" Tag="Daily" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                        <Button x:Name="TabBtnAbout" Content="ℹ️ About" Click="TabBtn_Click" Tag="About" Style="{StaticResource TabNavButtonStyle}"
                                Margin="3" Padding="14,8,14,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    </controls:WrapPanel>
                </Border>

                <!-- 3. TAB CONTENT CONTAINERS -->

                <!-- ==================== TAB 1: 14 DAYS (DEFAULT FIRST PAGE) ==================== -->
                <StackPanel x:Name="ViewTimeline14Days">
                    <!-- Top Executive Glance Summary Block -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,16">
                        <controls:WrapPanel Orientation="Horizontal">
                            <!-- Rain -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌧 Rain: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayRainDaysText}" Foreground="{Binding Glance14DayRainDaysBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayRainAmountText}" Foreground="{Binding Glance14DayRainAmountBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Temperature -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌡 Temp: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Max " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayTempMaxText}" Foreground="{Binding Glance14DayTempMaxBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Min " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayTempMinText}" Foreground="{Binding Glance14DayTempMinBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayTempAvgText}" Foreground="{Binding Glance14DayTempAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Wind -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💨 Wind: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayWindAvgText}" Foreground="{Binding Glance14DayWindAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayWindPeakText}" Foreground="#475569" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Lightning -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Lightning: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayLightningStrikesText}" Foreground="{Binding Glance14DayLightningStrikesBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DayLightningDaysText}" Foreground="{Binding Glance14DayLightningDaysBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Sun / Amount of Sun -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,0,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☀️ Sun: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance14DaySolarAvgText}" Foreground="{Binding Glance14DaySolarAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </controls:WrapPanel>
                    </Border>

                    <!-- 1. Average Temp Graph: 14 Days Forward / 14 Back (Fahrenheit) - TOP -->
                    <controls:MultiYearTimelineLineChart x:Name="Chart14DayTempAvg" Title="Average Daily Temperature" Mode="AverageTemperature" ShowFutureShading="True" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,20">
                        <controls:WrapPanel Orientation="Horizontal">
                            <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="14 DAYS SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            </Border>
                            <TextBlock Text="{Binding SixMonthAvgTempThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthAvgTempDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthAvgTempDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                        </controls:WrapPanel>
                    </Border>

                    <!-- 2. Temperature graph: Max High & Min Low (Fahrenheit) -->
                    <controls:MultiYearTimelineLineChart x:Name="Chart14DayTempDual" Title="Daily Temperature Range (Max High &amp; Min Low)" Mode="TemperatureDual" ShowFutureShading="True" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,20">
                        <controls:WrapPanel Orientation="Horizontal">
                            <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="14 DAYS SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            </Border>
                            <TextBlock Text="{Binding SixMonthAvgHighThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthAvgHighDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthAvgHighDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding SixMonthAvgLowThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthAvgLowDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthAvgLowDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                        </controls:WrapPanel>
                    </Border>

                    <!-- 3. Peak Daily Wind Gust Graph: 14 Days Forward / 14 Back (Line Chart) -->
                    <controls:MultiYearTimelineLineChart x:Name="Chart14DayWind" Title="Peak Daily Wind Gust" Mode="WindGust" ShowFutureShading="True" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,20">
                        <controls:WrapPanel Orientation="Horizontal">
                            <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="14 DAYS SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                            </Border>
                            <TextBlock Text="{Binding SixMonthWindThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SixMonthWindDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthWindDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{Binding SixMonthWindPeakText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,0,4" TextWrapping="Wrap" />
                        </controls:WrapPanel>
                    </Border>

                    <!-- 4. Combined Precipitation & Lightning Grid: Days on X-axis, Years on Y-axis -->
                    <controls:MultiYearDayHeatmapGrid x:Name="Chart14DayCombined" Title="Daily Precipitation &amp; Lightning Grid" Metric="Combined" ShowFutureShading="True" Height="450" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12,14,12" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Precipitation Summary -->
                            <controls:WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                    <TextBlock Text="14 DAYS PRECIPITATION" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" />
                                </Border>
                                <TextBlock Text="{Binding SixMonthRainThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SixMonthRainDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthRainDeltaBrush}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding SixMonthRainDaysText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,0,4" TextWrapping="Wrap" />
                            </controls:WrapPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="#E2E8F0" Margin="0,6,0,10" />

                            <!-- Lightning Summary -->
                            <controls:WrapPanel Orientation="Horizontal">
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                    <TextBlock Text="14 DAYS LIGHTNING" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                                </Border>
                                <TextBlock Text="{Binding SixMonthLightningThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SixMonthLightningDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SixMonthLightningDeltaBrush}" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding SixMonthLightningDaysText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,0,4" TextWrapping="Wrap" />
                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 5. Solar Radiation Graph: 14 Days Forward / 14 Back (Line Chart) -->
                    <controls:MultiYearTimelineLineChart x:Name="Chart14DaySolar" Title="Daily Solar Radiation (Sunniness)" Mode="SolarRadiation" ShowFutureShading="True" Margin="0,0,0,8" />
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10,14,10" Margin="0,0,0,20">
                        <controls:WrapPanel Orientation="Horizontal">
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,10,4" VerticalAlignment="Center">
                                <TextBlock Text="14 DAYS SOLAR RADIATION" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                            </Border>
                            <TextBlock Text="{Binding FourteenDayTabSolarThisYearText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,4" TextWrapping="Wrap" />
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2,6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FourteenDayTabSolarDeltaText}" FontSize="12" FontWeight="Bold" Foreground="{Binding FourteenDayTabSolarDeltaBrush}" TextWrapping="Wrap" />
                            </Border>
                        </controls:WrapPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== TAB 2: 6 MONTHS (SECOND PAGE) ==================== -->
                <StackPanel x:Name="ViewTimeline6Month" Visibility="Collapsed">
                    <!-- Top Executive Glance Summary Block -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,16">
                        <controls:WrapPanel Orientation="Horizontal">
                            <!-- Rain -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌧 Rain: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthRainDaysText}" Foreground="{Binding Glance6MonthRainDaysBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthRainAmountText}" Foreground="{Binding Glance6MonthRainAmountBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Temperature -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌡 Temp: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Max " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthTempMaxText}" Foreground="{Binding Glance6MonthTempMaxBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Min " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthTempMinText}" Foreground="{Binding Glance6MonthTempMinBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthTempAvgText}" Foreground="{Binding Glance6MonthTempAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Wind -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💨 Wind: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthWindAvgText}" Foreground="{Binding Glance6MonthWindAvgBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthWindPeakText}" Foreground="#475569" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Lightning -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ Lightning: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthLightningStrikesText}" Foreground="{Binding Glance6MonthLightningStrikesBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text=", " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Glance6MonthLightningDaysText}" Foreground="{Binding Glance6MonthLightningDaysBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Sun / Amount of Sun -->
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5,10,5" Margin="0,0,0,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="☀️ Sun: " FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    <TextBlock Text="Avg " FontSize="12" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" />
