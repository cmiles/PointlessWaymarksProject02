                                    </StackPanel>
                                </Border>

                                <!-- 3. Top 10 Highest Wind Gusts Card -->
                                <Border MaxWidth="570" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <controls:WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="💨" FontSize="{Binding Theme.FontSizeSubheading}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Top 10 Highest Wind Gusts" FontSize="{Binding Theme.FontSizeMedium}" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Text=" (Peak Daily Gust)" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </controls:WrapPanel>

                                        <!-- Column Headers -->
                                        <Border Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Rank" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" FontSize="{Binding Theme.FontSizeSmall}" TextWrapping="Wrap" />
