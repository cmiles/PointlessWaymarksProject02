                                        <ItemsControl ItemsSource="{Binding Top10HighestGusts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource DailyRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="45" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding RankDisplay}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#4F46E5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyDateFgBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#4F46E5" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SecondaryInfo}" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Top 10 Rainiest Days Card -->
                                <Border MaxWidth="570" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <controls:WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="🌧" FontSize="{Binding Theme.FontSizeSubheading}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Top 10 Rainiest Days" FontSize="{Binding Theme.FontSizeMedium}" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Text=" (Single-Day Precipitation)" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </controls:WrapPanel>

                                        <!-- Column Headers -->
                                        <Border Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Rank" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" FontSize="{Binding Theme.FontSizeSmall}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="Date" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" FontSize="{Binding Theme.FontSizeSmall}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="Precip" FontWeight="Bold" Foreground="#5EEAD4" FontSize="{Binding Theme.FontSizeSmall}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="Activity" FontWeight="Bold" Foreground="#94A3B8" FontSize="{Binding Theme.FontSizeSmall}" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Top10RainiestDays}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource DailyRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="45" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="130" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding RankDisplay}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#0D9488" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDate}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyDateFgBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#0D9488" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SecondaryInfo}" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                            </controls:WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- ==================== TAB 5: RAIN DAYS (GIANT HEATMAP) ==================== -->
                <StackPanel x:Name="ViewRainDays" Visibility="Collapsed">
                    <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12,14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding RainDaysSummaries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource StreakItemBgBrush}" BorderBrush="{StaticResource StreakItemBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10,12,10" Margin="0,0,10,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Year}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeMedium}" Foreground="{StaticResource DailyDateFgBrush}" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="🌧 Rain: " FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{StaticResource WetStreakTitleBrush}" />
                                                    <TextBlock Text="{Binding RainDays, StringFormat='{}{0} days'}" FontSize="{Binding Theme.FontSizeSmall}" FontWeight="Bold" Foreground="{StaticResource DailyDateFgBrush}" />
                                                    <TextBlock Text="{Binding TotalRainInches, StringFormat=' ({0:F2}&quot;)'}" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{StaticResource StreakDetailsFgBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="⚡ Lightning: " FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{StaticResource DryStreakTitleBrush}" />
                                                    <TextBlock Text="{Binding LightningDays, StringFormat='{}{0} storm days'}" FontSize="{Binding Theme.FontSizeSmall}" FontWeight="Bold" Foreground="{StaticResource DailyDateFgBrush}" />
                                                    <TextBlock Text="{Binding TotalLightningStrikes, StringFormat=' ({0:N0} strikes)'}" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{StaticResource StreakDetailsFgBrush}" />
                                                </StackPanel>
                                                <Border Height="1" Background="{StaticResource DailyRowDividerBrush}" Margin="0,2,0,4" />
                                                <TextBlock Text="{Binding DaysRecordedDisplay}" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{StaticResource StreakDetailsFgBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <controls:MultiYearDayHeatmapGrid x:Name="ChartAllRainDays" Title="All-Time Daily Precipitation &amp; Lightning" Metric="Combined" IsInverted="True" Margin="0,0,0,20" />
                </StackPanel>

                <!-- ==================== TAB 6: DAILY HISTORY ==================== -->
                <StackPanel x:Name="ViewDaily" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter by Date:" FontSize="{Binding Theme.FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource DailyMutedFgBrush}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox x:Name="TxtSearchDaily" Width="160" MinHeight="32" Text="{Binding DailySearchText, Mode=TwoWay}"
                                     Background="{Binding Theme.InputBg}" Foreground="{Binding Theme.InputFg}" BorderBrush="{Binding Theme.InputBorder}"
                                     FontSize="{Binding Theme.FontSizeBody}"
                                     TextChanged="TxtSearchDaily_TextChanged" VerticalAlignment="Center" Margin="0,0,16,4" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                                <TextBlock Text="Year:" FontSize="{Binding Theme.FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource DailyMutedFgBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Grid VerticalAlignment="Center">
                                    <Border x:Name="BorderYearFilter" CornerRadius="6"
                                            Background="{Binding Theme.InputBg}"
                                            BorderBrush="{Binding Theme.InputBorder}"
                                            BorderThickness="1"
                                            Width="110" MinHeight="32" Padding="10,0,8,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="BorderYearFilter_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtSelectedYear"
                                                       Text="{Binding SelectedDailyYearDisplay}"
                                                       Foreground="{Binding Theme.InputFg}"
                                                       FontSize="{Binding Theme.FontSizeBody}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="▾"
                                                       Foreground="{Binding Theme.TextSecondary}"
                                                       FontSize="{Binding Theme.FontSizeSmall}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <Popup x:Name="PopupYearFilter" IsOpen="False"
                                           PlacementTarget="{Binding ElementName=BorderYearFilter}"
                                           Placement="Bottom"
                                           StaysWithinScreenBounds="True">
                                        <Border Background="{Binding Theme.SubCardBackground}"
                                                BorderBrush="{Binding Theme.SubCardBorder}"
                                                BorderThickness="1" CornerRadius="6"
                                                MinWidth="110" Padding="4" Margin="0,2,0,0">
                                            <StackPanel x:Name="YearOptionsStack" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                            <Button x:Name="BtnExportExcel" Content="Export All to CSV" Click="BtnExportExcel_Click"
                                    FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}"
                                    Padding="14,6,14,6" MinHeight="32"
                                    Margin="0,0,16,4" VerticalAlignment="Center" Cursor="Hand" />
                            <TextBlock Text="{Binding FilteredDailyRecords.Count, StringFormat='Showing {0} daily records'}"
                                       FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,0,4" />
                        </controls:WrapPanel>
                    </Border>

                    <!-- Desktop/Tablet Wide Table View -->
                    <Border x:Name="DailyTableView" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
                            <StackPanel MinWidth="760">
                                <Border Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10,12,10" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" FontSize="{Binding Theme.FontSizeRegular}" />
                                        <TextBlock Grid.Column="1" Text="High Temp" FontWeight="Bold" Foreground="#FB7185" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Low Temp" FontWeight="Bold" Foreground="#60A5FA" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Precip" FontWeight="Bold" Foreground="#38BDF8" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="Wind Gust" FontWeight="Bold" Foreground="#94A3B8" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="Solar W/m²" FontWeight="Bold" Foreground="#FDE047" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="UV Index" FontWeight="Bold" Foreground="#FDE047" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="Lightning" FontWeight="Bold" Foreground="#C084FC" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding FilteredDailyRecords}" FontSize="{Binding Theme.FontSizeRegular}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DailyRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Date}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyDateFgBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TempHighF, StringFormat='{}{0:F1}°F'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding TempLowF, StringFormat='{}{0:F1}°F'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding PrecipInches, StringFormat='{}{0:F2} in'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding WindGustMph, StringFormat='{}{0:F1} mph'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding SolarRadiationAvg, StringFormat='{}{0:F0}'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6" Text="{Binding UvAvg, StringFormat='{}{0:F1}'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="7" Text="{Binding LightningStrikes, StringFormat='{}{0}'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Mobile Adaptive Cards View (Below 768px) -->
                    <StackPanel x:Name="DailyCardsView" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding FilteredDailyRecords}" FontSize="{Binding Theme.FontSizeRegular}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Theme.CardBackground}" BorderBrush="{Binding Theme.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Card Header: Date & High / Low -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Date}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeBody}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▲ " FontSize="{Binding Theme.FontSizeSmall}" Foreground="#EF4444" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TempHighF, StringFormat='{}{0:F1}°F'}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeBody}" Foreground="#DC2626" VerticalAlignment="Center" />
                                                    <TextBlock Text="   ▼ " FontSize="{Binding Theme.FontSizeSmall}" Foreground="#3B82F6" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TempLowF, StringFormat='{}{0:F1}°F'}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeBody}" Foreground="#2563EB" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{Binding Theme.DividerBrush}" Margin="0,0,0,10" />

                                            <!-- Metric Details 2x2 Grid -->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Precip -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="🌧 Precip: " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PrecipInches, StringFormat='{}{0:F2} in'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="#0284C7" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Wind Gust -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                    <TextBlock Text="💨 Gust: " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding WindGustMph, StringFormat='{}{0:F1} mph'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Solar & UV -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="☀️ " FontSize="{Binding Theme.FontSizeSmall}" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SolarRadiationAvg, StringFormat='{}{0:F0}'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                    <TextBlock Text=" W/m² • UV " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding UvAvg, StringFormat='{}{0:F1}'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Lightning -->
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="⚡ Strikes: " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LightningStrikes, StringFormat='{}{0}'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="#7C3AED" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- ==================== TAB 7: MONTHLY HISTORY ==================== -->
                <StackPanel x:Name="ViewMonthly" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter by Month/Year:" FontSize="{Binding Theme.FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource DailyMutedFgBrush}" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox x:Name="TxtSearchMonthly" Width="160" MinHeight="32" Text="{Binding MonthlySearchText, Mode=TwoWay}"
                                     Background="{Binding Theme.InputBg}" Foreground="{Binding Theme.InputFg}" BorderBrush="{Binding Theme.InputBorder}"
                                     FontSize="{Binding Theme.FontSizeBody}"
                                     TextChanged="TxtSearchMonthly_TextChanged" VerticalAlignment="Center" Margin="0,0,16,4" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                                <TextBlock Text="Year:" FontSize="{Binding Theme.FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource DailyMutedFgBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Grid VerticalAlignment="Center">
                                    <Border x:Name="BorderMonthlyYearFilter" CornerRadius="6"
                                            Background="{Binding Theme.InputBg}"
                                            BorderBrush="{Binding Theme.InputBorder}"
                                            BorderThickness="1"
                                            Width="110" MinHeight="32" Padding="10,0,8,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="BorderMonthlyYearFilter_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtSelectedMonthlyYear"
                                                       Text="{Binding SelectedMonthlyYearDisplay}"
                                                       Foreground="{Binding Theme.InputFg}"
                                                       FontSize="{Binding Theme.FontSizeBody}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="▾"
                                                       Foreground="{Binding Theme.TextSecondary}"
                                                       FontSize="{Binding Theme.FontSizeSmall}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </Grid>
                                    </Border>

                                    <Popup x:Name="PopupMonthlyYearFilter" IsOpen="False"
                                           PlacementTarget="{Binding ElementName=BorderMonthlyYearFilter}"
                                           Placement="Bottom"
                                           StaysWithinScreenBounds="True">
                                        <Border Background="{Binding Theme.SubCardBackground}"
                                                BorderBrush="{Binding Theme.SubCardBorder}"
                                                BorderThickness="1" CornerRadius="6"
                                                MinWidth="110" Padding="4" Margin="0,2,0,0">
                                            <StackPanel x:Name="MonthlyYearOptionsStack" />
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                            <Button x:Name="BtnExportMonthlyExcel" Content="Export All to CSV" Click="BtnExportMonthlyExcel_Click"
                                    FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}"
                                    Padding="14,6,14,6" MinHeight="32"
                                    Margin="0,0,16,4" VerticalAlignment="Center" Cursor="Hand" />
                            <TextBlock Text="{Binding FilteredMonthlyRecords.Count, StringFormat='Showing {0} monthly records'}"
                                       FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,0,4" />
                        </controls:WrapPanel>
                    </Border>

                    <!-- Desktop/Tablet Wide Table View -->
                    <Border x:Name="MonthlyTableView" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
                            <StackPanel MinWidth="860">
                                <Border Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10,12,10" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Month" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" FontSize="{Binding Theme.FontSizeRegular}" />
                                        <TextBlock Grid.Column="1" Text="Mean High" FontWeight="Bold" Foreground="#FB7185" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Mean Low" FontWeight="Bold" Foreground="#60A5FA" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Total Precip" FontWeight="Bold" Foreground="#38BDF8" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="Rain Days" FontWeight="Bold" Foreground="#0284C7" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="Peak Gust" FontWeight="Bold" Foreground="#94A3B8" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="Solar W/m²" FontWeight="Bold" Foreground="#FDE047" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="UV Index" FontWeight="Bold" Foreground="#FDE047" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="8" Text="Lightning" FontWeight="Bold" Foreground="#C084FC" FontSize="{Binding Theme.FontSizeRegular}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding FilteredMonthlyRecords}" FontSize="{Binding Theme.FontSizeRegular}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DailyRowDividerBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayMonth}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyDateFgBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MeanHighF, StringFormat='{}{0:F1}°F'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding MeanLowF, StringFormat='{}{0:F1}°F'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalPrecipInches, StringFormat='{}{0:F2} in'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding RainyDays, StringFormat='{}{0} days'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding MaxGustMph, StringFormat='{}{0:F1} mph'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6" Text="{Binding AvgSolarRadiation, StringFormat='{}{0:F0}'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="7" Text="{Binding AvgUvIndex, StringFormat='{}{0:F1}'}" FontSize="{Binding Theme.FontSizeRegular}" Foreground="{StaticResource DailyMutedFgBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="8" Text="{Binding LightningStrikes, StringFormat='{}{0} strikes'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeRegular}" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Mobile Adaptive Cards View (Below 768px) -->
                    <StackPanel x:Name="MonthlyCardsView" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding FilteredMonthlyRecords}" FontSize="{Binding Theme.FontSizeRegular}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Theme.CardBackground}" BorderBrush="{Binding Theme.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Card Header: Month & Mean High / Low -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayMonth}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeBody}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▲ " FontSize="{Binding Theme.FontSizeSmall}" Foreground="#EF4444" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MeanHighF, StringFormat='{}{0:F1}°F'}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeBody}" Foreground="#DC2626" VerticalAlignment="Center" />
                                                    <TextBlock Text="   ▼ " FontSize="{Binding Theme.FontSizeSmall}" Foreground="#3B82F6" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MeanLowF, StringFormat='{}{0:F1}°F'}" FontWeight="Bold" FontSize="{Binding Theme.FontSizeBody}" Foreground="#2563EB" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <Rectangle Height="1" Fill="{Binding Theme.DividerBrush}" Margin="0,0,0,10" />

                                            <!-- Metric Details 2x2 Grid -->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Rain & Rain Days -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="🌧 Rain: " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TotalPrecipInches, StringFormat='{}{0:F2} in'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="#0284C7" VerticalAlignment="Center" />
                                                    <TextBlock Text=" (" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RainyDays}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="d)" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Peak Gust -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                    <TextBlock Text="💨 Peak: " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MaxGustMph, StringFormat='{}{0:F1} mph'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Solar & UV -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="☀️ " FontSize="{Binding Theme.FontSizeSmall}" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AvgSolarRadiation, StringFormat='{}{0:F0}'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                    <TextBlock Text=" W/m² • UV " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AvgUvIndex, StringFormat='{}{0:F1}'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Lightning -->
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="⚡ Strikes: " FontSize="{Binding Theme.FontSizeSmall}" Foreground="{Binding Theme.TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LightningStrikes, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" FontSize="{Binding Theme.FontSizeSmall}" Foreground="#7C3AED" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- ==================== TAB 8: ABOUT ==================== -->
                <StackPanel x:Name="ViewAbout" Visibility="Collapsed">
                    <controls:AboutControl />
                </StackPanel>

            </StackPanel>
            </Grid>
        </controls:ResponsiveScrollViewer>

        <!-- FLOATING IN-APP UPDATE WINDOW OVERLAY -->
        <Grid x:Name="UpdateWindowOverlayGrid" Visibility="{Binding UpdateWindowVisibility}" 
              Background="#99090D16" Canvas.ZIndex="850">
            <controls:AppUpdateWindowControl x:Name="UpdateWindowControlElement" MaxWidth="600" MaxHeight="480" Margin="12"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
