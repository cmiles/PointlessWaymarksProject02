<ResourceDictionary x:Class="HistoricTempests.Themes.LightTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core App Surfaces & Text -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SubtleCardBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SubtleCardBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5E1" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextHeadingBrush" Color="#0F172A" />

    <!-- Links & Accents -->
    <SolidColorBrush x:Key="HyperlinkBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="SkyAccentBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="EmeraldAccentBrush" Color="#059669" />
    <SolidColorBrush x:Key="RedAccentBrush" Color="#DC2626" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundBrush" Color="#FFE7E8E9" />
    <SolidColorBrush x:Key="ScrollBarButtonForegroundBrush" Color="#FFC9C9C9" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FFC9C9C9" />

    <!-- Daily Records & Streaks -->
    <SolidColorBrush x:Key="DailyRowDividerBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DailyDateFgBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="DailyMutedFgBrush" Color="#475569" />

    <SolidColorBrush x:Key="StreakItemBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StreakItemBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="StreakDateFgBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="StreakDetailsFgBrush" Color="#64748B" />

    <SolidColorBrush x:Key="DryStreakTitleBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DryStreakBadgeBgBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="DryStreakBadgeBorderBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="DryStreakBadgeFgBrush" Color="#B45309" />

    <SolidColorBrush x:Key="WetStreakTitleBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="WetStreakBadgeBgBrush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="WetStreakBadgeBorderBrush" Color="#BAE6FD" />
    <SolidColorBrush x:Key="WetStreakBadgeFgBrush" Color="#0284C7" />

</ResourceDictionary>
