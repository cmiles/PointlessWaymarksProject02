<ResourceDictionary x:Class="HistoricTempests.Themes.DarkTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core App Surfaces & Text -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="SubtleCardBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SubtleCardBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="DividerBrush" Color="#334155" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextHeadingBrush" Color="#F8FAFC" />

    <!-- Links & Accents -->
    <SolidColorBrush x:Key="HyperlinkBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="SkyAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="EmeraldAccentBrush" Color="#34D399" />
    <SolidColorBrush x:Key="RedAccentBrush" Color="#EF4444" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="ScrollBarButtonForegroundBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FF475569" />

    <!-- Daily Records & Streaks -->
    <SolidColorBrush x:Key="DailyRowDividerBrush" Color="#334155" />
    <SolidColorBrush x:Key="DailyDateFgBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="DailyMutedFgBrush" Color="#CBD5E1" />

    <SolidColorBrush x:Key="StreakItemBgBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="StreakItemBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="StreakDateFgBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="StreakDetailsFgBrush" Color="#94A3B8" />

    <SolidColorBrush x:Key="DryStreakTitleBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DryStreakBadgeBgBrush" Color="#451A03" />
    <SolidColorBrush x:Key="DryStreakBadgeBorderBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DryStreakBadgeFgBrush" Color="#FDE68A" />

    <SolidColorBrush x:Key="WetStreakTitleBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="WetStreakBadgeBgBrush" Color="#082F49" />
    <SolidColorBrush x:Key="WetStreakBadgeBorderBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="WetStreakBadgeFgBrush" Color="#7DD3FC" />

</ResourceDictionary>
