<UserControl x:Class="HistoricTempests.Controls.AboutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HistoricTempests.Controls">

    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="10"
            Margin="0,4,0,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SubtleCardBackgroundBrush}" CornerRadius="9,9,0,0" Padding="20,16" 
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ℹ️" FontSize="{Binding Theme.FontSizeHeading}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="About Rincon Valley Weather" FontWeight="Bold" FontSize="{Binding Theme.FontSizeSubheading}" Foreground="{StaticResource TextHeadingBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Padding="22,18">
                <!-- Top Info Card -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,16">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Historic weather data analysis from a personal weather station located in the Rincon Valley southeast of Tucson, AZ. Features multi-year comparisons of temperature, rainfall, wind gusts, and lightning strikes across 14-day, 6-month and 12-month timeframes. Built with C#/.NET using OpenSilver with code generation and assistance from Google's Gemini 3.8 Flash in Antigravity."
                                   FontSize="{Binding Theme.FontSizeMedium}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="App written and maintained by Charles Miles. A resident of the Rincon Valley since the early 2020s, I love getting outside to hike, run, and take photos. I bring over two decades of experience in software development, data management, and inventory control, and I'm currently pursuing an AAS in Health Information Technology at Pima Community College to expand my skills into healthcare."
                                   FontSize="{Binding Theme.FontSizeMedium}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <controls:WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                                <HyperlinkButton Content="Resume - Charles Miles" NavigateUri="https://cmiles.info/Posts/Career/resume/resume.html" TargetName="_blank"
                                                 Click="Hyperlink_Click"
                                                 FontSize="{Binding Theme.FontSizeMedium}" FontWeight="SemiBold" Foreground="{StaticResource HyperlinkBrush}" 
                                                 Padding="0" Margin="0" Cursor="Hand" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                                <TextBlock Text="Personal Website: " FontSize="{Binding Theme.FontSizeMedium}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="cmiles.info" NavigateUri="https://cmiles.info/" TargetName="_blank"
                                                 Click="Hyperlink_Click"
                                                 FontSize="{Binding Theme.FontSizeMedium}" FontWeight="SemiBold" Foreground="{StaticResource HyperlinkBrush}" 
                                                 Padding="0" Margin="0" Cursor="Hand" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                                <TextBlock Text="Photography: " FontSize="{Binding Theme.FontSizeMedium}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="Pointless Waymarks" NavigateUri="https://pointlesswaymarks.com/" TargetName="_blank"
                                                 Click="Hyperlink_Click"
                                                 FontSize="{Binding Theme.FontSizeMedium}" FontWeight="SemiBold" Foreground="{StaticResource HyperlinkBrush}" 
                                                 Padding="0" Margin="0" Cursor="Hand" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="LinkedIn: " FontSize="{Binding Theme.FontSizeMedium}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="Charles Miles" NavigateUri="https://www.linkedin.com/in/charlesamiles/" TargetName="_blank"
                                                 Click="Hyperlink_Click"
                                                 FontSize="{Binding Theme.FontSizeMedium}" FontWeight="SemiBold" Foreground="{StaticResource HyperlinkBrush}" 
                                                 Padding="0" Margin="0" Cursor="Hand" VerticalAlignment="Center"/>
                            </StackPanel>
                        </controls:WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Packages Section Header -->
                <TextBlock Text="PACKAGES &amp; TECHNOLOGIES USED" FontSize="{Binding Theme.FontSizeBody}" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10"/>

                <!-- Package 1: OpenSilver -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="OpenSilver" FontSize="{Binding Theme.FontSizeMedium}" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Open-source framework enabling modern XAML and C# execution via WebAssembly and HTML5 in any modern browser."
                                   FontSize="{Binding Theme.FontSizeBody}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="opensilver.net ↗" NavigateUri="https://opensilver.net" TargetName="_blank"
                                         Click="Hyperlink_Click" FontSize="{Binding Theme.FontSizeBody}" Foreground="{StaticResource HyperlinkBrush}" HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand" Padding="0"/>
                    </StackPanel>
                </Border>

                <!-- Package 2: WeatherFlow Tempest -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="WeatherFlow Tempest Weather System &amp; Data API" FontSize="{Binding Theme.FontSizeMedium}" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="All-in-one smart weather station with sonic anemometer, haptic rain sensor, optical lightning detector, and multi-year cloud archive data."
                                   FontSize="{Binding Theme.FontSizeBody}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="weatherflow.com ↗" NavigateUri="https://weatherflow.com/tempest-weather-system/" TargetName="_blank"
                                         Click="Hyperlink_Click" FontSize="{Binding Theme.FontSizeBody}" Foreground="{StaticResource HyperlinkBrush}" HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand" Padding="0"/>
                    </StackPanel>
                </Border>

                <!-- Package 3: Photino.NET -->
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Photino.NET" FontSize="{Binding Theme.FontSizeMedium}" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Lightweight, cross-platform native desktop webview container for Windows, macOS, and Linux."
                                   FontSize="{Binding Theme.FontSizeBody}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="tryphotino.io ↗" NavigateUri="https://www.tryphotino.io" TargetName="_blank"
                                         Click="Hyperlink_Click" FontSize="{Binding Theme.FontSizeBody}" Foreground="{StaticResource HyperlinkBrush}" HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand" Padding="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Window Footer -->
            <Border Grid.Row="2" Background="{StaticResource SubtleCardBackgroundBrush}" CornerRadius="0,0,9,9" Padding="18,12" 
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="Pointless Waymarks Project" FontSize="{Binding Theme.FontSizeBody}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
