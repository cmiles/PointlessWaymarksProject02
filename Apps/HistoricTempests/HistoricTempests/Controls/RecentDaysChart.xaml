<UserControl x:Class="HistoricTempests.Controls.RecentDaysChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HistoricTempests.Controls"
             Height="280">
    <Border x:Name="ChartCardBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="YAxisCol" Width="55" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Chart Header & Legend (Wraps dynamically) -->
            <controls:WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Orientation="Horizontal">
                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                    <TextBlock Text="Recent 14 Days Temperature Range &amp; Rain" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="UnitSubtitle" Text="(°F)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                </controls:WrapPanel>

                <!-- Legends -->
                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <Border Width="12" Height="12" Background="#F43F5E" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="Current High" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <Border Width="12" Height="12" Background="#3B82F6" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="Current Low" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <Border Width="14" Height="3" Background="#94A3B8" CornerRadius="1" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="Normal High" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <Border Width="12" Height="12" Background="#0284C7" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="Rain" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                </controls:WrapPanel>
            </controls:WrapPanel>

            <!-- Y Axis container -->
            <Grid x:Name="YAxisContainer" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                <Canvas x:Name="YAxisCanvas" />
            </Grid>

            <!-- Main Canvas -->
            <Grid x:Name="ChartGrid" Grid.Row="1" Grid.Column="1">
                <Canvas x:Name="GridLinesCanvas" Background="Transparent" />
                <Canvas x:Name="ChartCanvas" Background="Transparent" />
                <Canvas x:Name="OverlayCanvas" Background="Transparent" />
            </Grid>

            <!-- X Axis Labels Canvas -->
            <Canvas x:Name="XAxisCanvas" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" />
        </Grid>
    </Border>
</UserControl>
