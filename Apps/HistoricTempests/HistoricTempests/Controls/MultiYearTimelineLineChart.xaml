<UserControl x:Class="HistoricTempests.Controls.MultiYearTimelineLineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HistoricTempests.Controls"
             Height="325">
    <Border x:Name="ChartCardBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="2,12,10,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="YAxisCol" Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Chart Header & Legend (Wraps vertically under title, and individual legend items wrap) -->
            <controls:WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="12,0,0,8" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="ChartTitleBlock" Text="Temperature Timeline" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,6,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ChartUnitBlock" Text="(°F)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Dynamic Legends WrapPanel -->
                <controls:WrapPanel x:Name="LegendContainer" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0" />
            </controls:WrapPanel>

            <!-- Y Axis container -->
            <Grid x:Name="YAxisContainer" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                <Canvas x:Name="YAxisCanvas" />
            </Grid>

            <!-- Main Canvas Area -->
            <Grid x:Name="ChartGrid" Grid.Row="1" Grid.Column="1" Background="Transparent">
                <Canvas x:Name="GridLinesCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="BackgroundBandsCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="ChartCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="DividerCanvas" IsHitTestVisible="False" />
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />
            </Grid>

            <!-- X Axis Labels Canvas -->
            <Canvas x:Name="XAxisCanvas" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" />
        </Grid>
    </Border>
</UserControl>
