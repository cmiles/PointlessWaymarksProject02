<UserControl x:Class="HistoricTempests.Controls.MultiYearDayHeatmapGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HistoricTempests.Controls"
             MinHeight="230">
    <Border x:Name="GridCardBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14,16,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Grid Header & Legend (Wraps dynamically on smaller screens) -->
            <controls:WrapPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,6">
                    <TextBlock x:Name="ChartTitleBlock" Text="Daily Precipitation Grid" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,6,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ChartUnitBlock" Text="(in)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                </controls:WrapPanel>

                <!-- Heatmap Color Scale Legend -->
                <controls:WrapPanel x:Name="LegendContainer" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6" />
            </controls:WrapPanel>

            <!-- Standard Horizontal Container (14 Days, 6 Months, 12 Months) -->
            <Grid x:Name="HorizontalLayoutGrid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="YAxisCol" Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Y Axis container (Years) -->
                <Canvas x:Name="YAxisCanvas" Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" />

                <!-- Main Canvas Area (Cells) -->
                <Canvas x:Name="GridCanvas" Grid.Row="0" Grid.Column="1" Background="Transparent" />

                <!-- X Axis Labels Canvas (Dates) -->
                <Canvas x:Name="XAxisCanvas" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" />
            </Grid>

            <!-- Inverted Vertical Container (Rain Days: Hardware-Accelerated HTML5 Canvas) -->
            <Grid x:Name="InvertedLayoutGrid" Grid.Row="1" Visibility="Collapsed">
                <Border x:Name="InvertedCanvasContainer" HorizontalAlignment="Stretch" Background="White" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
