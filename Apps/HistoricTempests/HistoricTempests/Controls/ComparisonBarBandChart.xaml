<UserControl x:Class="HistoricTempests.Controls.ComparisonBarBandChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HistoricTempests.Controls"
             Height="320">
    <Border x:Name="ChartCardBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="YAxisCol" Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Chart Header & Dynamic Legend (Wraps dynamically) -->
            <controls:WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12" Orientation="Horizontal">
                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,6">
                    <TextBlock x:Name="ChartTitleBlock" Text="Monthly Multi-Year Comparison" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ChartSubtitleBlock" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </controls:WrapPanel>

                <!-- Year Color Legends -->
                <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <!-- 2023 -->
                    <Border Width="12" Height="12" Background="#6366F1" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Legend2023" Text="2023" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- 2024 -->
                    <Border Width="12" Height="12" Background="#F59E0B" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Legend2024" Text="2024" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- 2025 -->
                    <Border Width="12" Height="12" Background="#10B981" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Legend2025" Text="2025" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- 2026 -->
                    <Border Width="12" Height="12" Background="#F43F5E" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="Legend2026" Text="2026" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                    <!-- Historical Normal -->
                    <Border Width="14" Height="3" Background="#94A3B8" CornerRadius="1" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LegendNormal" Text="Normal" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                </controls:WrapPanel>
            </controls:WrapPanel>

            <!-- Y-Axis Ticks & Container -->
            <Grid x:Name="YAxisContainer" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock x:Name="YAxisUnitLabel" Text="in" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" 
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,4,0" />
                <Canvas x:Name="YAxisCanvas" />
            </Grid>

            <!-- Main Canvas Area -->
            <Grid x:Name="ChartGrid" Grid.Row="1" Grid.Column="1">
                <Canvas x:Name="GridLinesCanvas" Background="Transparent" />
                <Canvas x:Name="ChartCanvas" Background="Transparent" />
                <Canvas x:Name="OverlayCanvas" Background="Transparent" />
            </Grid>

            <!-- X-Axis Month Grid Labels -->
            <Grid x:Name="XAxisGrid" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Jan" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Feb" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Mar" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Apr" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="May" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="Jun" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="Jul" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="Aug" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="8" Text="Sep" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="9" Text="Oct" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="10" Text="Nov" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="11" Text="Dec" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
