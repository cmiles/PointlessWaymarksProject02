<Page x:Class="WaterDaze.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:WaterDaze.Controls"
      xmlns:viewmodels="clr-namespace:WaterDaze.ViewModels"
      mc:Ignorable="d"
      Foreground="{StaticResource TextPrimaryBrush}">

    <Page.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" /> 
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextHeadingBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Section Subtitle Style -->
        <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Ranking Card Style -->
        <Style x:Key="RankingCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="RankingTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Modern Action Button Style (no gradient overlay) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ActionButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ActionButtonBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ActionButtonForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HyperlinkButton Style -->
        <Style TargetType="HyperlinkButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource HyperlinkBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="LayoutRoot">
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
            <StackPanel MaxWidth="1180" HorizontalAlignment="Center" Margin="8,16,8,40">

            <!-- 1. HEADER & GAUGE SELECTOR -->
            <Border x:Name="HeaderCardBorder" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <!-- App Title & Author Branding -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="Tucson Area USGS Stream Gauges" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Bottom" Margin="0,0,8,0" TextWrapping="Wrap" />
                        <TextBlock Text="- " FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                        <HyperlinkButton x:Name="LnkAuthor" Content="Charles Miles" NavigateUri="https://cmiles.info" TargetName="_blank" Click="Hyperlink_Click"
                                         FontSize="16" FontWeight="Bold" Foreground="{StaticResource HyperlinkBrush}"
                                         Padding="0" Margin="0,0,0,2" Cursor="Hand" VerticalAlignment="Bottom" />
                    </WrapPanel>
                    <TextBlock Text="Explore historical Daily Mean Flow values for USGS stream gauges across the Tucson basin. Analyzes days of flow, stream flow median and quantiles, maximum daily mean per month, run-length streaks, and annual runoff variability." 
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Site Selector & Action Bar (Fluid Wrap Layout) -->
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="Select USGS Gauge:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextLabelBrush}" VerticalAlignment="Center" Margin="0,0,10,8" />
                        <ComboBox x:Name="CmbSites" MinWidth="180" MaxWidth="420" Height="34"
                                  Background="{StaticResource ControlBackgroundBrush}"
                                  BorderBrush="{StaticResource ControlBorderBrush}"
                                  Foreground="{StaticResource ControlForegroundBrush}"
                                  ItemsSource="{Binding AvailableSites}"
                                  SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayTitle"
                                  VerticalAlignment="Center" Margin="0,0,12,8">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource ControlForegroundBrush}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <!-- Desktop Action Buttons -->
                        <WrapPanel x:Name="PanelDesktopActions" VerticalAlignment="Center">
                            <Button x:Name="BtnRefresh" Content="Refresh Data" Command="{Binding RefreshCommand}" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Height="34" Padding="14,0,14,0" 
                                    VerticalAlignment="Center" Margin="0,0,12,8" />

                            <!-- Updates Button -->
                            <Button x:Name="BtnUpdates" Command="{Binding CheckForUpdatesManualCommand}" Click="BtnUpdates_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Height="34" Padding="12,0"
                                    VerticalAlignment="Center" Margin="0,0,12,8"
                                    ToolTipService.ToolTip="Check online catalog for software updates">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🚀 " FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Updates" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Theme Toggle Button -->
                            <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Width="145" Height="34" Padding="8,0"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,0,0,8"
                                    ToolTipService.ToolTip="Cycle theme: System (Auto) -> Dark -> Light">
                                <TextBlock x:Name="TxtThemeToggle" Text="🌓 Theme" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </WrapPanel>

                        <!-- Mobile Hamburger Button -->
                        <Button x:Name="BtnHamburger" Click="BtnHamburger_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="44" Height="34" Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalAlignment="Center" Margin="0,0,0,8"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Menu">
                            <TextBlock Text="☰" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </WrapPanel>

                    <!-- Mobile Hamburger Dropdown Menu -->
                    <Border x:Name="MobileMenuDropdown" 
                            Background="{StaticResource SubtleCardBackgroundBrush}" 
                            BorderBrush="{StaticResource SubtleCardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" 
                            Visibility="Collapsed">
                        <StackPanel>
                            <Button x:Name="BtnRefreshMobile" Content="↻ Refresh Data" Command="{Binding RefreshCommand}" Click="MobileMenuAction_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Center" />
                            <Button x:Name="BtnUpdatesMobile" Command="{Binding CheckForUpdatesManualCommand}" Click="BtnUpdatesMobile_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="Check online catalog for software updates">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="🚀 " FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Updates" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnThemeToggleMobile" Click="BtnThemeToggle_Click"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Height="36" Margin="0,0,0,0" HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="Cycle theme: System (Auto) -> Dark -> Light">
                                <TextBlock x:Name="TxtThemeToggleMobile" Text="🌓 Theme" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Station Info Banner (Responsive Wrap Layout) -->
                    <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,8,0,0">
                        <StackPanel>
                            <!-- Station Name, Description & Links -->
                            <WrapPanel Margin="0,0,0,4">
                                <StackPanel Margin="0,0,24,8" MaxWidth="720">
                                    <TextBlock Text="{Binding SelectedSite.SiteName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedSite.Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- USGS Links -->
                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                                    <HyperlinkButton Content="USGS Station Page ↗" 
                                                     NavigateUri="{Binding SelectedSite.UsgsInventoryUrl}" 
                                                     TargetName="_blank" FontSize="12" Foreground="{StaticResource HyperlinkBrush}" Margin="0,0,14,4" />
                                    <HyperlinkButton Content="USGS NWIS Mapper ↗" 
                                                     NavigateUri="https://maps.waterdata.usgs.gov/mapper/index.html" 
                                                     TargetName="_blank" FontSize="12" Foreground="{StaticResource HyperlinkBrush}" Margin="0,0,0,0" />
                                </WrapPanel>
                            </WrapPanel>

                            <!-- Key Metrics WrapPanel -->
                            <WrapPanel Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                    <TextBlock Text="Site ID: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SelectedSite.SiteCode}" FontSize="12" Foreground="{StaticResource SiteCodeBrush}" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                    <TextBlock Text="Total Data Days: " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DashboardData.TotalDaysWithData}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                    <TextBlock Text="Flow Days (>0 cfs): " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DashboardData.TotalDaysWithFlow}" FontSize="12" Foreground="{StaticResource FlowDaysBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. ERROR & WARNING STATUS BANNERS -->
            <StackPanel x:Name="StatusContainer" Margin="0,0,0,0">
                <!-- Warning Banner (Cached Data Warning) -->
                <Border x:Name="WarningBanner" Background="{StaticResource WarningBannerBackgroundBrush}" BorderBrush="{StaticResource WarningBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️ " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding WarningMessage}" FontSize="13" Foreground="{StaticResource WarningBannerTextBrush}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="Retry Live Update" Command="{Binding RefreshCommand}" 
                                Height="28" Padding="12,0,12,0" 
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Error Banner -->
                <Border x:Name="ErrorBanner" Background="{StaticResource ErrorBannerBackgroundBrush}" BorderBrush="{StaticResource ErrorBannerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️ " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource ErrorBannerTextBrush}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="Retry" Command="{Binding RefreshCommand}" 
                                Height="28" Padding="12,0,12,0" 
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. SECTION: DAYS OF FLOW -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Days of Flow" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="For frequently dry or low-flow streams 'Days of Flow > 0' is an interesting meric showing if, or how often, surface water is present. Grey bars show total days with recorded observations per month (0–31), while blue lines plot the number of days with flow > 0." 
                               Style="{StaticResource SectionSubtitleStyle}" />

                    <!-- Mini Facet Sparklines Grid -->
                    <ItemsControl ItemsSource="{Binding YearFacets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:YearFacetControl Year="{Binding Year}" MonthlyRecords="{Binding MonthlyRecords}" Margin="2,4,2,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. SECTION: MONTHLY FLOW QUANTILE BAND -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Monthly Flow — Median with 25–75% Band" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Streamflow across the 12 calendar months. The shaded area shows the interquartile range (25th to 75th percentiles) of daily flow, and the solid blue line marks the median daily flow (cfs)." 
                               Style="{StaticResource SectionSubtitleStyle}" />

                    <controls:MonthlyFlowBandChart SummaryRecords="{Binding ClimatologySummaries}" />
                </StackPanel>
            </Border>

            <!-- 5. SECTION: HEATMAP MATRIX -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Max Daily Mean Flow by Month" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="Maximum recorded daily mean flow for each month across all available years. Color intensity reflects flow magnitude on a log₁₀ scale; light grey cells denote periods with no recorded data." 
                               Style="{StaticResource SectionSubtitleStyle}" />

                    <controls:MonthlyHeatmapControl MonthlyRecords="{Binding MonthlyRecords}" Years="{Binding Years}" />
                </StackPanel>
            </Border>

            <!-- 6. SECTION: STREAKS & HISTORICAL EXTREMES -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Streaks &amp; Historical Records" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                <TextBlock Text="Run-length streak detections, annual mean flow rankings (for years with full 12-month data coverage), and all-time peak daily flow events." 
                           Style="{StaticResource SectionSubtitleStyle}" />

                <!-- Responsive Grid of 4 Ranking Cards -->
                <Grid x:Name="RankingsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RankingsCol0" Width="*" />
                        <ColumnDefinition x:Name="RankingsCol1" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RankingsRow0" Height="Auto" />
                        <RowDefinition x:Name="RankingsRow1" Height="Auto" />
                        <RowDefinition x:Name="RankingsRow2" Height="Auto" />
                        <RowDefinition x:Name="RankingsRow3" Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top 10 Wet Streaks -->
                    <Border x:Name="CardWetStreaks" Grid.Row="0" Grid.Column="0" Style="{StaticResource RankingCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Top 10 Wet Streaks (flow > 0)" Style="{StaticResource RankingTitleStyle}" Foreground="{StaticResource RankingWetStreaksTitleBrush}" />
                            <TextBlock Text="Continuous days with flow > 0 cfs. Missing data breaks the streak." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TopWetStreaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{0}.'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Top 10 Dry Streaks -->
                    <Border x:Name="CardDryStreaks" Grid.Row="0" Grid.Column="1" Style="{StaticResource RankingCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Top 10 Dry Streaks (flow = 0)" Style="{StaticResource RankingTitleStyle}" Foreground="{StaticResource RankingDryStreaksTitleBrush}" />
                            <TextBlock Text="Continuous days with zero flow. Missing data breaks the streak." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TopDryStreaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{0}.'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Wettest & Driest Years -->
                    <Border x:Name="CardAnnualMeanFlow" Grid.Row="1" Grid.Column="0" Style="{StaticResource RankingCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Annual Mean Flow (Full Coverage)" Style="{StaticResource RankingTitleStyle}" Foreground="{StaticResource RankingAnnualMeanTitleBrush}" />
                            <TextBlock Text="Ranked annual mean discharge for eligible years with ≥ 1 data day in all 12 months." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,-6,0,10" TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Wettest Sub-column -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Wettest Years" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RankingWettestHeaderBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding TopWettestYears}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{0}.'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Driest Sub-column -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Driest Years" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RankingDriestHeaderBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding TopDriestYears}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{0}.'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Top 10 Peak Daily Mean Flow Days -->
                    <Border x:Name="CardPeakFlowDays" Grid.Row="1" Grid.Column="1" Style="{StaticResource RankingCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Top 10 Daily Mean Flow Days" Style="{StaticResource RankingTitleStyle}" Foreground="{StaticResource RankingPeakFlowTitleBrush}" />
                            <TextBlock Text="Single highest daily mean streamflow events in the historical record." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,-6,0,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding TopPeakFlowDays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='{0}.'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- 7. FOOTER: AUTHOR -->
            <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="App written and maintained by Charles Miles. A resident of the Tucson area since the late 1990s, I love getting outside to hike, run, and take photos. I have over two decades of experience in software development, data management, and inventory control. I'm currently pursuing an AAS in Health Information Technology at Pima Community College to expand my skills into healthcare." FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <TextBlock Text="Originally written as a Python Marimo notebook - transformed to .NET and OpenSilver with Rider, Junie/Gemini and by-human-hand coding." FontSize="14" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />                    
                    <HyperlinkButton NavigateUri="https://cmiles.info/Posts/Career/resume/resume.html"
                                     TargetName="_blank" Foreground="{StaticResource HyperlinkBrush}" Margin="0,0,0,4">
                        <TextBlock Text="Resume - Charles Miles" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
                    </HyperlinkButton>
                    <HyperlinkButton NavigateUri="https://pointlesswaymarks.com/"
                                     TargetName="_blank" Foreground="{StaticResource HyperlinkBrush}" Margin="0,0,0,4">
                        <TextBlock Text="Pointless Waymarks - Ramblings, Questionable Geographics, Photographic Half-truths" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
                    </HyperlinkButton>
                    <HyperlinkButton NavigateUri="https://cmiles.info/"
                                     TargetName="_blank" Foreground="{StaticResource HyperlinkBrush}" Margin="0,0,0,4">
                        <TextBlock Text="cmiles - info - Life, Tech and Unimportant Minutiae" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />
                    </HyperlinkButton>

                    <HyperlinkButton NavigateUri="https://www.linkedin.com/in/charlesamiles/"
                                     TargetName="_blank" Foreground="{StaticResource HyperlinkBrush}" Margin="0,0,0,4">
                        <TextBlock Text="LinkedIn" FontSize="14" Margin="0,0,0,0" TextWrapping="Wrap" />
                    </HyperlinkButton>
                </StackPanel>
            </Border>

            <!-- 8. FOOTER: METHODOLOGY -->
            <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Data Source &amp; Methodology" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextLabelBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DataSourceSummary}" FontSize="14" Foreground="{StaticResource TextHeadingBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="Streamflow statistics computed from USGS NWIS Daily Values REST API (https://waterservices.usgs.gov/nwis/dv/). Percentiles are evaluated via linear interpolation. Run-length streak analysis requires continuous positive or zero flow without missing data gaps." 
                               FontSize="14" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <!-- Loading Banner -->
    <Border x:Name="LoadingBanner" Background="{StaticResource LoadingOverlayBackgroundBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
        <Border Background="{StaticResource LoadingCardBackgroundBrush}" BorderBrush="{StaticResource LoadingCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="⏳" Grid.Row="0" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8" />
                <TextBlock Text="{Binding LoadingStatus}" Grid.Row="1" FontSize="14" Foreground="{StaticResource LoadingCardTextBrush}" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="8" />
            </Grid>
        </Border>
    </Border>

    <!-- FLOATING IN-APP UPDATE WINDOW OVERLAY -->
    <Grid x:Name="UpdateWindowOverlayGrid" Visibility="{Binding UpdateWindowVisibility}" 
          Background="#99090D16" Canvas.ZIndex="850">
        <controls:AppUpdateWindowControl x:Name="UpdateWindowControlElement" MaxWidth="600" MaxHeight="480" Margin="12"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Grid>
</Page>
