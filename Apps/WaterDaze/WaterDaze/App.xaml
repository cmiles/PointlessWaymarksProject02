<Application
    x:Class="WaterDaze.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:WaterDaze.Themes"
    xmlns:mt="http://opensilver.net/themes/modern"
    xmlns:local="clr-namespace:WaterDaze">
    <Application.Theme>
        <mt:ModernTheme>
            <mt:ModernTheme.LightPalette>
                <mt:LightPalette PrimaryColor="#84a7fe" />
            </mt:ModernTheme.LightPalette>
            <mt:ModernTheme.DarkPalette>
                <mt:DarkPalette PrimaryColor="#3B82F6" />
            </mt:ModernTheme.DarkPalette>
        </mt:ModernTheme>
    </Application.Theme>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:LightTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
