<ResourceDictionary x:Class="WaterDaze.Controls.ResponsiveScrollBarDictionary"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ScrollBar">
        <!-- 1. Overall width of the vertical scrollbar -->
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <!-- 2. Track background color -->
        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <!-- VERTICAL SCROLLBAR LAYOUT -->
                        <Grid x:Name="VerticalRoot"
                              Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Arrow Button (Change Background for button, Foreground for arrow icon) -->
                            <RepeatButton x:Name="VerticalSmallDecrease"
                                          Grid.Row="0"
                                          Height="26"
                                          Width="28"
                                          Margin="0,1,1,0"
                                          HorizontalAlignment="Stretch"
                                          Background="{StaticResource ScrollBarButtonBackgroundBrush}"
                                          Foreground="{StaticResource ScrollBarButtonForegroundBrush}"
                                          IsTabStop="False"
                                          Interval="50">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <Path x:Name="VerticalSmallDecreaseArrow"
                                                  Width="14" Height="8"
                                                  Stretch="Uniform"
                                                  Fill="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,8 L 7,0 L 14,8 Z" />
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>

                            <!-- Invisible Page-Up Track Area -->
                            <RepeatButton x:Name="VerticalLargeDecrease"
                                          Grid.Row="1"
                                          Height="0"
                                          Opacity="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsTabStop="False"
                                          Interval="50" />

                            <!-- Draggable Thumb (Change Background for thumb color) -->
                            <Thumb x:Name="VerticalThumb"
                                   Grid.Row="2"
                                   MinHeight="24"
                                   Margin="1,0,0,0"
                                   HorizontalAlignment="Stretch">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource ScrollBarThumbBrush}"
                                                CornerRadius="4"
                                                Margin="2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                            <!-- Invisible Page-Down Track Area -->
                            <RepeatButton x:Name="VerticalLargeIncrease"
                                          Grid.Row="3"
                                          Opacity="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsTabStop="False"
                                          Interval="50" />

                            <!-- Bottom Arrow Button (Change Background for button, Foreground for arrow icon) -->
                            <RepeatButton x:Name="VerticalSmallIncrease"
                                          Grid.Row="4"
                                          Height="26"
                                          Width="28"
                                          Margin="0,0,1,1"
                                          HorizontalAlignment="Stretch"
                                          Background="{StaticResource ScrollBarButtonBackgroundBrush}"
                                          Foreground="{StaticResource ScrollBarButtonForegroundBrush}"
                                          IsTabStop="False"
                                          Interval="50">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <Path x:Name="VerticalSmallIncreaseArrow"
                                                  Width="14" Height="8"
                                                  Stretch="Uniform"
                                                  Fill="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,0 L 7,8 L 14,0 Z" />
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>

                        <!-- HORIZONTAL SCROLLBAR FALLBACK -->
                        <Grid x:Name="HorizontalRoot"
                              Visibility="Collapsed"
                              Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" Width="18" IsTabStop="False" Content="◀" />
                            <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Width="0" Opacity="0" IsTabStop="False" />
                            <Thumb x:Name="HorizontalThumb" Grid.Column="2" MinWidth="20" Background="{StaticResource ScrollBarThumbBrush}" />
                            <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" Opacity="0" IsTabStop="False" />
                            <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Width="18" IsTabStop="False" Content="▶" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
