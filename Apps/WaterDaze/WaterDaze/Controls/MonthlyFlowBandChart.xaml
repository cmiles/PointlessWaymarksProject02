<UserControl x:Class="WaterDaze.Controls.MonthlyFlowBandChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="280">
    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Legend & Header -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <!-- 25-75% Band Legend Item -->
                <Rectangle Width="18" Height="10" Fill="#401F77B4" Stroke="#1F77B4" StrokeThickness="0.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="25–75% band" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center" Margin="0,0,20,0" />

                <!-- Median Line Legend Item -->
                <Grid Width="22" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Line X1="0" Y1="6" X2="22" Y2="6" Stroke="#1F77B4" StrokeThickness="2" />
                    <Ellipse Width="6" Height="6" Fill="#1F77B4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Median" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Y-Axis Ticks & Label -->
            <Grid x:Name="YAxisContainer" Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                <!-- Y-Axis Title -->
                <TextBlock Text="Flow (cfs)" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" 
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-6,0,0" />

                <!-- Dynamic Y Ticks rendered in code -->
                <Canvas x:Name="YAxisCanvas" />
            </Grid>

            <!-- Main Chart Area -->
            <Grid x:Name="ChartGrid" Grid.Row="1" Grid.Column="1">
                <Canvas x:Name="GridLinesCanvas" Background="Transparent" />
                <Canvas x:Name="ChartCanvas" Background="Transparent" />
                <Canvas x:Name="OverlayCanvas" Background="Transparent" />
            </Grid>

            <!-- X-Axis Month Labels (Jan..Dec) -->
            <Grid x:Name="XAxisGrid" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Jan" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="1" Text="Feb" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="2" Text="Mar" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="3" Text="Apr" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="4" Text="May" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="5" Text="Jun" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="6" Text="Jul" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="7" Text="Aug" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="8" Text="Sep" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="9" Text="Oct" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="10" Text="Nov" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                <TextBlock Grid.Column="11" Text="Dec" HorizontalAlignment="Center" FontSize="11" Foreground="#6B7280" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
