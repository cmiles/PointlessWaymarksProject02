<ResourceDictionary x:Class="WaterDaze.Themes.LightTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core App Surfaces & Text -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SubtleCardBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SubtleCardBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextHeadingBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="TextLabelBrush" Color="#374151" />

    <!-- Links & Accents -->
    <SolidColorBrush x:Key="HyperlinkBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SiteCodeBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="FlowDaysBrush" Color="#059669" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundBrush" Color="#FFE7E8E9" />
    <SolidColorBrush x:Key="ScrollBarButtonForegroundBrush" Color="#FFC9C9C9" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FFC9C9C9" />

    <!-- Status Banners -->
    <SolidColorBrush x:Key="WarningBannerBackgroundBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarningBannerBorderBrush" Color="#FCD34D" />
    <SolidColorBrush x:Key="WarningBannerTextBrush" Color="#92400E" />

    <SolidColorBrush x:Key="ErrorBannerBackgroundBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="ErrorBannerBorderBrush" Color="#FECACA" />
    <SolidColorBrush x:Key="ErrorBannerTextBrush" Color="#DC2626" />

    <!-- Loading Overlay -->
    <SolidColorBrush x:Key="LoadingOverlayBackgroundBrush" Color="#66000000" />
    <SolidColorBrush x:Key="LoadingCardBackgroundBrush" Color="#D9DBEAFE" />
    <SolidColorBrush x:Key="LoadingCardBorderBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="LoadingCardTextBrush" Color="#1D4ED8" />

    <!-- Rankings Section -->
    <SolidColorBrush x:Key="RankingWetStreaksTitleBrush" Color="#047857" />
    <SolidColorBrush x:Key="RankingDryStreaksTitleBrush" Color="#B45309" />
    <SolidColorBrush x:Key="RankingAnnualMeanTitleBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="RankingPeakFlowTitleBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="RankingWettestHeaderBrush" Color="#059669" />
    <SolidColorBrush x:Key="RankingDriestHeaderBrush" Color="#D97706" />

    <!-- Chart: Monthly Flow Band -->
    <SolidColorBrush x:Key="ChartGridLineBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="ChartBandFillBrush" Color="#321F77B4" />
    <SolidColorBrush x:Key="ChartBandBorderBrush" Color="#641F77B4" />
    <SolidColorBrush x:Key="ChartMedianLineBrush" Color="#1F77B4" />
    <SolidColorBrush x:Key="ChartMarkerFillBrush" Color="#1F77B4" />
    <SolidColorBrush x:Key="ChartMarkerStrokeBrush" Color="#FFFFFF" />

    <!-- Heatmap Matrix -->
    <SolidColorBrush x:Key="HeatmapNoDataBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="HeatmapCellBorderBrush" Color="#EBEEF2" />
    <SolidColorBrush x:Key="HeatmapHeaderTextBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="HeatmapLegendBorderBrush" Color="#D1D5DB" />

    <!-- Year Facet Mini Sparklines -->
    <SolidColorBrush x:Key="YearFacetCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="YearFacetCardBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="YearFacetTextBrush" Color="#707070" />
    <SolidColorBrush x:Key="YearFacetBarBrush" Color="#B4C8C8C8" />
    <SolidColorBrush x:Key="YearFacetLineBrush" Color="#3366CC" />

</ResourceDictionary>
