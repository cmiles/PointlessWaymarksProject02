<Application
    x:Class="PwImageMetadataViewer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:PwImageMetadataViewer.Themes"
    xmlns:mt="http://opensilver.net/themes/modern"
    xmlns:local="clr-namespace:PwImageMetadataViewer">
    <Application.Theme>
        <mt:ModernTheme>
            <mt:ModernTheme.LightPalette>
                <mt:LightPalette PrimaryColor="#84a7fe" />
            </mt:ModernTheme.LightPalette>
            <mt:ModernTheme.DarkPalette>
                <mt:DarkPalette PrimaryColor="#3B82F6" />
            </mt:ModernTheme.DarkPalette>
        </mt:ModernTheme>
    </Application.Theme>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:LightTheme />
            </ResourceDictionary.MergedDictionaries>

            <!-- Application Typography Styles & Defaults -->
            <!-- Section Header Style -->
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextHeadingBrush}" />
            </Style>

            <!-- Card Title Style -->
            <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextHeadingBrush}" />
            </Style>

            <!-- Metadata / Field Eyebrow Label Style -->
            <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            </Style>

            <!-- Primary Data Value Style -->
            <Style x:Key="PrimaryDataValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <!-- Standard Data Value Style -->
            <Style x:Key="StandardDataValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <!-- Accent Data Value Style -->
            <Style x:Key="AccentDataValueTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource HyperlinkBrush}" />
            </Style>

            <!-- Monospace Metadata Tag Key Style -->
            <Style x:Key="MonoTagKeyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
            </Style>

            <!-- Badge / Pill Text Style -->
            <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
