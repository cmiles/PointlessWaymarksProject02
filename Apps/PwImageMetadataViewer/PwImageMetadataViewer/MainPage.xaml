<Page x:Class="PwImageMetadataViewer.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PwImageMetadataViewer"
      xmlns:controls="clr-namespace:PwImageMetadataViewer.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Foreground="{StaticResource TextPrimaryBrush}"
      FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Page.Resources>
        <!-- Wide Screen 3-Column Table Row Template -->
        <DataTemplate x:Key="WideTagTemplate">
            <Border BorderBrush="{Binding RowBorderBrush}" BorderThickness="0,0,0,1" Padding="16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Group Badge -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="{Binding GroupBadgeBackground}" BorderBrush="{Binding GroupBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Group}" Style="{StaticResource BadgeTextStyle}" Foreground="{Binding GroupBadgeForeground}"/>
                        </Border>
                    </StackPanel>

                    <!-- Tag Name (monospace) -->
                    <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="{Binding TagForeground}" Style="{StaticResource MonoTagKeyTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>

                    <!-- Value -->
                    <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding ValueForeground}" Style="{StaticResource StandardDataValueTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Small Screen Collapsed Card Template (Group, Tag Name, Value stacked under each other) -->
        <DataTemplate x:Key="SmallScreenTagTemplate">
            <Border BorderBrush="{Binding RowBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <StackPanel>
                    <!-- 1. Group Badge -->
                    <Border Background="{Binding GroupBadgeBackground}" BorderBrush="{Binding GroupBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Margin="0,0,0,5">
                        <TextBlock Text="{Binding Group}" Style="{StaticResource BadgeTextStyle}" Foreground="{Binding GroupBadgeForeground}"/>
                    </Border>

                    <!-- 2. Tag Name -->
                    <TextBlock Text="{Binding Tag}" Foreground="{Binding TagForeground}" Style="{StaticResource MonoTagKeyTextStyle}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <!-- 3. Value -->
                    <TextBlock Text="{Binding Value}" Foreground="{Binding ValueForeground}" Style="{StaticResource StandardDataValueTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootLayoutGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Status / Notification Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main Scrollable Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border x:Name="TopHeaderBorder" Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <!-- WIDE SCREEN HEADER (>= 850px) -->
                <controls:WrapPanel x:Name="PnlWideHeader" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand & Title Block -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,6">
                        <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Image Metadata Viewer - " FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                            <HyperlinkButton x:Name="LnkAuthor" Content="Charles Miles" NavigateUri="https://cmiles.info" TargetName="_blank"
                                             Click="Hyperlink_Click"
                                             FontSize="15" FontWeight="Bold" Foreground="{StaticResource HyperlinkBrush}"
                                             Padding="0" Margin="0" Cursor="Hand" VerticalAlignment="Center"/>
                        </controls:WrapPanel>
                        <TextBlock x:Name="TxtCurrentFileName" Text="1510-Rama-Shrine-from-the-Grandview-Trail.jpg" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <controls:WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <Button x:Name="BtnOpenFile" Click="BtnOpenFile_Click" FontWeight="SemiBold" FontSize="13.5" Padding="14,8" Margin="0,0,8,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " FontSize="13.5"/>
                                <TextBlock Text="Open Image..." FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnExportJson" Click="BtnExportJson_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" Margin="0,0,8,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="13.5"/>
                                <TextBlock Text="Copy JSON"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAbout" Click="BtnAbout_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" Margin="0,0,0,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️ " FontSize="13.5"/>
                                <TextBlock Text="About"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" Width="145" HorizontalContentAlignment="Center" FontWeight="SemiBold" FontSize="13.5" Padding="6,8" Margin="8,0,0,6" Cursor="Hand" ToolTipService.ToolTip="Toggle theme (System / Dark / Light)">
                            <TextBlock x:Name="TxtThemeToggle" Text="🌓 Theme" HorizontalAlignment="Center"/>
                        </Button>

                        <Button x:Name="BtnUpdates" Click="BtnUpdates_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" Margin="8,0,0,6" Cursor="Hand" ToolTipService.ToolTip="Check online catalog for software updates">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 " FontSize="13.5"/>
                                <TextBlock Text="Updates"/>
                            </StackPanel>
                        </Button>
                    </controls:WrapPanel>
                </controls:WrapPanel>

                <!-- SMALL SCREEN COLLAPSED HEADER (< 850px) -->
                <StackPanel x:Name="PnlSmallHeader" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Collapsed Title & Author -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="Metadata Viewer" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtSmallAuthor" Text="Charles Miles" FontSize="11" Foreground="{StaticResource HyperlinkBrush}" FontWeight="SemiBold" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Hamburger Menu Button -->
                        <Button x:Name="BtnHamburgerMenu" Grid.Column="1" Click="BtnHamburgerMenu_Click" CornerRadius="6" Padding="10,6" Cursor="Hand" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHamburgerIcon" Text="☰" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Collapsible Hamburger Menu Dropdown -->
                    <Border x:Name="PnlHamburgerDropdown" Visibility="Collapsed" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Current Loaded File -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="CURRENT FILE" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtMobileCurrentFileName" Text="1510-Rama-Shrine-from-the-Grandview-Trail.jpg" FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Mobile Action Buttons -->
                            <Button x:Name="BtnMobileOpenFile" Click="BtnMobileOpenFile_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📂 " FontSize="13.5"/>
                                    <TextBlock Text="Open Image..." FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnMobileExportJson" Click="BtnMobileExportJson_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📋 " FontSize="13.5"/>
                                    <TextBlock Text="Copy JSON"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnMobileAbout" Click="BtnMobileAbout_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="ℹ️ " FontSize="13.5"/>
                                    <TextBlock Text="About"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnMobileThemeToggle" Click="BtnMobileThemeToggle_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Stretch" Cursor="Hand">
                                <TextBlock x:Name="TxtMobileThemeToggle" Text="🌓 Theme" HorizontalAlignment="Center"/>
                            </Button>

                            <Button x:Name="BtnMobileUpdates" Click="BtnMobileUpdates_Click" FontWeight="SemiBold" FontSize="13.5" Padding="12,8" HorizontalAlignment="Stretch" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🚀 " FontSize="13.5"/>
                                    <TextBlock Text="Check for Updates"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- STATUS / ERROR BANNER -->
        <Border x:Name="StatusBannerBorder" Grid.Row="1" Background="{StaticResource StatusBannerBackgroundBrush}" BorderBrush="{StaticResource StatusBannerBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatusIcon" Grid.Column="0" Text="ℹ️ " FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <TextBox x:Name="TxtStatusMessage" Grid.Column="1" Text="Extracting metadata with WebAssembly ExifTool..." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource StatusBannerTextBrush}" VerticalAlignment="Center" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>

                <Button x:Name="BtnCopyError" Grid.Column="2" Click="BtnCopyError_Click" FontWeight="SemiBold" FontSize="13" Padding="10,4" Margin="12,0,0,0" Cursor="Hand" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋 " FontSize="13"/>
                        <TextBlock x:Name="BtnCopyErrorText" Text="Copy Error" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN SCROLLABLE CONTENT -->
        <controls:ResponsiveScrollViewer x:Name="MainScrollViewer" Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MainContentStackPanel" Background="Transparent" Margin="24,20,24,32">

                <!-- TOP HERO SECTION: Preview Card + Camera Specs Card + Attribution Card (3 Equal Blocks) -->
                <Grid x:Name="HeroSectionGrid" Background="Transparent" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <!-- Image Preview Column -->
                        <ColumnDefinition Width="*"/>
                        <!-- Camera & Exposure Specs Column -->
                        <ColumnDefinition Width="*"/>
                        <!-- Attribution, Copyright & Tags Column -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. IMAGE PREVIEW CARD -->
                    <Border x:Name="PreviewCardBorder" Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Image Preview" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,12"/>

                            <!-- Container for Preview (dual native OpenSilver Image and robust DOM mounting) -->
                            <Border x:Name="ImagePreviewContainer" Grid.Row="1" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="8" Height="250" MinHeight="250">
                                <Grid>
                                    <!-- Native OpenSilver Image control -->
                                    <Image x:Name="ImgPreview" MaxHeight="240" MaxWidth="308" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <!-- Fallback text shown before image loads -->
                                    <TextBlock x:Name="TxtPreviewPlaceholder" Text="Preview Loading..." FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Dimension & format pills -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtDimensionBadge" Text="-- x --" Style="{StaticResource BadgeTextStyle}" Foreground="{StaticResource HyperlinkBrush}"/>
                                </Border>
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2.5" Margin="0,0,6,0">
                                    <TextBlock x:Name="TxtMegapixelBadge" Text="-- MP" Style="{StaticResource BadgeTextStyle}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2.5">
                                    <TextBlock x:Name="TxtFileTypeBadge" Text="--" Style="{StaticResource BadgeTextStyle}" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. CAMERA & EXPOSURE SPECS CARD -->
                    <Border x:Name="SpecsCardBorder" Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="Camera &amp; Shooting Data" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,14"/>

                            <!-- Camera Model -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="CAMERA" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtCameraModel" Text="--" Style="{StaticResource PrimaryDataValueTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Lens Model -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="LENS" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtLensModel" Text="--" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Date & Time Taken -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="DATE TAKEN" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock x:Name="TxtDateTimeTaken" Text="--" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Exposure Specs Blocks (WrapPanel wraps on small screens) -->
                            <controls:WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <!-- Shutter Speed Block -->
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,8" MinWidth="70">
                                    <StackPanel>
                                        <TextBlock Text="SHUTTER" Style="{StaticResource FieldLabelTextStyle}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtShutter" Text="--" Style="{StaticResource AccentDataValueTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Aperture Block -->
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,8" MinWidth="70">
                                    <StackPanel>
                                        <TextBlock Text="APERTURE" Style="{StaticResource FieldLabelTextStyle}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtAperture" Text="--" Style="{StaticResource AccentDataValueTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ISO Block -->
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,8" MinWidth="70">
                                    <StackPanel>
                                        <TextBlock Text="ISO" Style="{StaticResource FieldLabelTextStyle}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtIso" Text="--" Style="{StaticResource AccentDataValueTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Focal Length Block -->
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,8" MinWidth="70">
                                    <StackPanel>
                                        <TextBlock Text="FOCAL" Style="{StaticResource FieldLabelTextStyle}" FontSize="10.5"/>
                                        <TextBlock x:Name="TxtFocalLength" Text="--" Style="{StaticResource AccentDataValueTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </controls:WrapPanel>

                            <!-- File Details Footer -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Size: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtFileSize" Text="--" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock Text="MIME: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtMimeType" Text="--" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. ATTRIBUTION, COPYRIGHT & CAPTION CARD -->
                    <Border x:Name="AttributionCardBorder" Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Section Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Attribution &amp; Copyright" Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                    <TextBlock Text="IPTC / XMP" Style="{StaticResource BadgeTextStyle}" Foreground="{StaticResource HyperlinkBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Metadata Fields List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                                <StackPanel>
                                    <!-- Artist / Creator -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="ARTIST / CREATOR" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBlock x:Name="TxtArtist" Text="--" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Copyright / Rights -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="COPYRIGHT / RIGHTS" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBlock x:Name="TxtCopyright" Text="--" Style="{StaticResource StandardDataValueTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Attribution / Credit / Source -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="CREDIT / ATTRIBUTION" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBlock x:Name="TxtCredit" Text="--" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Caption / Description -->
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="CAPTION / DESCRIPTION" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBlock x:Name="TxtCaption" Text="--" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Tags / Keywords -->
                                    <StackPanel Margin="0,0,0,4">
                                        <TextBlock Text="TAGS / KEYWORDS" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBlock x:Name="TxtKeywords" Text="--" Style="{StaticResource AccentDataValueTextStyle}" FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- LOCATION & LEAFLET MAP CARD (Full Width & Taller) -->
                <Border x:Name="GpsCardBorder" Visibility="Collapsed" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,24" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- GPS Header & Coordinates -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Location &amp; Map" Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCoordinatesSummary" Text="No GPS Data" Style="{StaticResource AccentDataValueTextStyle}" FontSize="13" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtAltitudeSummary" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Map Container / Placeholder -->
                        <Grid Grid.Row="1" MinHeight="380" Height="380">
                            <!-- Leaflet Map container (populated via JS #pw-leaflet-map) -->
                            <Border x:Name="MapContainerBorder" CornerRadius="8" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1">
                                <!-- Fallback message shown when no GPS is available -->
                                <StackPanel x:Name="PnlNoGpsPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                    <TextBlock Text="📍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="No Location Data in Image" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="This image does not contain embedded GPS coordinates." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Map Action Buttons (OpenStreetMap & PeakFinderWeb) -->
                        <controls:WrapPanel x:Name="PnlMapActions" Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                            <Button x:Name="BtnOpenOsm" Click="BtnOpenOsm_Click" FontWeight="SemiBold" FontSize="13" Padding="12,6" Margin="0,0,8,6" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗺️ " FontSize="13"/>
                                    <TextBlock Text="OpenStreetMap" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnOpenPeakFinder" Click="BtnOpenPeakFinder_Click" FontWeight="SemiBold" FontSize="13" Padding="12,6" Margin="0,0,0,6" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏔️ " FontSize="13"/>
                                    <TextBlock Text="PeakFinderWeb" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </controls:WrapPanel>
                    </Grid>
                </Border>

                <!-- METADATA TAGS SECTION -->
                <Border x:Name="TagsSectionBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <!-- Section Header & Search Box (Wraps on small screens) -->
                        <controls:WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <!-- Section Title & Count -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                <TextBlock Text="Metadata Tags" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="10,0,0,0" Padding="8,2.5" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTagCount" Text="0 tags" Style="{StaticResource BadgeTextStyle}" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Search Filter Box -->
                            <Border Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2" MinWidth="220" MaxWidth="320" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍 " FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                    <TextBox x:Name="TxtSearchQuery" Grid.Column="1" TextChanged="TxtSearchQuery_TextChanged" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13.5" Padding="4,4"/>
                                </Grid>
                            </Border>
                        </controls:WrapPanel>

                        <!-- Group Filter Chips (Wide Screens >= 850px) -->
                        <controls:WrapPanel x:Name="PnlCategoryChips" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="BtnFilterAll" Click="BtnFilter_Click" Tag="All" FontSize="12" FontWeight="Bold" Padding="11,5" Margin="0,0,6,6" Cursor="Hand">
                                <TextBlock Text="All Tags" FontWeight="Bold"/>
                            </Button>
                            <Button x:Name="BtnFilterExif" Click="BtnFilter_Click" Tag="EXIF" FontSize="12" FontWeight="SemiBold" Padding="11,5" Margin="0,0,6,6" Cursor="Hand">
                                <TextBlock Text="Camera / EXIF"/>
                            </Button>
                            <Button x:Name="BtnFilterFile" Click="BtnFilter_Click" Tag="File" FontSize="12" FontWeight="SemiBold" Padding="11,5" Margin="0,0,6,6" Cursor="Hand">
                                <TextBlock Text="File &amp; Image"/>
                            </Button>
                            <Button x:Name="BtnFilterGps" Click="BtnFilter_Click" Tag="GPS" FontSize="12" FontWeight="SemiBold" Padding="11,5" Margin="0,0,6,6" Cursor="Hand">
                                <TextBlock Text="GPS / Location"/>
                            </Button>
                            <Button x:Name="BtnFilterComposite" Click="BtnFilter_Click" Tag="Composite" FontSize="12" FontWeight="SemiBold" Padding="11,5" Margin="0,0,6,6" Cursor="Hand">
                                <TextBlock Text="Composite"/>
                            </Button>
                            <Button x:Name="BtnFilterMakerNotes" Click="BtnFilter_Click" Tag="MakerNotes" FontSize="12" FontWeight="SemiBold" Padding="11,5" Margin="0,0,6,6" Cursor="Hand">
                                <TextBlock Text="MakerNotes"/>
                            </Button>
                            <Button x:Name="BtnFilterXmp" Click="BtnFilter_Click" Tag="XMP" FontSize="12" FontWeight="SemiBold" Padding="11,5" Margin="0,0,0,6" Cursor="Hand">
                                <TextBlock Text="XMP / IPTC"/>
                            </Button>
                        </controls:WrapPanel>

                        <!-- Group Filter Menu (Small Screens < 850px) -->
                        <Border x:Name="PnlCategoryMenu" Visibility="Collapsed" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,0,16">
                            <StackPanel>
                                <Button x:Name="BtnCategoryMenuToggle" Click="BtnCategoryMenuToggle_Click" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🏷️ " FontSize="13.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Category: " FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtSelectedCategoryLabel" Text="All Tags" FontSize="13" FontWeight="Bold" Foreground="{StaticResource HyperlinkBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtCategoryMenuChevron" Grid.Column="2" Text="▼" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    </Grid>
                                </Button>

                                <Border x:Name="PnlCategoryDropdownList" Visibility="Collapsed" Background="{StaticResource SubtleCardBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource SubtleCardBorderBrush}" Padding="6" Margin="0,2,0,0">
                                    <StackPanel>
                                        <Button x:Name="BtnMenuAll" Click="BtnMenuCategory_Click" Tag="All" BorderThickness="0" Padding="10,8" Margin="0,0,0,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="🌐  All Tags" FontSize="13" HorizontalAlignment="Left"/>
                                        </Button>
                                        <Button x:Name="BtnMenuExif" Click="BtnMenuCategory_Click" Tag="EXIF" BorderThickness="0" Padding="10,8" Margin="0,0,0,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="📷  Camera / EXIF" FontSize="13" HorizontalAlignment="Left"/>
                                        </Button>
                                        <Button x:Name="BtnMenuFile" Click="BtnMenuCategory_Click" Tag="File" BorderThickness="0" Padding="10,8" Margin="0,0,0,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="📁  File &amp; Image" FontSize="13" HorizontalAlignment="Left"/>
                                        </Button>
                                        <Button x:Name="BtnMenuGps" Click="BtnMenuCategory_Click" Tag="GPS" BorderThickness="0" Padding="10,8" Margin="0,0,0,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="📍  GPS / Location" FontSize="13" HorizontalAlignment="Left"/>
                                        </Button>
                                        <Button x:Name="BtnMenuComposite" Click="BtnMenuCategory_Click" Tag="Composite" BorderThickness="0" Padding="10,8" Margin="0,0,0,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="🧩  Composite" FontSize="13" HorizontalAlignment="Left"/>
                                        </Button>
                                        <Button x:Name="BtnMenuMakerNotes" Click="BtnMenuCategory_Click" Tag="MakerNotes" BorderThickness="0" Padding="10,8" Margin="0,0,0,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="⚙️  MakerNotes" FontSize="13" HorizontalAlignment="Left"/>
                                        </Button>
                                        <Button x:Name="BtnMenuXmp" Click="BtnMenuCategory_Click" Tag="XMP" BorderThickness="0" Padding="10,8" HorizontalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="🏷️  XMP / IPTC" FontSize="13" HorizontalAlignment="Left"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tags Table Header (Visible on Wide Screens >= 850px) -->
                        <Border x:Name="TableHeaderBorder" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GROUP" Style="{StaticResource FieldLabelTextStyle}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="TAG NAME" Style="{StaticResource FieldLabelTextStyle}" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="VALUE" Style="{StaticResource FieldLabelTextStyle}" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Tags Items List -->
                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" MinHeight="180">
                            <ItemsControl x:Name="TagsItemsControl" ItemTemplate="{StaticResource WideTagTemplate}"/>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </controls:ResponsiveScrollViewer>

        <!-- FLOATING IN-APP ABOUT WINDOW OVERLAY -->
        <Grid x:Name="AboutOverlayGrid" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#80000000" Canvas.ZIndex="900">
            <controls:AboutWindowControl x:Name="AboutWindow" MaxWidth="680" MaxHeight="540" Margin="16"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- FLOATING IN-APP UPDATE WINDOW OVERLAY -->
        <Grid x:Name="UpdateWindowOverlayGrid" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
              Background="#80000000" Canvas.ZIndex="950">
            <controls:AppUpdateWindowControl x:Name="UpdateWindowControlElement" MaxWidth="600" MaxHeight="480" Margin="16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
