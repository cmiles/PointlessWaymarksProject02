<UserControl x:Class="PwImageMetadataViewer.Controls.AppUpdateWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="580">

    <Border x:Name="WindowRootBorder" Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10"
            MaxWidth="580" MaxHeight="450">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="#0F172A" CornerRadius="9,9,0,0" Padding="16,12" 
                    BorderBrush="#334155" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderTitleText" Text="Image Metadata Viewer Update Available" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnCloseHeader" Grid.Column="1" Content="✕" Command="{Binding CloseUpdateWindowCommand}" Click="Dismiss_Click"
                            IsEnabled="{Binding IsNotDownloadingUpdate}"
                            Background="#334155" Foreground="#E2E8F0" BorderThickness="0" CornerRadius="4"
                            Width="26" Height="26" Padding="0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Scrollable Body Content -->
            <ScrollViewer x:Name="BodyScrollViewer" Grid.Row="1" Background="#0B1120" Padding="18,14"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <!-- Main announcement card -->
                    <Border x:Name="MainCardBorder" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="UpdateStatusTextBlock" Text="{Binding UpdateStatusMessage, FallbackValue='A newer version of Pointless Waymarks Image Metadata Viewer is available.'}" 
                                       FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10"/>

                            <!-- Versions Comparison Box -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Current Version -->
                                <Border x:Name="CurrentVersionBox" Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="CurrentVersionLabelText" Text="CURRENT VERSION" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="CurrentVersionValueText" Text="{Binding UpdateCurrentVersion, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Arrow Indicator -->
                                <TextBlock x:Name="VersionArrowText" Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                                <!-- New Version -->
                                <Border x:Name="NewVersionBox" Grid.Column="2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="NewVersionLabelText" Text="NEW VERSION" FontSize="9" FontWeight="Bold" Foreground="#A7F3D0" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="NewVersionValueText" Text="{Binding UpdateNewVersion, FallbackValue='Latest'}" FontSize="12" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Installer Info -->
                    <Border x:Name="InfoCardBorder" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="InfoPackageLabelText" Text="Installer Package: " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="InfoPackageValueText" Text="{Binding UpdateInstallerFileName, FallbackValue='PointlessWaymarks-PwImageMetadataViewerWin-Setup.exe'}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <TextBlock x:Name="InfoExplanationText" Text="When you click 'Update Now', the application will automatically download the installer, verify its checksum, launch the setup wizard, and close this app so files can update cleanly."
                                       FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress Section (Visible during download) -->
                    <Border x:Name="ProgressCardBorder" Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                            Visibility="{Binding DownloadSectionVisibility, FallbackValue='Collapsed'}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProgressStatusText" Text="{Binding DownloadOperationStatus, FallbackValue='Downloading...'}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="{Binding UpdateDownloadProgressText, FallbackValue='0%'}" 
                                           FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Grid>

                            <!-- Custom Smooth Reliable Progress Bar -->
                            <Border x:Name="ProgressBarTrack" Height="10" Background="#1E293B" CornerRadius="5" BorderBrush="#334155" BorderThickness="1" Padding="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColProgressFill" Width="0*" />
                                        <ColumnDefinition x:Name="ColProgressRemaining" Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ProgressBarFill" Grid.Column="0" Background="#0284C7" CornerRadius="4" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Error Alert (Visible on download failure) -->
                    <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding UpdateErrorVisibility, FallbackValue='Collapsed'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdateErrorMessage}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons Footer -->
            <Border x:Name="FooterBorder" Grid.Row="2" Background="#0F172A" CornerRadius="0,0,9,9" Padding="16,12" 
                    BorderBrush="#334155" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Later / Not Now -->
                    <Button x:Name="BtnDismiss" Grid.Column="0" Content="Later / Dismiss" Command="{Binding CloseUpdateWindowCommand}" Click="Dismiss_Click"
                            IsEnabled="{Binding IsNotDownloadingUpdate}"
                            Background="#334155" Foreground="#E2E8F0" BorderThickness="1" BorderBrush="#475569" CornerRadius="4"
                            Padding="12,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                    <!-- Update Now -->
                    <Button x:Name="BtnUpdate" Grid.Column="2" Content="{Binding UpdateActionButtonText, FallbackValue='Download &amp; Install Now'}" 
                            Command="{Binding StartUpdateCommand}" Click="UpdateNow_Click"
                            IsEnabled="{Binding IsNotDownloadingUpdate}"
                            Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="4"
                            Padding="14,6" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
