<ResourceDictionary x:Class="PwImageMetadataViewer.Controls.ResponsiveScrollBarDictionary"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ScrollBar">
        <!-- 1. Overall width of the vertical scrollbar -->
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <!-- 2. Track background color -->
        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <!-- VERTICAL SCROLLBAR LAYOUT -->
                        <Grid x:Name="VerticalRoot"
                              Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- TOP DECREASE ARROW BUTTON -->
                            <RepeatButton x:Name="VerticalSmallDecrease"
                                          Grid.Row="0"
                                          Height="26"
                                          Width="28"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Interval="50"
                                          Background="{StaticResource ScrollBarButtonBackgroundBrush}"
                                          BorderBrush="{TemplateBinding Background}"
                                          BorderThickness="0"
                                          Padding="0"
                                          Margin="0,3,0,1">
                                <Path x:Name="VerticalSmallDecreaseArrow"
                                      Data="M 0 6 L 6 0 L 12 6 Z"
                                      Fill="{StaticResource ScrollBarButtonForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Width="14"
                                      Height="8" />
                            </RepeatButton>

                            <!-- TOP LARGE DECREASE PAGE TRACK -->
                            <RepeatButton x:Name="VerticalLargeDecrease"
                                          Grid.Row="1"
                                          Interval="50"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsTabStop="False" />

                            <!-- THUMB -->
                            <Thumb x:Name="VerticalThumb"
                                   Grid.Row="2"
                                   MinHeight="36"
                                   HorizontalAlignment="Stretch">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="ThumbBorder"
                                                Background="{StaticResource ScrollBarThumbBrush}"
                                                CornerRadius="3"
                                                Margin="2,0,2,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                            <!-- BOTTOM LARGE INCREASE PAGE TRACK -->
                            <RepeatButton x:Name="VerticalLargeIncrease"
                                          Grid.Row="3"
                                          Interval="50"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsTabStop="False" />

                            <!-- BOTTOM INCREASE ARROW BUTTON -->
                            <RepeatButton x:Name="VerticalSmallIncrease"
                                          Grid.Row="4"
                                          Height="26"
                                          Width="28"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Interval="50"
                                          Background="{StaticResource ScrollBarButtonBackgroundBrush}"
                                          BorderBrush="{TemplateBinding Background}"
                                          BorderThickness="0"
                                          Padding="0"
                                          Margin="0,1,0,3">
                                <Path x:Name="VerticalSmallIncreaseArrow"
                                      Data="M 0 0 L 6 6 L 12 0 Z"
                                      Fill="{StaticResource ScrollBarButtonForegroundBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Width="14"
                                      Height="8" />
                            </RepeatButton>
                        </Grid>

                        <!-- HORIZONTAL SCROLLBAR LAYOUT (Default Fallback) -->
                        <Grid x:Name="HorizontalRoot" Visibility="Collapsed" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <RepeatButton x:Name="HorizontalSmallDecrease" Grid.Column="0" Width="18"
                                          Background="{StaticResource ScrollBarButtonBackgroundBrush}" BorderThickness="0" Interval="50">
                                <Path Data="M 6 0 L 0 6 L 6 12 Z" Fill="{StaticResource ScrollBarButtonForegroundBrush}" Stretch="Uniform" Width="6" Height="10" />
                            </RepeatButton>

                            <RepeatButton x:Name="HorizontalLargeDecrease" Grid.Column="1" Background="Transparent" BorderThickness="0" IsTabStop="False" />

                            <Thumb x:Name="HorizontalThumb" Grid.Column="2" MinWidth="24">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource ScrollBarThumbBrush}" CornerRadius="3" Margin="0,2,0,2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>

                            <RepeatButton x:Name="HorizontalLargeIncrease" Grid.Column="3" Background="Transparent" BorderThickness="0" IsTabStop="False" />

                            <RepeatButton x:Name="HorizontalSmallIncrease" Grid.Column="4" Width="18"
                                          Background="{StaticResource ScrollBarButtonBackgroundBrush}" BorderThickness="0" Interval="50">
                                <Path Data="M 0 0 L 6 6 L 0 12 Z" Fill="{StaticResource ScrollBarButtonForegroundBrush}" Stretch="Uniform" Width="6" Height="10" />
                            </RepeatButton>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
