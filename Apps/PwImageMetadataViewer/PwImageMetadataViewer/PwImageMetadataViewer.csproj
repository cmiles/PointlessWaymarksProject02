<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DefineSilverlight>true</DefineSilverlight>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="3.3.3" />
    <PackageReference Include="OpenSilver.Themes.Modern" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Controls\AboutWindowControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Controls\AppUpdateWindowControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Controls\ResponsiveScrollBarDictionary.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Themes\LightTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Themes\DarkTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainPage.xaml.cs" />
    <Compile Include="Controls\AboutWindowControl.xaml.cs" />
    <Compile Include="Controls\AppUpdateWindowControl.xaml.cs" />
    <Compile Include="Controls\ResponsiveScrollBarDictionary.xaml.cs" />
    <Compile Include="Controls\ResponsiveScrollViewer.cs" />
    <Compile Include="Controls\WrapPanel.cs" />
    <Compile Include="Services\LeafletScrollIsolationHelper.cs" />
    <Compile Include="Services\FlexibleStringConverter.cs" />
    <Compile Include="Services\ThemeManager.cs" />
    <Compile Include="Services\AppUpdateService.cs" />
    <Compile Include="Themes\LightTheme.xaml.cs" />
    <Compile Include="Themes\DarkTheme.xaml.cs" />
    <Compile Include="ViewModels\UpdateViewModel.cs" />
    <Compile Include="Models\MetadataItem.cs" />
    <Compile Include="Models\ImageMetadataReport.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Samples\**\*" />
  </ItemGroup>

</Project>
