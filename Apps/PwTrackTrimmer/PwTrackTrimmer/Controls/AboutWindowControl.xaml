<UserControl x:Class="PwTrackTrimmer.Controls.AboutWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="680">

    <Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="10"
            MaxWidth="680" MaxHeight="560">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="9,9,0,0" Padding="16,12" 
                    BorderBrush="#334155" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="About Pointless Waymarks Track Trimmer" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕ Close" Command="{Binding CloseAboutWindowCommand}"
                            Background="#334155" Foreground="#E2E8F0" BorderThickness="0" CornerRadius="4"
                            Padding="10,4" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" Background="#0B1120" Padding="18,14"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <!-- Written By Header Card -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Pointless Waymarks Track Trimmer" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Written by " FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="Charles Miles" NavigateUri="https://cmiles.info" TargetName="_blank"
                                                 Click="Hyperlink_Click"
                                                 FontSize="13" FontWeight="Bold" Foreground="#38BDF8" 
                                                 Padding="0" Margin="0" Cursor="Hand" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="A GPS track trimmer for FIT, GPX, and TCX files designed for geographic analysis, route editing, elevation adjustment, and file cleanup."
                                       FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Packages Section Header -->
                    <TextBlock Text="PACKAGES &amp; TECHNOLOGIES USED" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,8"/>

                    <!-- Package 1: OpenSilver -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="OpenSilver" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text=" v3.3.3" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Open-source framework enabling XAML and C# execution via WebAssembly and HTML5."
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" Content="opensilver.net ↗" NavigateUri="https://opensilver.net" TargetName="_blank"
                                             Click="Hyperlink_Click" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Package 2: Garmin FIT SDK -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Garmin.FIT.Sdk" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text=" v21.217.0" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Official Garmin SDK for parsing and encoding binary Flexible and Interoperable Data Transfer (FIT) files."
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" Content="developer.garmin.com ↗" NavigateUri="https://developer.garmin.com/fit" TargetName="_blank"
                                             Click="Hyperlink_Click" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Package 3: NetTopologySuite.IO.GPX -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="NetTopologySuite.IO.GPX" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text=" v1.1.1" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Spatial topology, GPX parsing, and Douglas-Peucker geometric simplification algorithms."
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" Content="github.com/NetTopologySuite ↗" NavigateUri="https://github.com/NetTopologySuite/NetTopologySuite.IO.GPX" TargetName="_blank"
                                             Click="Hyperlink_Click" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Package 4: Leaflet & OpenStreetMap -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Leaflet.js &amp; OpenStreetMap" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text=" v1.9.4" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Interactive web mapping engine providing responsive vector polylines, milestone markers, and tiles."
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" Content="leafletjs.com ↗" NavigateUri="https://leafletjs.com" TargetName="_blank"
                                             Click="Hyperlink_Click" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Package 5: Photino.NET -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Photino.NET" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                </StackPanel>
                                <TextBlock Text="Lightweight, cross-platform native desktop webview container for Windows, macOS, and Linux."
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" Content="tryphotino.io ↗" NavigateUri="https://www.tryphotino.io" TargetName="_blank"
                                             Click="Hyperlink_Click" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Package 6: Viewfinderpanoramas DEM -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Viewfinderpanoramas DEM" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                </StackPanel>
                                <TextBlock Text="Digital elevation model (DEM) terrain elevation tiles curated by Jonathan de Ferranti for elevation adjustments."
                                           FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <HyperlinkButton Grid.Column="1" Content="viewfinderpanoramas.org ↗" NavigateUri="http://viewfinderpanoramas.org" TargetName="_blank"
                                             Click="Hyperlink_Click" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Window Footer -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,9,9" Padding="14,10" 
                    BorderBrush="#334155" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pointless Waymarks Project" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Close" Command="{Binding CloseAboutWindowCommand}"
                            Background="#334155" Foreground="#E2E8F0" BorderThickness="0" CornerRadius="4"
                            Padding="14,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
