<UserControl x:Class="PwTrackTrimmer.Controls.AppUpdateWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="580">

    <Border x:Name="WindowRootBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource HyperlinkBrush}" BorderThickness="1.5" CornerRadius="10"
            MaxWidth="580" MaxHeight="450">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="{StaticResource SubtleCardBackgroundBrush}" CornerRadius="9,9,0,0" Padding="16,12" 
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderTitleText" Text="{Binding UpdateWindowTitle, FallbackValue='Track Trimmer Updates'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextHeadingBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnCloseHeader" Grid.Column="1" Content="✕" Command="{Binding CloseUpdateWindowCommand}" Click="Dismiss_Click"
                            IsEnabled="{Binding IsNotDownloadingUpdate}"
                            Width="26" Height="26" Padding="0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Scrollable Body Content -->
            <ScrollViewer x:Name="BodyScrollViewer" Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Padding="18,14"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <!-- Main announcement card -->
                    <Border x:Name="MainCardBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="UpdateStatusTextBlock" Text="{Binding UpdateStatusMessage, FallbackValue='A newer version of Pointless Waymarks Track Trimmer is available.'}" 
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10"/>

                            <!-- Versions Comparison Box -->
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Current Version -->
                                <Border x:Name="CurrentVersionBox" Grid.Column="0" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource SubtleCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="CurrentVersionLabelText" Text="CURRENT VERSION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="CurrentVersionValueText" Text="{Binding UpdateCurrentVersion, FallbackValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Arrow Indicator -->
                                <TextBlock x:Name="VersionArrowText" Grid.Column="1" Text="➔" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SkyAccentBrush}" 
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                                <!-- New Version -->
                                <Border x:Name="NewVersionBox" Grid.Column="2" Background="{StaticResource SubtleCardBackgroundBrush}" BorderBrush="{StaticResource EmeraldAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="NewVersionLabelText" Text="NEW VERSION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource EmeraldAccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="NewVersionValueText" Text="{Binding UpdateNewVersion, FallbackValue='Latest'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EmeraldAccentBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Installer Info -->
                    <Border x:Name="InfoCardBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding UpdateInstallerInfoVisibility, FallbackValue='Visible'}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="InfoPackageLabelText" Text="Installer Package: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="InfoPackageValueText" Text="{Binding UpdateInstallerFileName, FallbackValue='PointlessWaymarks-Setup.exe'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HyperlinkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="InfoExplanationText" Text="When you click 'Update Now', the application will automatically download the installer, verify its checksum, launch the setup wizard, and close this app so files can update cleanly."
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress Section (Visible during download) -->
                    <Border x:Name="ProgressCardBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource SkyAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                            Visibility="{Binding DownloadSectionVisibility, FallbackValue='Collapsed'}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProgressStatusText" Text="{Binding DownloadOperationStatus, FallbackValue='Downloading...'}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SkyAccentBrush}"/>
                                <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="{Binding UpdateDownloadProgressText, FallbackValue='0%'}" 
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource SkyAccentBrush}"/>
                            </Grid>

                            <!-- Custom Smooth Reliable Progress Bar -->
                            <Border x:Name="ProgressBarTrack" Height="10" Background="{StaticResource SubtleCardBackgroundBrush}" CornerRadius="5" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColProgressFill" Width="0*" />
                                        <ColumnDefinition x:Name="ColProgressRemaining" Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ProgressBarFill" Grid.Column="0" Background="{StaticResource SkyAccentBrush}" CornerRadius="4" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Error Alert (Visible on download failure) -->
                    <Border Background="#450A0A" BorderBrush="{StaticResource RedAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding UpdateErrorVisibility, FallbackValue='Collapsed'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdateErrorMessage}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons Footer -->
            <Border x:Name="FooterBorder" Grid.Row="2" Background="{StaticResource SubtleCardBackgroundBrush}" CornerRadius="0,0,9,9" Padding="16,12" 
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Later / Not Now -->
                    <Button x:Name="BtnDismiss" Grid.Column="0" Content="{Binding UpdateDismissButtonText, FallbackValue='Close'}" Command="{Binding CloseUpdateWindowCommand}" Click="Dismiss_Click"
                            IsEnabled="{Binding IsNotDownloadingUpdate}"
                            Padding="12,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                    <!-- Update Now -->
                    <Button x:Name="BtnUpdate" Grid.Column="2" Content="{Binding UpdateActionButtonText, FallbackValue='Download &amp; Install Now'}" 
                            Command="{Binding StartUpdateCommand}" Click="UpdateNow_Click"
                            IsEnabled="{Binding IsNotDownloadingUpdate}"
                            Visibility="{Binding UpdateButtonVisibility, FallbackValue='Visible'}"
                            Background="{StaticResource SkyAccentBrush}" Foreground="#FFFFFF"
                            Padding="16,6" FontSize="11" FontWeight="Bold" Cursor="Hand"
                            ToolTipService.ToolTip="Download and launch the latest installer"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
