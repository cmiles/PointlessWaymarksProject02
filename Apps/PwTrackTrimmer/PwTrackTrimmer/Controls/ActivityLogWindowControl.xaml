<UserControl x:Class="PwTrackTrimmer.Controls.ActivityLogWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">

    <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8"
            Effect="{x:Null}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Window Header -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="8,8,0,0" Padding="14,10" 
                    BorderBrush="#334155" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋 Activity &amp; Progress Log" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                        <Border Background="#0369A1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Logs.Messages.Count, FallbackValue='0'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}"
                                Background="#334155" Foreground="#F1F5F9" BorderThickness="0" CornerRadius="4"
                                Padding="10,4" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Content="✕ Close" Command="{Binding ToggleLogWindowCommand}"
                                Background="#475569" Foreground="#F1F5F9" BorderThickness="0" CornerRadius="4"
                                Padding="10,4" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Scrolling Message List -->
            <ListBox Grid.Row="1" x:Name="MessagesListBox"
                     ItemsSource="{Binding Logs.Messages}"
                     Background="#090D16" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="0" Text="{Binding TimeFormatted}" 
                                           FontFamily="Consolas, monospace" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                                <!-- Badge (Level) -->
                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LevelBadge}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>

                                <!-- Category -->
                                <Border Grid.Column="2" Background="#0F172A" CornerRadius="3" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#94A3B8"/>
                                </Border>

                                <!-- Message Text -->
                                <TextBlock Grid.Column="3" Text="{Binding Message}" 
                                           FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Window Footer -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,8,8" Padding="12,6" 
                    BorderBrush="#334155" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Live stream of file I/O, calculations, waypoint moves, and map events" 
                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Circular buffer (500 max)" FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
