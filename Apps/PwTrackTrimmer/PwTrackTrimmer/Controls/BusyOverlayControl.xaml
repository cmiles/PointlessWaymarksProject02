<UserControl x:Class="PwTrackTrimmer.Controls.BusyOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <!-- Full-Screen Semi-Transparent Overlay Backdrop -->
    <Grid Background="#E0070B14">
        <!-- Center Modal Card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1.5"
                CornerRadius="12" Width="640" MaxHeight="520" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header with Activity Pulse & Title -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="11,11,0,0" Padding="20,16"
                        BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Spinner / Glow Icon -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#0369A1" Margin="0,0,14,0">
                            <TextBlock Text="⚡" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BusyTitle, FallbackValue='Processing Operation...'}" 
                                       FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{Binding BusyStatus, FallbackValue='Please wait while operation completes...'}" 
                                       FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Animated pill badge -->
                        <Border Grid.Column="2" Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" 
                                CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="WORKING" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Live Stream of Progress Messages (Console Box) -->
                <Border Grid.Row="1" Background="#060911" Margin="16,14,16,10" CornerRadius="6" 
                        BorderBrush="#1E293B" BorderThickness="1" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Terminal Title Bar -->
                        <Border Grid.Row="0" Background="#0F172A" Padding="8,4" CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,5,0"/>
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,5,0"/>
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Live Progress Log" FontSize="11" Foreground="#94A3B8" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Logs.Messages.Count, StringFormat='{}{0} messages'}" FontSize="10" Foreground="#64748B"/>
                            </Grid>
                        </Border>

                        <!-- Messages List -->
                        <ListBox Grid.Row="1" x:Name="OverlayLogListBox"
                                 ItemsSource="{Binding Logs.Messages}"
                                 Background="Transparent" BorderThickness="0" Height="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#111827" BorderThickness="0,0,0,1" Padding="6,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeFormatted}" 
                                                       FontFamily="Consolas, monospace" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LevelBadge}" 
                                                       FontFamily="Consolas, monospace" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" 
                                                       FontFamily="Consolas, monospace" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Footer with Dismiss Option -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,11,11" Padding="16,10"
                        BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Operations block the interface to ensure data consistency" 
                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Run in Background" Command="{Binding DismissOverlayCommand}"
                                Background="#334155" Foreground="#F1F5F9" BorderThickness="0" CornerRadius="4"
                                Padding="12,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
