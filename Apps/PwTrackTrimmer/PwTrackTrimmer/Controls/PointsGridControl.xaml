<UserControl x:Class="PwTrackTrimmer.Controls.PointsGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="360">

    <Border x:Name="RootBorder" Background="#1E293B" BorderBrush="#334155" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Panel Header -->
            <Border Grid.Row="0" Background="#0F172A" Padding="12,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TRACK POINTS" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC"/>
                        <Border Background="#334155" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Document.Points.Count, FallbackValue='0'}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1" Content="{Binding DeleteButtonText, FallbackValue='Delete Selected'}" Command="{Binding DeleteSelectedCommand}"
                            Background="#991B1B" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" CornerRadius="4"
                            FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Column Headers -->
            <Border Grid.Row="1" Background="#0F172A" Padding="8,6" BorderBrush="#334155" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" Text="TIME" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="2" Text="ELE (FT)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="3" Text="DIST (MI)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Grid.Column="4" Text="DEL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Paged Points List (100 items per page for instant 60 FPS performance) -->
            <ListBox Grid.Row="2" x:Name="PointsListBox"
                     ItemsSource="{Binding PagedPoints}" 
                     SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding RowBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6" Cursor="Hand" Background="{Binding RowBackground}"
                                MouseLeftButtonDown="Row_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>

                                <!-- Index -->
                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0}'}" 
                                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                <!-- Time -->
                                <TextBlock Grid.Column="1" Text="{Binding TimeFormatted}" 
                                           FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                                <!-- Elevation -->
                                <TextBlock Grid.Column="2" Text="{Binding ElevationFormatted}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>

                                <!-- Distance -->
                                <TextBlock Grid.Column="3" Text="{Binding DistanceMilesFormatted}" 
                                           FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>

                                <!-- Delete Row Button -->
                                <Button Grid.Column="4" Content="✕" Click="DeleteRow_Click" Tag="{Binding}"
                                        Background="#334155" Foreground="#F87171" BorderThickness="0" CornerRadius="3"
                                        Width="22" Height="22" FontSize="11" FontWeight="Bold" Padding="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Pagination Navigation Footer -->
            <Border Grid.Row="3" Background="#0F172A" Padding="8,6" BorderBrush="#334155" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Prev, Page Info, Next, Selected -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Prev Button -->
                        <Button Grid.Column="0" Content="◀ Prev" Command="{Binding PrevPageCommand}"
                                Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                Padding="8,4" CornerRadius="4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                        <!-- Page Info -->
                        <TextBlock Grid.Column="1" Text="{Binding PageInfoText}" 
                                   FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Next Button -->
                        <Button Grid.Column="2" Content="Next ▶" Command="{Binding NextPageCommand}"
                                Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                Padding="8,4" CornerRadius="4" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>

                        <!-- Jump To Selected -->
                        <Button Grid.Column="3" Content="📍 Selected" Command="{Binding JumpToSelectedCommand}"
                                Background="#0369A1" Foreground="White" BorderThickness="0"
                                Padding="8,4" CornerRadius="4" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>

                    <!-- Bottom Row: Quick Page Size Switcher -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,2">
                        <TextBlock Text="SHOW:" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="100" Command="{Binding SetPageSizeCommand}" CommandParameter="100"
                                Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                Padding="6,2" CornerRadius="3" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Content="200" Command="{Binding SetPageSizeCommand}" CommandParameter="200"
                                Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                Padding="6,2" CornerRadius="3" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Content="250" Command="{Binding SetPageSizeCommand}" CommandParameter="250"
                                Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                Padding="6,2" CornerRadius="3" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Content="500" Command="{Binding SetPageSizeCommand}" CommandParameter="500"
                                Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                Padding="6,2" CornerRadius="3" FontSize="10" FontWeight="SemiBold" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button Content="1000" Command="{Binding SetPageSizeCommand}" CommandParameter="1000"
                                Background="#1E293B" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1"
                                Padding="6,2" CornerRadius="3" FontSize="10" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
