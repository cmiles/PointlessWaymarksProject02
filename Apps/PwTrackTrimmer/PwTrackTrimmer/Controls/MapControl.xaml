<UserControl x:Class="PwTrackTrimmer.Controls.MapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid Background="#0B0F19">
        <!-- Leaflet Map Container -->
        <Border x:Name="MapContainer" Background="#0F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Floating Map Controls Overlay (Layer Switcher, Zoom, Center) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" 
                Background="#CC1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="6">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnFitBounds" Content="Fit Track" Click="BtnFitBounds_Click" 
                        Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Padding="10,4" Margin="2"
                        FontWeight="SemiBold" Cursor="Hand"/>
                <Button x:Name="BtnTogglePoints" Content="Toggle Waypoints" Click="BtnTogglePoints_Click" 
                        Background="#334155" Foreground="#E2E8F0" BorderThickness="0" Padding="10,4" Margin="2"
                        FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Help hint overlay -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14"
                Background="#CC0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,4">
            <TextBlock Text="💡 Click a point to select · Drag waypoint handles to move · Del key or right panel to delete" 
                       FontSize="11" Foreground="#94A3B8"/>
        </Border>
    </Grid>
</UserControl>
