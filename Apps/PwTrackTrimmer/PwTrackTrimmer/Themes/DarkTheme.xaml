<ResourceDictionary x:Class="PwTrackTrimmer.Themes.DarkTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core App Surfaces & Text -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="SubtleCardBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SubtleCardBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="DividerBrush" Color="#334155" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextHeadingBrush" Color="#F8FAFC" />

    <!-- Links & Accents -->
    <SolidColorBrush x:Key="HyperlinkBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="SkyAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="EmeraldAccentBrush" Color="#10B981" />
    <SolidColorBrush x:Key="RedAccentBrush" Color="#EF4444" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundBrush" Color="#FF1E293B" />
    <SolidColorBrush x:Key="ScrollBarButtonForegroundBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FF475569" />

    <!-- Status Banners & Controls -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#475569" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#F8FAFC" />

</ResourceDictionary>
