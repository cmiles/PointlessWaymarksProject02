<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:PointlessWaymarks.FeedReaderAvalonia.Controls"
        xmlns:status="clr-namespace:PointlessWaymarks.AvaloniaCommon.Status;assembly=PointlessWaymarks.AvaloniaCommon"
        xmlns:windowScreenShot="clr-namespace:PointlessWaymarks.AvaloniaCommon.WindowScreenShot;assembly=PointlessWaymarks.AvaloniaCommon"
        xmlns:controls0="clr-namespace:PointlessWaymarks.FeedReaderAvalonia.Controls"
        x:Class="PointlessWaymarks.FeedReaderAvalonia.Controls.FeedListWindow"
        Title="Feeds"
        Width="600"
        Height="700"
        d:DataContext="{d:DesignInstance controls:FeedListWindow}"
        x:DataType="controls0:FeedListWindow"
        mc:Ignorable="d">
    <Grid>
        <controls:FeedListControl DataContext="{Binding FeedContext}" />
        <status:StatusControl
            Grid.Row="0"
            d:IsHidden="true"
            DataContext="{Binding StatusContext}" />
        <windowScreenShot:WindowScreenShotControl
            Width="40"
            Margin="2,2,2,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom" />
    </Grid>
</Window> 