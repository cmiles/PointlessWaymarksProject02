<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PointlessWaymarks.SiteViewerMaui.ViewModels"
             xmlns:models="clr-namespace:PointlessWaymarks.SiteViewerMaui.Models"
             x:Class="PointlessWaymarks.SiteViewerMaui.Views.ConnectionsListPage"
             x:DataType="vm:ConnectionsListViewModel"
             Title="Connections">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <CollectionView ItemsSource="{Binding Profiles}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label Text="No connections yet."
                           FontSize="18"
                           HorizontalOptions="Center" />
                    <Label Text="Use Add to create your first S3 connection."
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudViewerProfile">
                    <Border Margin="12,8" Padding="12" StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=LightGray, Dark=Gray}"
                            StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Spacing="2">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding SiteDomain}" FontSize="13" TextColor="Gray" />
                                <Label Text="{Binding Provider}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Row="1" Grid.Column="0" Text="View" Margin="0,8,8,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConnectionsListViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Row="1" Grid.Column="1" Text="Edit" Margin="0,8,8,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConnectionsListViewModel}}, Path=EditCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Row="1" Grid.Column="2" Text="Delete" Margin="0,8,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConnectionsListViewModel}}, Path=DeleteCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>

</ContentPage>
